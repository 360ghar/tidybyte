# Xcode generated project (regenerate via: xcodegen generate)
*.xcodeproj/
*.xcworkspace/

# Build artifacts
DerivedData/
build/
Build/
*.build/

# Xcode user data
xcuserdata/

# Swift Package Manager
.swiftpm/

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local state
.claude-personal/

# Archives & exports
*.ipa
*.dSYM/
*.dSYM.zip

# Environment
.env
.env.*

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Marketing site (Tailwind dev output — regenerated by `npm run dev`;
# the production build writes dist/assets/css/styles.css at deploy time)
public/assets/css/styles.css

# Fingerprinted copies are build artifacts (hash-assets.mjs regenerates
# them in dist/ on every build)
public/assets/css/styles.*.css
public/assets/js/*.*.js

# Astro build output + parity harness artifacts
dist/
.astro/
.parity-baseline/
.parity-shots/
