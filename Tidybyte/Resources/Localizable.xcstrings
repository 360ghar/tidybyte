    "Skips the introduction and asks for photo access later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips the introduction and asks for photo access later"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिचय छोड़ देता है और फ़ोटो ऐक्सेस बाद में माँगता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচিতি এড়িয়ে যায় এবং ফটো অ্যাক্সেস পরে চায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிமுகத்தைத் தவிர்த்து புகைப்பட அணுகலைப் பின்னர் கேட்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిచయాన్ని దాటవేసి ఫోటో యాక్సెస్ను తర్వాత అడుగుతుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परिचय वगळतो आणि फोटो प्रवेश नंतर मागतो"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિચય છોડી દે છે અને ફોટો ઍક્સેસ પછી માગે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಚಯವನ್ನು ಬಿಟ್ಟುಬಿಡುತ್ತದೆ ಮತ್ತು ಫೋಟೋ ಪ್ರವೇಶವನ್ನು ನಂತರ ಕೇಳುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആമുഖം ഒഴിവാക്കി ഫോട്ടോ ആക്സസ് പിന്നീട് ചോദിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਣ-ਪਛਾਣ ਛੱਡ ਦਿੰਦਾ ਹੈ ਅਤੇ ਫ਼ੋਟੋ ਪਹੁੰਚ ਬਾਅਦ ਵਿੱਚ ਮੰਗਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite la introducción y pide acceso a las fotos más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore l'introduction et demande l'accès aux photos plus tard"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt die Einführung und fragt später nach dem Fotozugriff"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pula a introdução e pede acesso às fotos depois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta l'introduzione e chiede l'accesso alle foto più tardi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紹介をスキップし、写真へのアクセスは後で確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소개를 건너뛰고 사진 접근은 나중에 요청합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过介绍，稍后再请求照片访问权限"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает знакомство и запрашивает доступ к фото позже"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتخطى المقدمة ويطلب الوصول إلى الصور لاحقًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדלג על המבוא ומבקש גישה לתמונות מאוחר יותר"
          }
        }
      }
    },
