    "Double-tap to keep this photo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to keep this photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को रखने के लिए दो बार टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি রাখতে দুইবার ট্যাপ করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை வைத்திருக்க இருமுறை தட்டு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను ఉంచుకోవడానికి రెండుసార్లు నొక్కండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो ठेवण्यासाठी दोनदा टॅप करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો રાખવા બે વાર ટૅપ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಇರಿಸಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ സൂക്ഷിക്കാൻ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਰੱਖਣ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para conservar esta foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour garder cette photo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um dieses Foto zu behalten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para manter esta foto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per tenere questa foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでこの写真を残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 이 사진 남기기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击保留此照片"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь, чтобы сохранить это фото"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين للاحتفاظ بهذه الصورة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש פעמיים כדי לשמור תמונה זו"
          }
        }
      }
    },
    "Double-tap to mark this photo for deletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to mark this photo for deletion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को हटाने के लिए चिह्नित करने हेतु दो बार टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি মুছে ফেলার জন্য চিহ্নিত করতে দুইবার ট্যাপ করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை நீக்குவதற்குக் குறிக்க இருமுறை தட்டு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను తొలగించడానికి గుర్తించడానికి రెండుసార్లు నొక్కండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो हटवण्यासाठी चिन्हांकित करण्यासाठी दोनदा टॅप करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો કાઢી નાખવા ચિહ્નિત કરવા બે વાર ટૅપ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋವನ್ನು ಅಳಿಸಲು ಗುರುತಿಸಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഇല്ലാതാക്കാൻ അടയാളപ്പെടുത്താൻ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਮਿਟਾਉਣ ਲਈ ਨਿਸ਼ਾਨਬੱਧ ਕਰਨ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para marcar esta foto para eliminación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour marquer cette photo pour suppression"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um dieses Foto zum Löschen zu markieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para marcar esta foto para exclusão"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per contrassegnare questa foto per l'eliminazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでこの写真を削除対象にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 이 사진을 삭제 대상으로 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击将此照片标记为删除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь, чтобы пометить это фото для удаления"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين لتحديد هذه الصورة للحذف"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש פעמיים כדי לסמן תמונה זו למחיקה"
          }
        }
      }
    },
