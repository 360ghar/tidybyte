    "Sort photos by content type": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort photos by content type"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो को सामग्री प्रकार से क्रमबद्ध करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তুর ধরন অনুযায়ী ফটো সাজান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளடக்க வகைப்படி புகைப்படங்களை வரிசைப்படுத்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంటెంట్ రకం ప్రకారం ఫోటోలను క్రమబద్ధీకరించు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो सामग्री प्रकारानुसार क्रमवारी लावा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા સામગ્રી પ્રકાર પ્રમાણે ગોઠવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ವಿಷಯ ಪ್ರಕಾರದಂತೆ ವಿಂಗಡಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉള്ളടക്ക തരം അനുസരിച്ച് ഫോട്ടോകൾ ക്രമീകരിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਨੂੰ ਸਮੱਗਰੀ ਦੀ ਕਿਸਮ ਅਨੁਸਾਰ ਲੜੀਬੱਧ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las fotos por tipo de contenido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triez les photos par type de contenu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Fotos nach Inhaltstyp"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene as fotos por tipo de conteúdo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le foto per tipo di contenuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を内容の種類で並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 콘텐츠 유형별로 정렬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
