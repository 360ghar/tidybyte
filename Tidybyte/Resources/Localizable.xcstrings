    "Choose a filter to start reviewing your photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a filter to start reviewing your photos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो की समीक्षा शुरू करने के लिए फ़िल्टर चुनें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো দেখা শুরু করতে একটি ফিল্টার বেছে নিন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களைப் பார்க்கத் தொடங்க ஒரு வடிகட்டியைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను సమీక్షించడం ప్రారంభించడానికి ఒక ఫిల్టర్ను ఎంచుకోండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या फोटोंचे पुनरावलोकन सुरू करण्यासाठी फिल्टर निवडा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટાની સમીક્ષા શરૂ કરવા ફિલ્ટર પસંદ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಫಿಲ್ಟರ್ ಆಯ್ಕೆಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ പരിശോധിക്കാൻ ഒരു ഫിൽട്ടർ തിരഞ്ഞെടുക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਦੀ ਸਮੀਖਿਆ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਇੱਕ ਫਿਲਟਰ ਚੁਣੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un filtro para empezar a revisar tus fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un filtre pour commencer à examiner vos photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Filter, um deine Fotos zu prüfen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um filtro para começar a revisar suas fotos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un filtro per iniziare a esaminare le foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタを選んで写真の確認を始めましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터를 선택해 사진 검토를 시작하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择筛选条件以开始查看照片"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фильтр, чтобы начать просмотр фото"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عامل تصفية لبدء مراجعة صورك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר מסנן כדי להתחיל לסקור את התמונות"
          }
        }
      }
    },
    "Choose albums or change your filters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose albums or change your filters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एल्बम चुनें या फ़िल्टर बदलें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালবাম বেছে নিন বা ফিল্টার বদল করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆல்பங்களைத் தேர்ந்தெடுக்கவும் அல்லது வடிகட்டிகளை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆల్బమ్లను ఎంచుకోండి లేదా మీ ఫిల్టర్లను మార్చండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अल्बम निवडा किंवा फिल्टर बदला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આલ્બમ પસંદ કરો અથવા ફિલ્ટર બદલો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಲ್ಬಮ್ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಫಿಲ್ಟರ್ಗಳನ್ನು ಬದಲಾಯಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആൽബങ്ങൾ തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ ഫിൽട്ടറുകൾ മാറ്റുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਲਬਮਾਂ ਚੁਣੋ ਜਾਂ ਫ਼ਿਲਟਰ ਬਦਲੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige álbumes o cambia tus filtros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des albums ou modifiez vos filtres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Alben aus oder ändere deine Filter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha álbuns ou mude seus filtros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli album o cambia i filtri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを選択するか、フィルタを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 선택하거나 필터를 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择相簿或更改筛选条件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите альбомы или измените фильтры."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ألبومات أو غيّر عوامل التصفية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אלבומים או שנה את המסננים."
          }
        }
      }
    },
