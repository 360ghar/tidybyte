    "Converted %lld of %lld. %lld failed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converted %lld of %lld. %lld failed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld में से %lld कन्वर्ट किए गए. %lld कन्वर्ट नहीं हो सके."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটির মধ্যে %lld রূপান্তর করা হয়েছে. %lld রূপান্তর করা যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-இல் %lld மாற்றப்பட்டன. %lld மாற்ற முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldలో %lld మార్చబడ్డాయి. %lld మార్చలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld पैकी %lld रूपांतरित केले. %lld रूपांतरित करता आले नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld માંથી %lld કન્વર્ટ કર્યા. %lld કન્વર્ટ કરી શકાયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ರಲ್ಲಿ %lld ಪರಿವರ್ತಿಸಲಾಗಿದೆ. %lld ಪರಿವರ್ತಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ൽ %lld കൺവേർട്ട് ചെയ്തു. %lld കൺവേർട്ട് ചെയ്യാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ਵਿੱਚੋਂ %lld ਕਨਵਰਟ ਕੀਤੇ. %lld ਕਨਵਰਟ ਨਹੀਂ ਕੀਤੇ ਜਾ ਸਕੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convirtieron %lld de %lld. No se pudieron convertir %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld convertis. %lld n'ont pas pu être convertis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld konvertiert. %lld konnten nicht konvertiert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
