    "Using label search across scanned photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using label search across scanned photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन की गई फ़ोटो में लेबल खोज का उपयोग हो रहा है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করা ফটোতে লেবেল অনুসন্ধান ব্যবহার করা হচ্ছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்த புகைப்படங்களில் லேபிள் தேடல் பயன்படுத்தப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ చేసిన ఫోటోలలో లేబుల్ శోధన వాడుతోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन केलेल्या फोटोंमध्ये लेबल शोध वापरत आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કેન કરેલા ફોટામાં લેબલ શોધ વાપરી રહ્યું છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಫೋಟೋಗಳಲ್ಲಿ ಲೇಬಲ್ ಹುಡುಕಾಟ ಬಳಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്ത ഫോട്ടോകളിൽ ലേബൽ തിരയൽ ഉപയോഗിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਕੀਤੀਆਂ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਲੇਬਲ ਖੋਜ ਵਰਤੀ ਜਾ ਰਹੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando la búsqueda por etiquetas en las fotos analizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation de la recherche par étiquettes sur les photos analysées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Labelsuche über die gescannten Fotos wird verwendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando a busca por rótulos nas fotos analisadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso della ricerca per etichette nelle foto analizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン済みの写真でラベル検索を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 사진에서 라벨 검색을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在对已扫描的照片使用标签搜索。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется поиск по меткам среди просканированных фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم البحث بالتسميات في الصور المفحوصة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש בחיפוש תוויות בתמונות שנסרקו."
          }
        }
      }
    },
