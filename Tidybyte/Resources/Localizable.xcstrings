    "Nothing Leaves Your Device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing Leaves Your Device"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी आपके डिवाइस से बाहर नहीं जाता"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই আপনার ডিভাইস ছাড়ে না"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் உங்கள் சாதனத்தை விட்டு வெளியேறாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ మీ పరికరాన్ని విడిచిపెట్టదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही तुमचे डिव्हाइस सोडत नाही"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ પણ તમારું ડિવાઇસ છોડતું નથી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೂ ನಿಮ್ಮ ಸಾಧನವನ್ನು ಬಿಡುವುದಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും നിങ്ങളുടെ ഉപകരണം വിട്ടുപോകുന്നില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦਾ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale de tu dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte votre appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verlässt dein Gerät"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sai do seu dispositivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente lascia il tuo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの外には何も出ません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 벗어나는 것은 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何内容都不会离开你的设备"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не покидает ваше устройство"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يغادر جهازك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא יוצא מהמכשיר"
          }
        }
      }
    },
    "Nothing is selected. Tap the circles to pick, or tap Select All.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is selected. Tap the circles to pick, or tap Select All."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी चयनित नहीं है. चुनने के लिए गोलों पर टैप करें, या सभी चुनें पर टैप करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই নির্বাচিত নয়. বেছে নিতে বৃত্তে ট্যাপ করুন, বা সব নির্বাচন করুন-এ ট্যাপ করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் தேர்ந்தெடுக்கப்படவில்லை. தேர்ந்தெடுக்க வட்டங்களைத் தட்டவும், அல்லது அனைத்தையும் தேர்ந்தெடு என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ ఎంచుకోబడలేదు. ఎంచుకోవడానికి వృత్తాలను నొక్కండి, లేదా అన్నీ ఎంచుకోండి నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही निवडलेले नाही. निवडण्यासाठी वर्तुळांना टॅप करा किंवा सर्व निवडा टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ પસંદ કરેલું નથી. પસંદ કરવા વર્તુળો પર ટૅપ કરો, અથવા બધું પસંદ કરો ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೂ ಆಯ್ಕೆಯಾಗಿಲ್ಲ. ಆಯ್ಕೆ ಮಾಡಲು ವೃತ್ತಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ, ಅಥವಾ ಎಲ್ಲವನ್ನೂ ಆಯ್ಕೆಮಾಡಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും തിരഞ്ഞെടുത്തിട്ടില്ല. തിരഞ്ഞെടുക്കാൻ വൃത്തങ്ങളിൽ ടാപ്പ് ചെയ്യുക, അല്ലെങ്കിൽ എല്ലാം തിരഞ്ഞെടുക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਨਹੀਂ ਚੁਣਿਆ. ਚੁਣਨ ਲਈ ਗੋਲਿਆਂ ਨੂੰ ਟੈਪ ਕਰੋ, ਜਾਂ ਸਭ ਚੁਣੋ ਨੂੰ ਟੈਪ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada seleccionado. Toca los círculos para elegir o toca Seleccionar todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est sélectionné. Touchez les cercles pour choisir, ou touchez Tout sélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgewählt. Tippe auf die Kreise, um auszuwählen, oder tippe auf Alle auswählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está selecionado. Toque nos círculos para escolher ou toque em Selecionar tudo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è selezionato nulla. Tocca i cerchi per scegliere o tocca Seleziona tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も選択されていません。丸をタップして選ぶか、「すべて選択」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 항목이 없습니다. 원을 탭해 선택하거나 전체 선택을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何内容。轻点圆圈进行选择，或轻点“全选”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не выбрано. Коснитесь кружков, чтобы выбрать, или нажмите «Выбрать все»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تحديد أي شيء. اضغط الدوائر للاختيار، أو اضغط «تحديد الكل»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נבחר דבר. הקש על העיגולים כדי לבחור, או הקש על \"בחר הכול\"."
          }
        }
      }
    },
