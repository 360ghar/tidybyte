    "Couldn't load the video (it may still be in iCloud). Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the video (it may still be in iCloud). Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो लोड नहीं हो सका (यह अभी भी iCloud में हो सकता है). कृपया फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও লোড করা যায়নি (এটি এখনও iCloud-এ থাকতে পারে). আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோவை ஏற்ற முடியவில்லை (அது இன்னும் iCloud-இல் இருக்கலாம்). மீண்டும் முயற்சி செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీడియోను లోడ్ చేయలేకపోయాం (అది ఇంకా iCloudలో ఉండవచ్చు). మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हिडिओ लोड करता आला नाही (तो अजून iCloud मध्ये असू शकतो). पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિડિયો લોડ કરી શકાયો નથી (તે હજી iCloud માં હોઈ શકે છે). ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೀಡಿಯೊ ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ (ಅದು ಇನ್ನೂ iCloud ನಲ್ಲಿರಬಹುದು). ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീഡിയോ ലോഡ് ചെയ്യാനായില്ല (അത് ഇപ്പോഴും iCloud-ൽ ആകാം). വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੀਡੀਓ ਲੋਡ ਨਹੀਂ ਹੋ ਸਕਿਆ (ਇਹ ਹਾਲੇ ਵੀ iCloud ਵਿੱਚ ਹੋ ਸਕਦਾ ਹੈ). ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el vídeo (puede que siga en iCloud). Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la vidéo (elle est peut-être encore dans iCloud). Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht geladen werden (es ist möglicherweise noch in iCloud). Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o vídeo (ele pode ainda estar no iCloud). Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il video (potrebbe essere ancora in iCloud). Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを読み込めませんでした（まだiCloudにある可能性があります）。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 불러오지 못했습니다(iCloud에 아직 있을 수 있습니다). 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入视频（可能仍保存在 iCloud 中）。请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить видео (возможно, оно еще в iCloud). Повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الفيديو (قد يكون لا يزال في iCloud). حاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לטעון את הסרטון (ייתכן שהוא עדיין ב-iCloud). נסה שוב."
          }
        }
      }
    },
