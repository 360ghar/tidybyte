    "This photo has very high brightness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has very high brightness."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो की चमक बहुत ज़्यादा है."
