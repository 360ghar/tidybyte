    "ProRAW, ProRes, and RAW+JPEG totals are unavailable from the Photos subtype metadata used here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProRAW, ProRes, and RAW+JPEG totals are unavailable from the Photos subtype metadata used here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ उपयोग किए गए फ़ोटो सबटाइप मेटाडेटा से ProRAW, ProRes और RAW+JPEG के कुल उपलब्ध नहीं हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে ব্যবহৃত ফটো সাবটাইপ মেটাডেটা থেকে ProRAW, ProRes ও RAW+JPEG-এর মোট পাওয়া যায় না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கு பயன்படுத்தப்படும் புகைப்பட துணைவகை மெட்டாடேட்டாவில் ProRAW, ProRes மற்றும் RAW+JPEG மொத்தங்கள் கிடைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ వాడిన ఫోటో సబ్టైప్ మెటాడేటా నుండి ProRAW, ProRes మరియు RAW+JPEG మొత్తాలు అందుబాటులో లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येथे वापरलेल्या फोटो सबटाइप मेटाडेटामधून ProRAW, ProRes आणि RAW+JPEG एकूण उपलब्ध नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં વપરાયેલા ફોટો સબટાઇપ મેટાડેટામાંથી ProRAW, ProRes અને RAW+JPEG કુલ ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಬಳಸಿದ ಫೋಟೋ ಉಪಪ್ರಕಾರದ ಮೆಟಾಡೇಟಾದಿಂದ ProRAW, ProRes ಮತ್ತು RAW+JPEG ಒಟ್ಟು ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ ഉപയോഗിച്ച ഫോട്ടോ സബ്ടൈപ്പ് മെറ്റാഡാറ്റയിൽ നിന്ന് ProRAW, ProRes, RAW+JPEG ആകെ ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਵਰਤੇ ਗਏ ਫ਼ੋਟੋਜ਼ ਸਬਟਾਈਪ ਮੈਟਾਡਾਟਾ ਤੋਂ ProRAW, ProRes ਅਤੇ RAW+JPEG ਦੇ ਕੁੱਲ ਉਪਲਬਧ ਨਹੀਂ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales de ProRAW, ProRes y RAW+JPEG no están disponibles en los metadatos de subtipo de Fotos que se usan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux ProRAW, ProRes et RAW+JPEG ne sont pas disponibles dans les métadonnées de sous-type de Photos utilisées ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtwerte für ProRAW, ProRes und RAW+JPEG sind aus den hier verwendeten Subtyp-Metadaten von Fotos nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais de ProRAW, ProRes e RAW+JPEG não estão disponíveis nos metadados de subtipo do Fotos usados aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali di ProRAW, ProRes e RAW+JPEG non sono disponibili dai metadati di sottotipo di Foto usati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで使用している「写真」のサブタイプのメタデータからは、ProRAW、ProRes、RAW+JPEGの合計は取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 사용하는 사진 앱의 하위 유형 메타데이터로는 ProRAW, ProRes, RAW+JPEG 합계를 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处使用的“照片”子类型元数据无法提供 ProRAW、ProRes 和 RAW+JPEG 的统计。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги по ProRAW, ProRes и RAW+JPEG недоступны из используемых здесь метаданных подтипов «Фото»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجماليات ProRAW وProRes وRAW+JPEG غير متاحة من بيانات النوع الفرعي لتطبيق «الصور» المستخدمة هنا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סכומי ProRAW, ProRes ו-RAW+JPEG אינם זמינים ממטא-נתוני תת-הסוג של תמונות המשמשים כאן."
          }
        }
      }
    },
    "Quality analyzed from a low-resolution copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality analyzed from a low-resolution copy"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुणवत्ता का विश्लेषण कम रिज़ॉल्यूशन की कॉपी से किया गया"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম রেজোলিউশনের কপি থেকে গুণমান বিশ্লেষণ করা হয়েছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்த தெளிவுத்திறன் நகலிலிருந்து தரம் பரிசோதிக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్కువ రిజల్యూషన్ కాపీ నుండి నాణ్యత విశ్లేషించబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमी रिझोल्यूशन प्रतीवरून दर्जा तपासला"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓછા રિઝોલ્યુશનની કૉપી પરથી ગુણવત્તા તપાસી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಡಿಮೆ ರೆಸಲ್ಯೂಶನ್ ಪ್ರತಿಯಿಂದ ಗುಣಮಟ್ಟ ಪರಿಶೀಲಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞ റെസല്യൂഷൻ പകർപ്പിൽ നിന്ന് ഗുണനിലവാരം വിശകലനം ചെയ്തു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਆਲਿਟੀ ਘੱਟ ਰੈਜ਼ੋਲਿਊਸ਼ਨ ਕਾਪੀ ਤੋਂ ਵਿਸ਼ਲੇਸ਼ਿਤ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidad analizada a partir de una copia de baja resolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualité analysée à partir d'une copie basse résolution"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualität anhand einer Kopie mit niedriger Auflösung analysiert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade analisada a partir de uma cópia em baixa resolução"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualità analizzata da una copia a bassa risoluzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低解像度のコピーから解析した画質"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저해상도 복사본으로 분석한 화질"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "质量基于低分辨率副本分析"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Качество оценено по копии низкого разрешения"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُلّلت الجودة من نسخة منخفضة الدقة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האיכות נותחה מעותק ברזולוציה נמוכה"
          }
        }
      }
    },
