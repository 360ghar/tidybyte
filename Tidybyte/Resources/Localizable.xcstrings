    "You can free up to %@ on this iPhone. Review %@ in TidyByte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can free up to %@ on this iPhone. Review %@ in TidyByte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर आप %@ तक खाली कर सकते हैं. TidyByte में %@ की समीक्षा करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ আপনি %@ পর্যন্ত খালি করতে পারেন. TidyByte-এ %@ পর্যালোচনা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் %@ வரை காலி செய்யலாம். TidyByte-இல் %@-ஐ மதிப்பாய்வு செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ iPhoneలో మీరు %@ వరకు ఖాళీ చేయగలరు. TidyByteలో %@ను సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या iPhone वर तुम्ही %@ पर्यंत मोकळे करू शकता. TidyByte मध्ये %@ चे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ iPhone પર તમે %@ સુધી ખાલી કરી શકો છો. TidyByte માં %@ ની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ iPhone ನಲ್ಲಿ ನೀವು %@ ವರೆಗೆ ಖಾಲಿ ಮಾಡಬಹುದು. TidyByte ನಲ್ಲಿ %@ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ iPhone-ൽ നിങ്ങൾക്ക് %@ വരെ ഒഴിവാക്കാം. TidyByte-ൽ %@ പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ iPhone ਉੱਤੇ %@ ਤੱਕ ਖਾਲੀ ਕਰ ਸਕਦੇ ਹੋ. TidyByte ਵਿੱਚ %@ ਦੀ ਸਮੀਖਿਆ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes liberar hasta %@ en este iPhone. Revisa %@ en TidyByte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez libérer jusqu'à %@ sur cet iPhone. Examinez %@ dans TidyByte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auf diesem iPhone bis zu %@ freigeben. Prüfe %@ in TidyByte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode liberar até %@ neste iPhone. Revise %@ no TidyByte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi liberare fino a %@ su questo iPhone. Esamina %@ in TidyByte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでは最大%@を空けられます。TidyByteで%@を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 최대 %@을(를) 확보할 수 있습니다. TidyByte에서 %@을(를) 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在此 iPhone 上释放最多 %@。在 TidyByte 中查看 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone можно освободить до %@. Просмотрите %@ в TidyByte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحرير ما يصل إلى %@ على هذا iPhone. راجع %@ في TidyByte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפנות עד %@ ב-iPhone זה. סקור %@ ב-TidyByte."
          }
        }
      }
    },
    "You can keep or skip it. Delete is off until it shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep or skip it. Delete is off until it shows."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे रख सकते हैं या छोड़ सकते हैं. दिखने तक हटाएँ बंद है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এটি রাখতে বা এড়িয়ে যেতে পারেন. দেখানোর আগে মুছুন বন্ধ থাকে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருக்கலாம் அல்லது தவிர்க்கலாம். காட்டும் வரை நீக்கு முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని ఉంచవచ్చు లేదా దాటవేయవచ్చు. చూపించే వరకు తొలగించు ఆఫ్లో ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तो ठेवू किंवा वगळू शकता. दिसेपर्यंत हटवा बंद असतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે તેને રાખી શકો અથવા છોડી શકો. દેખાય ત્યાં સુધી કાઢી નાખો બંધ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಅದನ್ನು ಇರಿಸಬಹುದು ಅಥವಾ ಬಿಡಬಹುದು. ಅದು ಕಾಣಿಸುವವರೆಗೆ ಅಳಿಸಿ ಆಫ್ ಆಗಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് അത് നിലനിർത്താം അല്ലെങ്കിൽ ഒഴിവാക്കാം. അത് കാണുന്നതുവരെ ഇല്ലാതാക്കുക ഓഫാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸਨੂੰ ਰੱਖ ਸਕਦੇ ਹੋ ਜਾਂ ਛੱਡ ਸਕਦੇ ਹੋ. ਜਦੋਂ ਤੱਕ ਇਹ ਨਹੀਂ ਦਿਖਦੀ, ਮਿਟਾਉਣਾ ਬੰਦ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conservarla u omitirla. Eliminar está desactivado hasta que aparezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez la garder ou l'ignorer. Supprimer est désactivé tant qu'elle ne s'affiche pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es behalten oder überspringen. Löschen ist deaktiviert, bis es angezeigt wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode manter ou pular. O botão Apagar fica desativado até ele aparecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi tenerla o saltarla. Elimina è disattivato finché non compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残してもスキップしてもかまいません。表示されるまで「削除」はオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남기거나 건너뛸 수 있습니다. 항목이 표시되기 전까지 삭제는 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以保留或跳过。在显示之前无法删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно оставить или пропустить. Удаление недоступно, пока элемент не появится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاحتفاظ به أو تخطيه. الحذف معطّل حتى يظهر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשמור או לדלג. המחיקה כבויה עד שזה יופיע."
          }
        }
      }
    },
