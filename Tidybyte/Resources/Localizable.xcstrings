    "I'm cleaning up my photo library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm cleaning up my photo library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी फ़ोटो लाइब्रेरी की सफ़ाई जारी है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি আমার ফটো লাইব্রেরি পরিষ্কার করছি"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் என் புகைப்பட நூலகத்தைச் சுத்தம் செய்கிறேன்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను నా ఫోటో లైబ్రరీని శుభ్రం చేస్తున్నాను"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी माझी फोटो लायब्ररी स्वच्छ करत आहे"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારી ફોટો લાઇબ્રેરી સાફ થઈ રહી છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ನನ್ನ ಫೋಟೋ ಲೈಬ್ರರಿಯನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸುತ್ತಿದ್ದೇನೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ എന്റെ ഫോട്ടോ ലൈബ്രറി ക്ലീൻ ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੇਰੀ ਫ਼ੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਸਾਫ਼ ਹੋ ਰਹੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy limpiando mi fototeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nettoie ma photothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich räume meine Fotomediathek auf"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou limpando minha biblioteca de fotos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto pulendo la mia libreria foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを整理しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함을 정리하고 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我正在清理我的照片图库"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я привожу в порядок свою медиатеку"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنظّف مكتبة صوري"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מנקה את ספריית התמונות שלי"
          }
        }
      }
    },
    "In Settings, turn TidyByte's Photos access off, then on again, and choose Full Access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, turn TidyByte's Photos access off, then on again, and choose Full Access."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में TidyByte की फ़ोटो तक ऐक्सेस बंद करके फिर चालू करें, और “पूर्ण ऐक्सेस” चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে TidyByte-এর ছবির অ্যাক্সেস বন্ধ করে আবার চালু করুন, এবং “সম্পূর্ণ অ্যাক্সেস” বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் TidyByte-இன் புகைப்பட அணுகலை அணைத்து மீண்டும் இயக்கி, “முழு அணுகல்” தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్లలో TidyByte ఫోటో యాక్సెస్ను ఆఫ్ చేసి మళ్లీ ఆన్ చేయండి, ఆపై “పూర్తి యాక్సెస్” ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये TidyByte चा फोटो ॲक्सेस बंद करून पुन्हा चालू करा, आणि “पूर्ण ॲक्सेस” निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સમાં TidyByte નો ફોટો ઍક્સેસ બંધ કરીને ફરી ચાલુ કરો, અને “સંપૂર્ણ ઍક્સેસ” પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್ಗಳಲ್ಲಿ TidyByte ನ ಫೋಟೋ ಆ್ಯಕ್ಸೆಸ್ ಆಫ್ ಮಾಡಿ ಮತ್ತೆ ಆನ್ ಮಾಡಿ, ನಂತರ “ಸಂಪೂರ್ಣ ಆ್ಯಕ್ಸೆಸ್” ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെറ്റിംഗ്സിൽ TidyByte-ന്റെ ഫോട്ടോ ആക്സസ് ഓഫാക്കി വീണ്ടും ഓൺ ചെയ്യുക, എന്നിട്ട് “പൂർണ ആക്സസ്” തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ ਵਿੱਚ TidyByte ਦਾ ਫ਼ੋਟੋ ਐਕਸੈੱਸ ਬੰਦ ਕਰਕੇ ਦੁਬਾਰਾ ਚਾਲੂ ਕਰੋ, ਅਤੇ “ਪੂਰਾ ਐਕਸੈੱਸ” ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, desactiva y vuelve a activar el acceso de TidyByte a Fotos, y elige «Acceso completo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, désactivez puis réactivez l’accès de TidyByte à Photos, et choisissez « Accès complet »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte in den Einstellungen den Fotozugriff für TidyByte aus und wieder ein und wähle „Voller Zugriff“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes, desative e ative de novo o acesso do TidyByte a Fotos e escolha “Acesso Total”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni, disattiva e riattiva l’accesso di TidyByte a Foto, poi scegli «Accesso completo»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でTidyByteの写真へのアクセスを一度オフにしてからオンにし直し、「フルアクセス」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 TidyByte의 사진 접근을 껐다가 다시 켜고 ‘전체 접근’을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中关闭再重新打开 TidyByte 的照片访问权限，然后选择“完整访问权限”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройках» выключите и снова включите доступ TidyByte к «Фото», затем выберите «Полный доступ»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في «الإعدادات»، أوقف وصول TidyByte إلى «الصور» ثم شغّله مرة أخرى، واختر «وصول كامل»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהגדרות, כבה והדלק מחדש את הגישה של TidyByte לתמונות, ובחר ״גישה מלאה״."
          }
        }
      }
    },
