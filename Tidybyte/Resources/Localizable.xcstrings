    "Original kept — both versions in your library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original kept — both versions in your library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल रखा गया — आपकी लाइब्रेरी में दोनों वर्शन हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল রাখা হয়েছে — দুইটি ভার্সনই আপনার লাইব্রেরিতে আছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூலம் வைக்கப்பட்டது — இரண்டு பதிப்புகளும் உங்கள் நூலகத்தில் உள்ளன"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అసలైనది ఉంచబడింది — రెండు వెర్షన్లు మీ లైబ్రరీలో ఉన్నాయి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मूळ ठेवले — दोन्ही आवृत्त्या तुमच्या लायब्ररीत आहेत"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂળ રાખ્યું — બંને આવૃત્તિ તમારી લાઇબ્રેરીમાં છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂಲ ಇರಿಸಲಾಗಿದೆ — ಎರಡೂ ಆವೃತ್ತಿಗಳು ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿವೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒറിജിനൽ നിലനിർത്തി — രണ്ട് പതിപ്പുകളും നിങ്ങളുടെ ലൈബ്രറിയിലുണ്ട്"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸਲੀ ਰੱਖੀ — ਦੋਵੇਂ ਰੂਪ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਹਨ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conservado — ambas versiones están en tu fototeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conservé — les deux versions sont dans votre photothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original behalten — beide Versionen sind in deiner Mediathek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Original mantido — as duas versões estão na sua biblioteca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale conservato — entrambe le versioni sono nella tua libreria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のまま残しました — 両方のバージョンがライブラリにあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 유지됨 — 두 버전 모두 보관함에 있음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件已保留 — 两个版本都在你的图库中"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал сохранен — обе версии в вашей медиатеке"
          }
        },
        "ar": {
