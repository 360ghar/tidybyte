        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-இல் %lld சுருக்கப்பட்டன. %lld சுருக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldలో %lld కుదించబడ్డాయి. %lld కుదించలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld पैकी %lld कंप्रेस केले. %lld कंप्रेस करता आले नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld માંથી %lld કોમ્પ્રેસ કર્યા. %lld કોમ્પ્રેસ કરી શકાયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ರಲ್ಲಿ %lld ಸಂಕುಚಿಸಲಾಗಿದೆ. %lld ಸಂಕುಚಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ൽ %lld കംപ്രസ് ചെയ്തു. %lld കംപ്രസ് ചെയ്യാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ਵਿੱਚੋਂ %lld ਕੰਪ੍ਰੈਸ ਕੀਤੇ. %lld ਕੰਪ੍ਰੈਸ ਨਹੀਂ ਕੀਤੇ ਜਾ ਸਕੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprimieron %lld de %lld. No se pudieron comprimir %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld compressés. %lld n'ont pas pu être compressés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld komprimiert. %lld konnten nicht komprimiert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimidos %lld de %lld. Não foi possível comprimir %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressi %lld su %lld. Impossibile comprimere %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個中%lld個を圧縮しました。%lld個は圧縮できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 중 %lld개를 압축했습니다. %lld개는 압축하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已压缩 %lld 个（共 %lld 个）。%lld 个压缩失败。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжато %lld из %lld. Не удалось сжать %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم ضغط %lld من أصل %lld. تعذر ضغط %lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כווצו %lld מתוך %lld. %lld לא ניתן היה לכווץ."
          }
        }
      }
    },
    "Compressed photos and videos will appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed photos and videos will appear here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई फ़ोटो और वीडियो यहाँ दिखेंगे."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করা ফটো ও ভিডিও এখানে দেখা যাবে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கிய புகைப்படங்களும் வீடியோக்களும் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించిన ఫోటోలు మరియు వీడియోలు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस केलेले फोटो आणि व्हिडिओ इथे दिसतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલા ફોટા અને વિડિયો અહીં દેખાશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿಸಿದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಇಲ್ಲಿ ಕಾಣುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത ഫോട്ടോകളും വീഡിയോകളും ഇവിടെ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪਰੈਸ ਕੀਤੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਇੱਥੇ ਦਿਖਣਗੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los vídeos comprimidos aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos compressées apparaîtront ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimierte Fotos und Videos erscheinen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e vídeos comprimidos aparecerão aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto e i video compressi compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮した写真とビデオがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축한 사진과 동영상이 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩后的照片和视频会显示在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжатые фото и видео появятся здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الصور والفيديوهات المضغوطة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות וסרטונים מכווצים יופיעו כאן."
          }
        }
      }
    },
