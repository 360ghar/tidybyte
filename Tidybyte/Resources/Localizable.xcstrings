        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ ఎంచుకోబడలేదు. ఎంచుకోవడానికి వృత్తాలను నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही निवडलेले नाही. निवडण्यासाठी वर्तुळांना टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ પસંદ કરેલું નથી. પસંદ કરવા વર્તુળો પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೂ ಆಯ್ಕೆಯಾಗಿಲ್ಲ. ಆಯ್ಕೆ ಮಾಡಲು ವೃತ್ತಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും തിരഞ്ഞെടുത്തിട്ടില്ല. തിരഞ്ഞെടുക്കാൻ വൃത്തങ്ങളിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਨਹੀਂ ਚੁਣਿਆ. ਚੁਣਨ ਲਈ ਗੋਲਿਆਂ ਨੂੰ ਟੈਪ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada seleccionado. Toca los círculos para elegir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est sélectionné. Touchez les cercles pour choisir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgewählt. Tippe auf die Kreise, um auszuwählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está selecionado. Toque nos círculos para escolher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è selezionato nulla. Tocca i cerchi per scegliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も選択されていません。丸をタップして選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 항목이 없습니다. 원을 탭해 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何内容。轻点圆圈进行选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не выбрано. Коснитесь кружков, чтобы выбрать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تحديد أي شيء. اضغط الدوائر للاختيار."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נבחר דבר. הקש על העיגולים כדי לבחור."
          }
        }
      }
    },
    "Nothing measurable yet. Items stored only in iCloud don't report a size.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing measurable yet. Items stored only in iCloud don't report a size."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ मापने लायक नहीं है. केवल iCloud में रखे आइटम आकार नहीं बताते."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও পরিমাপ করার মতো কিছু নেই. শুধু iCloud-এ রাখা আইটেম আকার জানায় না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் அளவிடக்கூடியது எதுவும் இல்லை. iCloud-இல் மட்டும் சேமிக்கப்பட்ட உருப்படிகள் அளவைத் தெரிவிக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా కొలవగలిగినది ఏదీ లేదు. iCloudలో మాత్రమే నిల్వ ఉన్న అంశాలు పరిమాణాన్ని నివేదించవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून मोजण्यासारखे काही नाही. फक्त iCloud मध्ये साठवलेले आयटम आकार सांगत नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી માપી શકાય એવું કંઈ નથી. ફક્ત iCloud માં સંગ્રહાયેલા આઇટમ સાઇઝ જણાવતા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಅಳೆಯಬಹುದಾದದ್ದು ಏನೂ ಇಲ್ಲ. iCloud ನಲ್ಲಿ ಮಾತ್ರ ಸಂಗ್ರಹವಾಗಿರುವ ಐಟಂಗಳು ಗಾತ್ರವನ್ನು ತಿಳಿಸುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ അളക്കാവുന്നത് ഒന്നുമില്ല. iCloud-ൽ മാത്രം സൂക്ഷിച്ച ഇനങ്ങൾ വലിപ്പം റിപ്പോർട്ട് ചെയ്യുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਮਾਪਣ ਯੋਗ ਕੁਝ ਨਹੀਂ. ਸਿਰਫ਼ iCloud ਵਿੱਚ ਸੰਭਾਲੀਆਂ ਆਈਟਮਾਂ ਆਕਾਰ ਨਹੀਂ ਦੱਸਦੀਆਂ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada medible. Los elementos guardados solo en iCloud no indican su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de mesurable pour l'instant. Les éléments stockés uniquement dans iCloud n'indiquent pas de taille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts messbar. Objekte, die nur in iCloud liegen, melden keine Größe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mensurável ainda. Itens armazenados apenas no iCloud não informam um tamanho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente di misurabile. Gli elementi solo in iCloud non indicano una dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ測定できるデータがありません。iCloudにのみ保存されている項目はサイズを報告しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 측정된 내용이 없습니다. iCloud에만 저장된 항목은 크기를 보고하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有可统计的数据。仅存储在 iCloud 中的项目不会报告大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего измерить. Объекты, хранящиеся только в iCloud, не сообщают размер."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء قابل للقياس بعد. العناصر المخزنة في iCloud فقط لا تُبلغ عن حجمها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מה למדוד. פריטים המאוחסנים רק ב-iCloud לא מדווחים גודל."
          }
        }
      }
    },
