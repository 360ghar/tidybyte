    "Search supports visible content only, such as dogs on a beach. Dates, places, names, and text are not indexed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search supports visible content only, such as dogs on a beach. Dates, places, names, and text are not indexed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज केवल दिखने वाली सामग्री का समर्थन करती है, जैसे समुद्र तट पर कुत्ते. तारीख़ें, जगहें, नाम और टेक्स्ट इंडेक्स नहीं होते."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুসন্ধান শুধু দৃশ্যমান বিষয়বস্তু সমর্থন করে, যেমন সৈকতে কুকুর. তারিখ, জায়গা, নাম ও লেখা ইনডেক্স করা হয় না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் கண்ணுக்குத் தெரியும் உள்ளடக்கத்திற்கு மட்டுமே, உதாரணமாக கடற்கரையில் நாய்கள். தேதிகள், இடங்கள், பெயர்கள், எழுத்து ஆகியவை குறியிடப்படுவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శోధన కనిపించే కంటెంట్కు మాత్రమే మద్దతు ఇస్తుంది, ఉదాహరణకు బీచ్లో కుక్కలు. తేదీలు, ప్రదేశాలు, పేర్లు, వచనం ఇండెక్స్ చేయబడవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध फक्त दिसणाऱ्या सामग्रीसाठी आहे, उदा. समुद्रकिनाऱ्यावरचे कुत्रे. तारखा, ठिकाणे, नावे आणि मजकूर अनुक्रमित केले जात नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શોધ ફક્ત દેખાતી સામગ્રી માટે છે, જેમ કે દરિયાકિનારે કૂતરા. તારીખો, સ્થળો, નામો અને લખાણ અનુક્રમિત થતાં નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹುಡುಕಾಟವು ಕಾಣುವ ವಿಷಯಕ್ಕೆ ಮಾತ್ರ ಬೆಂಬಲ ನೀಡುತ್ತದೆ, ಉದಾಹರಣೆಗೆ ಕಡಲತೀರದಲ್ಲಿ ನಾಯಿಗಳು. ದಿನಾಂಕಗಳು, ಸ್ಥಳಗಳು, ಹೆಸರುಗಳು ಮತ್ತು ಪಠ್ಯ ಸೂಚ್ಯಂಕಗೊಳ್ಳುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണുന്ന ഉള്ളടക്കത്തിന് മാത്രമേ തിരയൽ പിന്തുണയ്ക്കൂ, ഉദാഹരണത്തിന് കടൽത്തീരത്ത് നായ്ക്കൾ. തീയതികൾ, സ്ഥലങ്ങൾ, പേരുകൾ, പാഠം എന്നിവ സൂചികയിലാക്കുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੋਜ ਸਿਰਫ਼ ਦਿਖਣ ਵਾਲੀ ਸਮੱਗਰੀ ਲਈ ਹੈ, ਜਿਵੇਂ ਸਮੁੰਦਰ ਕੰਢੇ ਕੁੱਤੇ. ਤਾਰੀਖਾਂ, ਥਾਵਾਂ, ਨਾਮ ਅਤੇ ਲਿਖਤ ਸੂਚੀਬੱਧ ਨਹੀਂ ਹੁੰਦੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda solo admite contenido visible, como perros en una playa. Las fechas, los lugares, los nombres y el texto no se indexan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche ne prend en charge que le contenu visible, comme des chiens sur une plage. Les dates, les lieux, les noms et le texte ne sont pas indexés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche unterstützt nur sichtbare Inhalte, etwa Hunde am Strand. Datumsangaben, Orte, Namen und Text werden nicht erfasst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca abrange apenas conteúdo visível, como cachorros em uma praia. Datas, lugares, nomes e texto não são indexados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca supporta solo contenuti visibili, come cani su una spiaggia. Date, luoghi, nomi e testo non sono indicizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索できるのは、ビーチにいる犬のように、写真に写っている内容だけです。日付、場所、名前、文字は索引に含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 해변의 강아지처럼 사진에 보이는 내용만 지원합니다. 날짜, 장소, 이름, 텍스트는 색인되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索仅支持可见内容，例如海滩上的狗。日期、地点、姓名和文字不会被索引。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск поддерживает только видимое содержимое, например собаки на пляже. Даты, места, имена и текст не индексируются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم البحث المحتوى المرئي فقط، مثل كلاب على شاطئ. التواريخ والأماكن والأسماء والنصوص غير مفهرسة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיפוש תומך בתוכן גלוי בלבד, כמו כלבים על חוף. תאריכים, מקומות, שמות וטקסט אינם נכללים באינדקס."
          }
        }
      }
    },
    "Searching labels across all scanned categories.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching labels across all scanned categories."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी स्कैन की गई श्रेणियों में लेबल खोजे जा रहे हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব স্ক্যান করা শ্রেণিতে লেবেল খোঁজা হচ্ছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்யப்பட்ட அனைத்து வகைகளிலும் லேபிள்கள் தேடப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ చేసిన అన్ని వర్గాల్లో లేబుళ్లను వెతుకుతోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व स्कॅन केलेल्या श्रेणींमध्ये लेबल शोधत आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી સ્કેન કરેલી શ્રેણીઓમાં લેબલ શોધી રહ્યું છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಎಲ್ಲಾ ವರ್ಗಗಳಲ್ಲಿ ಲೇಬಲ್ಗಳನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്ത എല്ലാ വിഭാഗങ്ങളിലും ലേബലുകൾ തിരയുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਸਕੈਨ ਕੀਤੀਆਂ ਸ਼੍ਰੇਣੀਆਂ ਵਿੱਚ ਲੇਬਲ ਖੋਜ ਚੱਲ ਰਹੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando etiquetas en todas las categorías analizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche d'étiquettes dans toutes les catégories analysées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels werden in allen gescannten Kategorien durchsucht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando rótulos em todas as categorias analisadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca di etichette in tutte le categorie analizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン済みのすべてのカテゴリでラベルを検索しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 모든 카테고리에서 라벨을 검색하는 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
