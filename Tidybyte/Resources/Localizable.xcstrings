    "No videos larger than %lld MB. Lower the threshold or switch to All/Photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No videos larger than %lld MB. Lower the threshold or switch to All/Photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB से बड़ा कोई वीडियो नहीं. सीमा घटाएँ या सभी/फ़ोटो पर स्विच करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-এর চেয়ে বড় কোনও ভিডিও নেই. সীমা কম করুন বা সব/ফটো-তে যান."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-ஐ விட பெரிய வீடியோக்கள் இல்லை. வரம்பைக் குறைக்கவும் அல்லது அனைத்தும்/புகைப்படங்களுக்கு மாறவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB కంటే పెద్ద వీడియోలు లేవు. పరిమితిని తగ్గించండి లేదా అన్నీ/ఫోటోలు ట్యాబ్కు మారండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB पेक्षा मोठे व्हिडिओ नाहीत. मर्यादा कमी करा किंवा सर्व/फोटो वर जा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB થી મોટા વિડિયો નથી. મર્યાદા ઘટાડો અથવા બધું/ફોટા પર જાઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB ಗಿಂತ ದೊಡ್ಡ ವೀಡಿಯೊಗಳಿಲ್ಲ. ಮಿತಿ ಕಡಿಮೆ ಮಾಡಿ ಅಥವಾ ಎಲ್ಲಾ/ಫೋಟೋಗಳು ಟ್ಯಾಬ್ಗೆ ಬದಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-യിൽ കൂടുതലുള്ള വീഡിയോകൾ ഇല്ല. പരിധി കുറയ്ക്കുക അല്ലെങ്കിൽ എല്ലാം/ഫോട്ടോകൾ എന്നതിലേക്ക് മാറുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB ਤੋਂ ਵੱਡੇ ਵੀਡੀਓ ਨਹੀਂ. ਹੱਦ ਘਟਾਓ ਜਾਂ ਸਭ/ਫ਼ੋਟੋ ਟੈਬ ਉੱਤੇ ਜਾਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay vídeos de más de %lld MB. Baja el umbral o cambia a Todo/Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vidéo de plus de %lld MB. Abaissez le seuil ou passez à Tout/Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Videos über %lld MB. Verringere den Schwellenwert oder wechsle zu Alle/Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum vídeo acima de %lld MB. Reduza o limite ou mude para Tudo/Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun video oltre %lld MB. Riduci la soglia o passa a Tutti/Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが%lld MBを超えるビデオはありません。しきい値を下げるか、「すべて」/「写真」に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB보다 큰 동영상이 없습니다. 기준을 낮추거나 \"모두\"/\"사진\"으로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有大于 %lld MB 的视频。降低阈值或切换到“全部”/“照片”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет видео больше %lld MB. Снизьте порог или переключитесь на «Все»/«Фото»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد فيديوهات أكبر من %lld MB. خفّض الحد أو بدّل إلى «الكل»/«الصور»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין סרטונים גדולים מ-%lld MB. הורד את הסף או עבור אל \"הכול\"/\"תמונות\"."
          }
        }
      }
    },
