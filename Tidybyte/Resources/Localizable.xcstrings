    "That photo can't be undone anymore.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo can't be undone anymore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस फ़ोटो को अब पूर्ववत नहीं किया जा सकता."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই ফটোটি আর ফিরিয়ে আনা যাবে না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் புகைப்படத்தை இனி மீளச் செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫోటోను ఇక వెనక్కి తీసుకోలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तो फोटो आता पूर्ववत करता येणार नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ ફોટો હવે પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಫೋಟೋವನ್ನು ಇನ್ನು ಹಿಂತಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫോട്ടോ ഇനി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਫ਼ੋਟੋ ਹੁਣ ਵਾਪਸ ਨਹੀਂ ਲਿਆਂਦੀ ਜਾ ਸਕਦੀ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no puedes deshacer esa foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez plus annuler cette photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto kann nicht mehr rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode mais desfazer essa foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi più annullare quella foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その写真はもう取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 사진은 더 이상 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该照片已无法撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото больше нельзя вернуть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد ممكنًا التراجع عن هذه الصورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן יותר לבטל את התמונה הזו."
          }
        }
      }
    },
    "The best photo from each group will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best photo from each group will be kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर समूह की सबसे अच्छी फ़ोटो रखी जाएगी."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি গ্রুপের সেরা ফটো রাখা হবে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு குழுவின் சிறந்த புகைப்படம் வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి సమూహం నుండి ఉత్తమ ఫోటో ఉంచబడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक गटातील सर्वोत्तम फोटो ठेवला जाईल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક જૂથમાંથી શ્રેષ્ઠ ફોટો રાખવામાં આવશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಗುಂಪಿನಿಂದ ಅತ್ಯುತ್ತಮ ಫೋಟೋವನ್ನು ಇರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഗ്രൂപ്പിൽ നിന്നും മികച്ച ഫോട്ടോ നിലനിർത്തും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਗਰੁੱਪ ਦੀ ਸਭ ਤੋਂ ਵਧੀਆ ਫ਼ੋਟੋ ਰੱਖੀ ਜਾਵੇਗੀ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará la mejor foto de cada grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La meilleure photo de chaque groupe sera conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beste Foto jeder Gruppe wird behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A melhor foto de cada grupo será mantida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto migliore di ogni gruppo verrà conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで最も良い写真が残されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 그룹에서 가장 좋은 사진이 남겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组中最好的照片将被保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее фото из каждой группы будет сохранено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم الاحتفاظ بأفضل صورة من كل مجموعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה הטובה בכל קבוצה תישמר."
          }
        }
      }
    },
    "The compressed copy is missing from your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressed copy is missing from your library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई कॉपी आपकी लाइब्रेरी में नहीं है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করা কপি আপনার লাইব্রেরিতে নেই."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கப்பட்ட நகல் உங்கள் நூலகத்தில் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించిన కాపీ మీ లైబ్రరీలో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस केलेली प्रत तुमच्या लायब्ररीत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલી કૉપી તમારી લાઇબ્રેરીમાં નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿಸಿದ ಪ್ರತಿ ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത പകർപ്പ് നിങ്ങളുടെ ലൈബ്രറിയിൽ ഇല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ ਕੀਤੀ ਕਾਪੀ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਨਹੀਂ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia comprimida no está en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie compressée est absente de votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die komprimierte Kopie fehlt in deiner Mediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia comprimida não está na sua biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia compressa non è nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮したコピーがライブラリに見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축된 복사본이 사진 보관함에 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的图库中找不到压缩后的副本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжатой копии нет в вашей медиатеке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة المضغوطة مفقودة من مكتبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק המכווץ חסר מהספרייה שלך."
          }
        }
      }
    },
    "The converted still is missing from your library.": {
      "localizations": {
