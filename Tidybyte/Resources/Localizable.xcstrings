    "This keeps the starred frame of each burst and deletes the rest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This keeps the starred frame of each burst and deletes the rest."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हर बर्स्ट का स्टार किया गया फ़्रेम रखता है और बाकी हटा देता है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি প্রতিটি বার্স্টের স্টার দেওয়া ফ্রেম রাখে এবং বাকিগুলি মুছে দেয়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒவ்வொரு பர்ஸ்டின் நட்சத்திரமிட்ட சட்டகத்தை வைத்துக்கொண்டு மற்றவற்றை நீக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ప్రతి బరస్ట్లో నక్షత్రం గుర్తు పెట్టిన ఫ్రేమ్ను ఉంచి మిగిలినవి తొలగిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे प्रत्येक बर्स्टमधील तारांकित फ्रेम ठेवते आणि बाकीच्या हटवते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ દરેક બર્સ્ટની તારાંકિત ફ્રેમ રાખે છે અને બાકીની કાઢી નાખે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಪ್ರತಿ ಬರ್ಸ್ಟ್ನ ನಕ್ಷತ್ರ ಗುರುತಿನ ಫ್ರೇಮ್ ಅನ್ನು ಇರಿಸಿ ಉಳಿದವನ್ನು ಅಳಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഓരോ ബർസ്റ്റിന്റെയും നക്ഷത്രമിട്ട ഫ്രെയിം നിലനിർത്തി ബാക്കിയുള്ളവ ഇല്ലാതാക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਹਰ ਬਰਸਟ ਦੀ ਤਾਰਾ ਲੱਗੀ ਫਰੇਮ ਰੱਖਦਾ ਹੈ ਅਤੇ ਬਾਕੀ ਮਿਟਾ ਦਿੰਦਾ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto conserva el fotograma con estrella de cada ráfaga y elimina el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela conserve l'image avec étoile de chaque rafale et supprime le reste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies behält das mit einem Stern markierte Bild jeder Serie und löscht den Rest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso mantém o quadro com estrela de cada rajada e apaga o resto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa opzione mantiene il fotogramma con la stella di ogni raffica ed elimina il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各バーストでスターを付けたコマを残し、それ以外を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 버스트에서 별표한 프레임을 남기고 나머지를 삭제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会保留每组连拍中标星的那一帧，删除其余的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так сохраняется помеченный кадр каждой серии, а остальные удаляются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ هذا بالإطار المميز بنجمة في كل مجموعة من الصور المتتابعة ويحذف الباقي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו שומרת את הפריים המסומן בכוכב בכל רצף ומוחקת את השאר."
          }
        }
      }
    },
