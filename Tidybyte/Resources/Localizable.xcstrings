    "Removed changed or unavailable photos. Scan again to include new or edited photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed changed or unavailable photos. Scan again to include new or edited photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदली हुई या अनुपलब्ध फ़ोटो हटा दी गईं. नई या एडिट की गई फ़ोटो शामिल करने के लिए फिर से स्कैन करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলে যাওয়া বা অনুপলব্ধ ফটো সরানো হয়েছে. নতুন বা এডিট করা ফটো যোগ করতে আবার স্ক্যান করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாறிய அல்லது கிடைக்காத புகைப்படங்கள் அகற்றப்பட்டன. புதிய அல்லது திருத்தப்பட்ட புகைப்படங்களைச் சேர்க்க மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మారిన లేదా అందుబాటులో లేని ఫోటోలు తీసివేయబడ్డాయి. కొత్త లేదా సవరించిన ఫోటోలను చేర్చడానికి మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदललेले किंवा उपलब्ध नसलेले फोटो वगळले. नवीन किंवा संपादित फोटो समाविष्ट करण्यासाठी पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બદલાયેલા કે ઉપલબ્ધ ન હોય તેવા ફોટા દૂર કર્યા. નવા કે એડિટ કરેલા ફોટા સામેલ કરવા ફરી સ્કેન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಾದ ಅಥವಾ ಲಭ್ಯವಿಲ್ಲದ ಫೋಟೋಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಹೊಸ ಅಥವಾ ಸಂಪಾದಿಸಿದ ಫೋಟೋಗಳನ್ನು ಸೇರಿಸಲು ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറിയതോ ലഭ്യമല്ലാത്തതോ ആയ ഫോട്ടോകൾ നീക്കി. പുതിയതോ എഡിറ്റ് ചെയ്തതോ ആയ ഫോട്ടോകൾ ഉൾപ്പെടുത്താൻ വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲੀਆਂ ਜਾਂ ਉਪਲਬਧ ਨਾ ਹੋਣ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ ਹਟਾਈਆਂ. ਨਵੀਆਂ ਜਾਂ ਸੰਪਾਦਿਤ ਫ਼ੋਟੋਆਂ ਸ਼ਾਮਲ ਕਰਨ ਲਈ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitaron las fotos modificadas o no disponibles. Vuelve a analizar para incluir fotos nuevas o editadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos modifiées ou indisponibles ont été retirées. Relancez l'analyse pour inclure les photos nouvelles ou modifiées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geänderte oder nicht verfügbare Fotos entfernt. Scanne erneut, um neue oder bearbeitete Fotos einzubeziehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos alteradas ou indisponíveis foram removidas. Analise de novo para incluir fotos novas ou editadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto modificate o non disponibili sono state rimosse. Ripeti l'analisi per includere foto nuove o modificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更または利用できない写真を除外しました。再スキャンすると、新規または編集済みの写真も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경되었거나 사용할 수 없는 사진을 제외했습니다. 다시 스캔하면 새로 추가되거나 편집된 사진도 포함됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除更改过或无法使用的照片。重新扫描可包含新增或编辑过的照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измененные или недоступные фото убраны. Повторите сканирование, чтобы включить новые и отредактированные фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة الصور المتغيرة أو غير المتاحة. أعد الفحص لتضمين الصور الجديدة أو المعدّلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות ששונו או שאינן זמינות הוסרו. סרוק שוב כדי לכלול תמונות חדשות או ערוכות."
          }
        }
      }
    },
    "Removes this photo from the delete list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this photo from the delete list"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को हटाने की सूची से हटाता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি মুছে ফেলার তালিকা থেকে সরায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை நீக்கும் பட்டியலிலிருந்து அகற்றுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను తొలగింపు జాబితా నుండి తీసివేస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो हटवण्याच्या यादीतून काढतो"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો કાઢી નાખવાની યાદીમાંથી દૂર કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋವನ್ನು ಅಳಿಸುವ ಪಟ್ಟಿಯಿಂದ ತೆಗೆದುಹಾಕುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഇല്ലാതാക്കാനുള്ള ലിസ്റ്റിൽ നിന്ന് നീക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਮਿਟਾਉਣ ਦੀ ਸੂਚੀ ਤੋਂ ਹਟਾਉਂਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita esta foto de la lista de eliminación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire cette photo de la liste de suppression"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dieses Foto von der Löschliste"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esta foto da lista de exclusão"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questa foto dall'elenco da eliminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を削除リストから外します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 삭제 목록에서 제거합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此照片从删除列表中移除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает это фото из списка на удаление"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذه الصورة من قائمة الحذف"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר תמונה זו מרשימת המחיקה"
          }
        }
      }
    },
    "Replacement saved to library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacement saved to library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदली हुई फ़ाइल लाइब्रेरी में सहेजी गई"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলি ফাইল লাইব্রেরিতে সেভ হয়েছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்றீடு நூலகத்தில் சேமிக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రత్యామ్నాయం లైబ్రరీలో సేవ్ అయింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदली प्रत लायब्ररीत सेव्ह केली"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિપ્લેસમેન્ટ લાઇબ્રેરીમાં સાચવ્યું"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಿ ಪ್ರತಿಯನ್ನು ಲೈಬ್ರರಿಯಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകരം പകർപ്പ് ലൈബ്രറിയിൽ സേവ് ചെയ്തു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲਵੀਂ ਕਾਪੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਸੇਵ ਹੋਈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de reemplazo guardada en la fototeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie de remplacement enregistrée dans la photothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersatzkopie in der Mediathek gesichert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituto salvo na biblioteca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituto salvato nella libreria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替ファイルをライブラリに保存しました"
