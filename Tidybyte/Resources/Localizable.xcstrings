    "Your library looks clean!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library looks clean!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी साफ़ लगती है!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি পরিষ্কার দেখাচ্ছে!"
