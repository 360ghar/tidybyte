    "Find blurry, too dark, and overexposed photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find blurry, too dark, and overexposed photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धुंधली, बहुत गहरी और ज़्यादा एक्सपोज़र वाली फ़ोटो ढूँढें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঝাপসা, খুব গাঢ় ও অতিরিক্ত এক্সপোজড ফটো খুঁজুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மங்கலான, மிக இருண்ட மற்றும் மிக ஒளிர்வான புகைப்படங்களைக் கண்டறி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అస్పష్టమైన, మరీ చీకటిగా ఉన్న మరియు అధిక వెలుతురు ఉన్న ఫోటోలను కనుగొనండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्पष्ट, खूप गडद आणि खूप तेजस्वी फोटो शोधा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝાંખા, બહુ ઘેરા અને બહુ તેજસ્વી ફોટા શોધો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಸ್ಪಷ್ಟ, ತುಂಬಾ ಕತ್ತಲೆಯಾದ ಮತ್ತು ಅತಿ ಹೆಚ್ಚು ಬೆಳಕಿನ ಫೋಟೋಗಳನ್ನು ಹುಡುಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മങ്ങിയതും വളരെ ഇരുണ്ടതും അധിക പ്രകാശമുള്ളതുമായ ഫോട്ടോകൾ കണ്ടെത്തുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਧੁੰਦਲੀਆਂ, ਬਹੁਤ ਗੂੜ੍ਹੀਆਂ ਅਤੇ ਬਹੁਤ ਰੌਸ਼ਨ ਫ਼ੋਟੋਆਂ ਲੱਭੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra fotos borrosas, demasiado oscuras y sobreexpuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez les photos floues, trop sombres et surexposées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde unscharfe, zu dunkle und überbelichtete Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre fotos desfocadas, escuras demais e superexpostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova foto sfocate, troppo scure e sovraesposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼやけた写真、暗すぎる写真、露出オーバーの写真を検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐릿하거나 너무 어둡거나 노출이 과다한 사진을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找模糊、过暗和曝光过度的照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите размытые, слишком темные и пересвеченные фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن الصور الضبابية والداكنة جدًا والمفرطة في التعرض للضوء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצא תמונות מטושטשות, כהות מדי וחשופות מדי."
          }
        }
      }
    },
    "Find exact & visual duplicates": {
      "localizations": {
        "en": {
