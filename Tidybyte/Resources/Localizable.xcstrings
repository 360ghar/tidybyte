    "Decent quality, major savings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decent quality, major savings"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक गुणवत्ता, बड़ी बचत"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোটামুটি গুণমান, বড় সঞ্চয়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நல்ல தரம், அதிக சேமிப்பு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మంచి నాణ్యత, ఎక్కువ పొదుపు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बरा दर्जा, मोठी बचत"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઠીક ગુણવત્તા, મોટી બચત"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತಮ ಗುಣಮಟ್ಟ, ಹೆಚ್ಚಿನ ಉಳಿತಾಯ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മികച്ച ഗുണനിലവാരം, വലിയ ലാഭം"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਧੀਆ ਕੁਆਲਿਟੀ, ਵੱਡੀ ਬਚਤ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena calidad, gran ahorro"
