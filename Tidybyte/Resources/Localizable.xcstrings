    "%@ with TidyByte — a private, on-device photo cleanup app. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ with TidyByte — a private, on-device photo cleanup app. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByte के साथ, एक निजी, डिवाइस पर ही चलने वाला फ़ोटो क्लीनअप ऐप. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByte দিয়ে একটি ব্যক্তিগত, ডিভাইসেই চলা ফটো পরিষ্কার অ্যাপ. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ TidyByte உடன் — தனியுரிமை கொண்ட, சாதனத்திலேயே இயங்கும் புகைப்பட சுத்தம் செய்யும் ஆப். %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByteతో, ప్రైవేట్గా పరికరంలోనే పనిచేసే ఫోటో క్లీన్అప్ యాప్. %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ TidyByte सोबत — एक खाजगी, डिव्हाइसवर चालणारे फोटो क्लीनअप अ‍ॅप. %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ TidyByte સાથે — એક ખાનગી, ડિવાઇસ પર જ ચાલતી ફોટો ક્લીનઅપ એપ. %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByte ನೊಂದಿಗೆ, ಖಾಸಗಿಯಾಗಿ ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಕೆಲಸ ಮಾಡುವ ಫೋಟೋ ಕ್ಲೀನ್ಅಪ್ ಆ್ಯಪ್. %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByte ഉപയോഗിച്ച്, സ്വകാര്യവും ഉപകരണത്തിൽ തന്നെ പ്രവർത്തിക്കുന്നതുമായ ഫോട്ടോ ക്ലീനപ്പ് ആപ്പ്. %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ TidyByte ਨਾਲ — ਇੱਕ ਨਿੱਜੀ, ਡੀਵਾਈਸ ਉੱਤੇ ਹੀ ਚੱਲਣ ਵਾਲੀ ਫ਼ੋਟੋ ਸਫ਼ਾਈ ਐਪ. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ con TidyByte — una app privada de limpieza de fotos en el dispositivo. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avec TidyByte — une app privée de nettoyage de photos sur l'appareil. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — mit TidyByte, einer privaten App zum Aufräumen deiner Fotos, die auf dem Gerät arbeitet. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ com o TidyByte — um app privado de limpeza de fotos no dispositivo. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ con TidyByte — un'app privata per pulire le foto sul dispositivo. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 写真を端末内だけで整理できるプライベートなアプリ、TidyByteで。 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 기기에서만 사진을 정리하는 비공개 앱, TidyByte로. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — TidyByte 是一款在设备本地运行的私密照片清理应用。%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ с TidyByte — приватным приложением для очистки фото, которое работает только на вашем устройстве. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ باستخدام TidyByte — تطبيق خاص لتنظيف الصور على جهازك. %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עם TidyByte — אפליקציה פרטית לניקוי תמונות, על המכשיר. %@"
          }
        }
      }
    },
