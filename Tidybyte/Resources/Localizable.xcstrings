        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી આખી લાઇબ્રેરીમાં ડુપ્લિકેટ શોધે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಇಡೀ ಲೈಬ್ರರಿಯನ್ನು ನಕಲಿಗಳಿಗಾಗಿ ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മുഴുവൻ ലൈബ്രറിയും ഡ്യൂപ്ലിക്കേറ്റുകൾക്കായി സ്കാൻ ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਪੂਰੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਡੁਪਲੀਕੇਟ ਲੱਭਦੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza toda tu fototeca en busca de duplicados"
