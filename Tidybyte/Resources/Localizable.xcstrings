    "No email account is set up on this device. Please email us at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No email account is set up on this device. Please email us at %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कोई ईमेल खाता सेट नहीं है. कृपया हमें %@ पर ईमेल करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে কোনও ইমেল অ্যাকাউন্ট সেট করা নেই. অনুগ্রহ করে %@-এ ইমেল করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் மின்னஞ்சல் கணக்கு அமைக்கப்படவில்லை. %@-க்கு எங்களுக்கு மின்னஞ்சல் அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
