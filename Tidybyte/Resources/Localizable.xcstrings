    "Review whether you still need this screen recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review whether you still need this screen recording."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि क्या आपको यह स्क्रीन रिकॉर्डिंग अभी भी चाहिए."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখে নিন এই স্ক্রিন রেকর্ডিং আপনার এখনও দরকার কি না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் திரைப் பதிவு இன்னும் உங்களுக்குத் தேவையா எனப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ స్క్రీన్ రికార్డింగ్ ఇంకా అవసరమో లేదో సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे स्क्रीन रेकॉर्डिंग अजून हवे आहे का ते तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સ્ક્રીન રેકોર્ડિંગ હજી જોઈએ છે કે નહીં તે તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಇನ್ನೂ ಬೇಕೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സ്ക്രീൻ റെക്കോർഡിംഗ് ഇപ്പോഴും വേണോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਕਰੀਨ ਰਿਕਾਰਡਿੰਗ ਹਾਲੇ ਵੀ ਲੋੜੀਂਦੀ ਹੈ ਕਿ ਨਹੀਂ, ਵੇਖੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa si todavía necesitas esta grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si vous avez encore besoin de cet enregistrement d'écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob du diese Bildschirmaufnahme noch brauchst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja se você ainda precisa desta gravação de tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se ti serve ancora questa registrazione schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面収録がまだ必要か確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면 기록이 아직 필요한지 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你是否还需要这段屏幕录制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, нужна ли вам еще эта запись экрана."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع ما إذا كنت لا تزال تحتاج إلى تسجيل الشاشة هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק אם אתה עדיין צריך את הקלטת המסך הזו."
          }
        }
      }
    },
