    "Come back here and tap Try Again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here and tap Try Again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ वापस आकर “फिर से प्रयास करें” पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে ফিরে এসে “আবার চেষ্টা করুন”-এ ট্যাপ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே திரும்பி வந்து “மீண்டும் முயற்சி” என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడికి తిరిగి వచ్చి “మళ్లీ ప్రయత్నించండి” నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इथे परत येऊन “पुन्हा प्रयत्न करा” वर टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં પાછા આવીને “ફરી પ્રયાસ કરો” પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿಗೆ ಮರಳಿ ಬಂದು “ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ” ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ തിരികെ വന്ന് “വീണ്ടും ശ്രമിക്കുക” ടാപ്പ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਵਾਪਸ ਆ ਕੇ “ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ” ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve aquí y toca «Intentar de nuevo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici et touchez « Réessayer »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm hierher zurück und tippe auf „Erneut versuchen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte aqui e toque em “Tentar novamente”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna qui e tocca «Riprova»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻って「再試行」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아와 ‘다시 시도’를 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回这里并轻点“重试”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда и нажмите «Повторить»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد إلى هنا واضغط «المحاولة مرة أخرى»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזור לכאן והקש על ״נסה שוב״."
          }
        }
      }
    },
