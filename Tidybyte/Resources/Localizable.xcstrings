    "Deleted %lld of %lld items. %lld couldn't be deleted. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted %lld of %lld items. %lld couldn't be deleted. Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld में से %lld आइटम हटाए गए. %lld हटाए नहीं जा सके. फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটির মধ্যে %lld আইটেম মোছা হয়েছে. %lld মোছা যায়নি. আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-இல் %lld உருப்படிகள் நீக்கப்பட்டன. %lld நீக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld అంశాలు తొలగించబడ్డాయి (మొత్తం %lld అంశాలలో). %lld తొలగించలేకపోయాం. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld पैकी %lld आयटम हटवले. %lld हटवता आले नाहीत. पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld માંથી %lld આઇટમ કાઢી નાખ્યા. %lld કાઢી નાખી શકાયા નથી. ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ಐಟಂಗಳನ್ನು ಅಳಿಸಲಾಗಿದೆ (ಒಟ್ಟು %lld ಐಟಂಗಳಲ್ಲಿ). %lld ಅಳಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ഇനങ്ങൾ ഇല്ലാതാക്കി (ആകെ %lld ഇനങ്ങളിൽ). %lld ഇല്ലാതാക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ਵਿੱਚੋਂ %lld ਆਈਟਮ ਮਿਟਾਈਆਂ. %lld ਮਿਟਾਈਆਂ ਨਹੀਂ ਜਾ ਸਕੀਆਂ. ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron %lld de %lld elementos. No se pudieron eliminar %lld. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments sur %lld supprimés. %lld n'ont pas pu être supprimés. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Objekten gelöscht. %lld konnten nicht gelöscht werden. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagados %lld de %lld itens. Não foi possível apagar %lld. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminati %lld elementi su %lld. Impossibile eliminare %lld. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個中%lld個の項目を削除しました。%lld個は削除できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 중 %lld개 항목을 삭제했습니다. %lld개는 삭제하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 %lld 个项目（共 %lld 个）。%lld 个无法删除。请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено %lld из %lld объектов. Не удалось удалить %lld. Повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف %lld من أصل %lld عنصرًا. تعذر حذف %lld. حاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמחקו %lld מתוך %lld פריטים. %lld לא ניתן היה למחוק. נסה שוב."
          }
        }
      }
    },
    "Deleted items go to Recently Deleted in Photos for 30 days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted items go to Recently Deleted in Photos for 30 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाए गए आइटम फ़ोटो में हाल ही में हटाए गए में 30 दिनों के लिए जाते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলা আইটেম ফটো অ্যাপের সম্প্রতি মোছা-য় 30 দিন থাকে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கிய உருப்படிகள் புகைப்படங்களின் சமீபத்தில் நீக்கியவை-இல் 30 நாட்களுக்கு இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగించిన అంశాలు ఫోటోలలోని ఇటీవల తొలగించినవి-లో 30 రోజుల పాటు ఉంటాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवलेले आयटम फोटो अ‍ॅपमधील अलीकडे हटवलेले मध्ये 30 दिवसांसाठी जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખેલા આઇટમ ફોટા એપમાંના તાજેતરમાં કાઢી નાખેલા માં 30 દિવસ માટે જાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸಿದ ಐಟಂಗಳು ಫೋಟೋಗಳ ಆ್ಯಪ್ನ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ಗೆ 30 ದಿನಗಳವರೆಗೆ ಹೋಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കിയ ഇനങ്ങൾ ഫോട്ടോകൾ ആപ്പിലെ അടുത്തിടെ ഇല്ലാതാക്കിയവ യിലേക്ക് 30 ദിവസത്തേക്ക് പോകുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਈਆਂ ਆਈਟਮਾਂ ਫ਼ੋਟੋਜ਼ ਵਿੱਚ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ 30 ਦਿਨਾਂ ਲਈ ਜਾਂਦੀਆਂ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos eliminados van a Recientemente eliminados en Fotos durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments supprimés vont dans Récemment supprimés dans Photos pendant 30 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Objekte werden 30 Tage lang in „Zuletzt gelöscht“ in Fotos verschoben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens apagados vão para Excluídos recentemente no Fotos por 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi eliminati vanno in Eliminati di recente in Foto per 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した項目は「写真」の「最近削除した項目」に30日間保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 항목은 사진 앱의 최근 삭제된 항목에 30일 동안 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的项目会在“照片”的“最近删除”中保留 30 天。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленные объекты попадают в «Недавно удаленные» в «Фото» на 30 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل العناصر المحذوفة إلى «المحذوفة مؤخرًا» في «الصور» لمدة 30 يومًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שנמחקו עוברים אל \"נמחקו לאחרונה\" בתמונות ל-30 ימים."
          }
        }
      }
    },
    "Deleted items go to Recently Deleted in Photos, where you can restore them for 30 days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted items go to Recently Deleted in Photos, where you can restore them for 30 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाए गए आइटम फ़ोटो में हाल ही में हटाए गए में जाते हैं, जहाँ आप उन्हें 30 दिनों तक बहाल कर सकते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলা আইটেম ফটো অ্যাপের সম্প্রতি মোছা-য় যায়, যেখান থেকে 30 দিন পর্যন্ত ফিরিয়ে আনা যায়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கிய உருப்படிகள் புகைப்படங்களின் சமீபத்தில் நீக்கியவை-க்குச் செல்லும், அங்கு 30 நாட்களுக்கு மீட்டெடுக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగించిన అంశాలు ఫోటోలలోని ఇటీవల తొలగించినవి-కు వెళ్తాయి, అక్కడ 30 రోజుల పాటు పునరుద్ధరించవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवलेले आयटम फोटो अ‍ॅपमधील अलीकडे हटवलेले मध्ये जातात, जिथे तुम्ही ते 30 दिवसांपर्यंत पुन्हा मिळवू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખેલા આઇટમ ફોટા એપમાંના તાજેતરમાં કાઢી નાખેલા માં જાય છે, જ્યાં તમે તેને 30 દિવસ સુધી પાછા લાવી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸಿದ ಐಟಂಗಳು ಫೋಟೋಗಳ ಆ್ಯಪ್ನ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ಗೆ ಹೋಗುತ್ತವೆ, ಅಲ್ಲಿ ನೀವು ಅವನ್ನು 30 ದಿನಗಳವರೆಗೆ ಮರುಸ್ಥಾಪಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കിയ ഇനങ്ങൾ ഫോട്ടോകൾ ആപ്പിലെ അടുത്തിടെ ഇല്ലാതാക്കിയവ യിലേക്ക് പോകുന്നു, അവിടെ നിങ്ങൾക്ക് 30 ദിവസത്തേക്ക് അവ തിരികെ കൊണ്ടുവരാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਈਆਂ ਆਈਟਮਾਂ ਫ਼ੋਟੋਜ਼ ਵਿੱਚ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ, ਜਿੱਥੇ ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਨੂੰ 30 ਦਿਨਾਂ ਲਈ ਬਹਾਲ ਕਰ ਸਕਦੇ ਹੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos eliminados van a Recientemente eliminados en Fotos, donde puedes recuperarlos durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments supprimés vont dans Récemment supprimés dans Photos, où vous pouvez les restaurer pendant 30 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Objekte werden in Fotos nach „Zuletzt gelöscht“ verschoben, wo du sie 30 Tage lang wiederherstellen kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens apagados vão para Excluídos recentemente no Fotos, onde você pode restaurá-los por 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi eliminati vanno in Eliminati di recente in Foto, dove puoi recuperarli per 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した項目は「写真」の「最近削除した項目」に移動し、30日間は復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 항목은 사진 앱의 최근 삭제된 항목으로 이동하며, 30일 동안 복원할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的项目会移到“照片”的“最近删除”，你可以在 30 天内恢复它们。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленные объекты попадают в «Недавно удаленные» в «Фото», где их можно восстановить в течение 30 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل العناصر المحذوفة إلى «المحذوفة مؤخرًا» في «الصور»، حيث يمكنك استعادتها خلال 30 يومًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שנמחקו עוברים אל \"נמחקו לאחרונה\" בתמונות, שם ניתן לשחזר אותם במשך 30 ימים."
          }
        }
      }
    },
