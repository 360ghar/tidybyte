    "Undo your newer actions first to reach that photo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo your newer actions first to reach that photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस फ़ोटो तक पहुँचने के लिए पहले अपनी नई कार्रवाइयाँ पूर्ववत करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই ফটোতে পৌঁছাতে আগে আপনার নতুন কাজগুলি আনডু করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் புகைப்படத்தை அடைய முதலில் உங்கள் புதிய செயல்களை மீளச் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫోటోకు చేరుకోవడానికి ముందు మీ కొత్త చర్యలను వెనక్కి తీసుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या फोटोपर्यंत पोहोचण्यासाठी आधी तुमच्या नवीन क्रिया पूर्ववत करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ ફોટો સુધી પહોંચવા પહેલાં તમારી નવી ક્રિયાઓ પૂર્વવત્ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಫೋಟೋ ತಲುಪಲು ಮೊದಲು ನಿಮ್ಮ ಹೊಸ ಕ್ರಿಯೆಗಳನ್ನು ಹಿಂತಿರುಗಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫോട്ടോയിൽ എത്താൻ ആദ്യം നിങ്ങളുടെ പുതിയ നടപടികൾ പഴയപടിയാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਸ ਫ਼ੋਟੋ ਤੱਕ ਪਹੁੰਚਣ ਲਈ ਪਹਿਲਾਂ ਆਪਣੀਆਂ ਨਵੀਆਂ ਕਾਰਵਾਈਆਂ ਵਾਪਸ ਲਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshaz primero las acciones más recientes para llegar a esa foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez d'abord vos actions les plus récentes pour atteindre cette photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache zuerst deine neueren Aktionen rückgängig, um zu diesem Foto zu gelangen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfaça primeiro as ações mais recentes para chegar a essa foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla prima le azioni più recenti per raggiungere quella foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その写真にたどり着くには、まず新しい操作から取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 사진으로 돌아가려면 최근 작업부터 먼저 되돌려야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要先撤销较新的操作，才能回到该照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добраться до этого фото, сначала отмените более поздние действия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع عن إجراءاتك الأحدث أولًا للوصول إلى هذه الصورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל קודם את הפעולות החדשות יותר כדי להגיע לתמונה הזו."
          }
        }
      }
    },
