    "Detect Low-Quality Photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect Low-Quality Photos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम गुणवत्ता वाली फ़ोटो पहचानें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম গুণমানের ফটো শনাক্ত করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரம் குறைந்த புகைப்படங்களைக் கண்டறி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నాణ్యత తక్కువ ఉన్న ఫోటోలను గుర్తించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमी दर्जाचे फोटो ओळखा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચી ગુણવત્તાવાળા ફોટા શોધી કાઢો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಡಿಮೆ ಗುಣಮಟ್ಟದ ಫೋಟೋಗಳನ್ನು ಪತ್ತೆ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞ ഗുണനിലവാരമുള്ള ഫോട്ടോകൾ കണ്ടെത്തുക"
