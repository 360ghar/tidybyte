    "%lld bursts cleaned down to single photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bursts cleaned down to single photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld बर्स्ट साफ़ करके एक-एक फ़ोटो रखी गईं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld বার্স্ট পরিষ্কার করে একটি করে ফটো রাখা হয়েছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld பர்ஸ்ட்கள் தலா ஒரு புகைப்படமாகச் சுத்தம் செய்யப்பட்டன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld బరస్ట్లు ఒకే ఫోటోలకు క్లీన్ చేయబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld बर्स्ट एका फोटोपर्यंत स्वच्छ केले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld બર્સ્ટ એક-એક ફોટા સુધી સાફ થયા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ಬರ್ಸ್ಟ್ಗಳನ್ನು ಒಂದೇ ಫೋಟೋಗಳಿಗೆ ಸ್ವಚ್ಛಗೊಳಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ബർസ്റ്റുകൾ ഒറ്റ ഫോട്ടോകളിലേക്ക് ക്ലീൻ ചെയ്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ਬਰਸਟ ਇੱਕ-ਇੱਕ ਫ਼ੋਟੋ ਤੱਕ ਸਾਫ਼ ਹੋਏ."
          }
        },
