    "Use 300 characters or fewer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 300 characters or fewer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "300 या उससे कम अक्षर इस्तेमाल करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "300 বা তার কম অক্ষর ব্যবহার করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "300 அல்லது அதற்குக் குறைவான எழுத்துகளைப் பயன்படுத்துங்கள்."
          }
