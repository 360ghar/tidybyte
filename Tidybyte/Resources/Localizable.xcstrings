    "Allow Photo Access?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Photo Access?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो ऐक्सेस की अनुमति दें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো অ্যাক্সেসের অনুমতি দেবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்பட அணுகலை அனுமதிக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో యాక్సెస్ అనుమతించాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो प्रवेशाची परवानगी द्यायची?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ઍક્સેસની મંજૂરી આપવી?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಪ್ರವೇಶಕ್ಕೆ ಅನುಮತಿ ನೀಡುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ ആക്സസ് അനുവദിക്കണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਪਹੁੰਚ ਦੀ ਆਗਿਆ ਦੇਣੀ ਹੈ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Permitir acceso a las fotos?"
          }
