        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि TidyByte आपको कितनी जगह वापस पाने में मदद कर सकता है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte আপনাকে কত জায়গা ফেরাতে সাহায্য করতে পারে তা জানায়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte எவ்வளவு இடத்தை மீட்க உதவும் என்பதைச் சொல்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ఎంత స్థలం తిరిగి పొందడంలో సహాయపడుతుందో చెబుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte तुम्हाला किती जागा मिळवून देऊ शकते हे सांगते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte તમને કેટલી જગ્યા પાછી મેળવવામાં મદદ કરી શકે તે જણાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ನಿಮಗೆ ಎಷ್ಟು ಜಾಗ ಮರಳಿ ಪಡೆಯಲು ಸಹಾಯ ಮಾಡಬಲ್ಲದು ಎಂದು ತಿಳಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എത്ര സ്ഥലം തിരികെ നേടാൻ TidyByte സഹായിക്കും എന്ന് അറിയിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੱਸਦਾ ਹੈ ਕਿ TidyByte ਤੁਹਾਨੂੰ ਕਿੰਨੀ ਥਾਂ ਵਾਪਸ ਲੈਣ ਵਿੱਚ ਮਦਦ ਕਰ ਸਕਦਾ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto espacio puede ayudarte a recuperar TidyByte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous indique combien d'espace TidyByte peut vous aider à récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt dir, wie viel Speicher TidyByte dir zurückgewinnen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto espaço o TidyByte pode ajudar você a recuperar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dice quanto spazio TidyByte può aiutarti a recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByteが確保できる容量を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte가 확보할 수 있는 공간을 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你 TidyByte 能帮你回收多少空间。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, сколько места TidyByte поможет вам вернуть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بمقدار المساحة التي يمكن أن يساعدك TidyByte في استردادها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מראה כמה מקום TidyByte יכול לעזור לך לפנות."
          }
        }
      }
    },
