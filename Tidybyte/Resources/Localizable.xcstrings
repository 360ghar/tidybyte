    "How Much Can I Free Up?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Much Can I Free Up?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं कितनी जगह खाली कर सकता हूँ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি কতটা খালি করতে পারি?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் எவ்வளவு காலி செய்ய முடியும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను ఎంత ఖాళీ చేయగలను?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी किती जागा मोकळी करू शकतो?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું કેટલી જગ્યા ખાલી કરી શકું?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಎಷ್ಟು ಜಾಗ ಖಾಲಿ ಮಾಡಬಹುದು?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എത്ര സ്ഥലം ഒഴിവാക്കാനാകും?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਕਿੰਨੀ ਥਾਂ ਖਾਲੀ ਕਰ ਸਕਦਾ ਹਾਂ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto espacio puedo liberar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien d'espace puis-je libérer ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel kann ich freigeben?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto posso liberar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto spazio posso liberare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれくらい空けられますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 확보할 수 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能释放多少空间？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько места можно освободить?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم يمكنني تحريره؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה מקום אפשר לפנות?"
          }
        }
      }
    },
