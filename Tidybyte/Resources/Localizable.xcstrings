    "Group photos into memes, documents, food, pets, nature, selfies and media saved from other apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group photos into memes, documents, food, pets, nature, selfies and media saved from other apps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो को मीम, दस्तावेज़, खाना, पालतू जानवर, प्रकृति, सेल्फ़ी और दूसरे ऐप्स से सहेजे गए मीडिया में समूहित करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটোকে মিম, ডকুমেন্ট, খাবার, পোষা প্রাণী, প্রকৃতি, সেলফি ও অন্য অ্যাপ থেকে সেভ করা মিডিয়ায় ভাগ করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களை மீம்கள், ஆவணங்கள், உணவு, செல்லப்பிராணிகள், இயற்கை, செல்ஃபிகள் மற்றும் பிற ஆப்களிலிருந்து சேமித்த மீடியா என வகைப்படுத்து."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను మీమ్లు, పత్రాలు, ఆహారం, పెంపుడు జంతువులు, ప్రకృతి, సెల్ఫీలు మరియు ఇతర యాప్ల నుండి సేవ్ చేసిన మీడియాగా సమూహపరుస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो मीम, दस्तऐवज, अन्न, पाळीव प्राणी, निसर्ग, सेल्फी आणि इतर अ‍ॅप्समधून सेव्ह केलेल्या मीडियामध्ये गटबद्ध करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટાને મીમ્સ, દસ્તાવેજો, ખોરાક, પાળતુ પ્રાણી, પ્રકૃતિ, સેલ્ફી અને બીજી એપ્સમાંથી સાચવેલા મીડિયામાં ગોઠવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಮೆಮ್ಗಳು, ದಾಖಲೆಗಳು, ಆಹಾರ, ಸಾಕುಪ್ರಾಣಿಗಳು, ಪ್ರಕೃತಿ, ಸೆಲ್ಫಿಗಳು ಮತ್ತು ಬೇರೆ ಆ್ಯಪ್ಗಳಿಂದ ಉಳಿಸಿದ ಮೀಡಿಯಾ ಎಂದು ಗುಂಪು ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകളെ മീമുകൾ, ഡോക്യുമെന്റുകൾ, ഭക്ഷണം, വളർത്തുമൃഗങ്ങൾ, പ്രകൃതി, സെൽഫികൾ, മറ്റ് ആപ്പുകളിൽ നിന്ന് സേവ് ചെയ്ത മീഡിയ എന്നിവയായി ഗ്രൂപ്പ് ചെയ്യുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਨੂੰ ਮੀਮਜ਼, ਦਸਤਾਵੇਜ਼, ਖਾਣਾ, ਪਾਲਤੂ ਜਾਨਵਰ, ਕੁਦਰਤ, ਸੈਲਫ਼ੀਆਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਤੋਂ ਸੇਵ ਕੀਤੇ ਮੀਡੀਆ ਵਿੱਚ ਵੰਡੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa las fotos en memes, documentos, comida, mascotas, naturaleza, selfis y elementos guardados desde otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les photos en mèmes, documents, nourriture, animaux, nature, selfies et éléments enregistrés depuis d'autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne Fotos in Memes, Dokumente, Essen, Haustiere, Natur, Selfies und aus anderen Apps gesicherte Medien ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe as fotos em memes, documentos, comida, animais de estimação, natureza, selfies e mídia salva de outros apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le foto in meme, documenti, cibo, animali, natura, selfie e contenuti salvati da altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をミーム、書類、食べ物、ペット、自然、自撮り、他のアプリから保存したメディアに分類します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 밈, 서류, 음식, 반려동물, 자연, 셀카, 다른 앱에서 저장한 미디어로 분류합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片归入表情包、文稿、美食、宠物、自然、自拍以及从其他 App 保存的媒体。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределяет фото по категориям: мемы, документы, еда, питомцы, природа, селфи и медиафайлы, сохраненные из других приложений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمّع الصور في فئات: الميمات والمستندات والطعام والحيوانات الأليفة والطبيعة وصور سيلفي والوسائط المحفوظة من تطبيقات أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבץ תמונות לממים, מסמכים, אוכל, חיות מחמד, טבע, סלפי ומדיה שנשמרה מאפליקציות אחרות."
          }
        }
      }
    },
    "Grouping similar photos...": {
