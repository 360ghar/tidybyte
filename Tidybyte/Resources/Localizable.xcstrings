    "Local AI could not interpret this search.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local AI could not interpret this search."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल AI इस खोज को समझ नहीं सका."
