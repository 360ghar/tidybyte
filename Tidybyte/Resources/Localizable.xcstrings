    "Vibration feedback when you swipe, tap, and finish a cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibration feedback when you swipe, tap, and finish a cleanup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप करने, टैप करने और क्लीनअप पूरा करने पर कंपन प्रतिक्रिया."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোয়াইপ, ট্যাপ ও পরিষ্কার শেষ করার সময় কম্পন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்வைப் செய்யும்போதும், தட்டும்போதும், சுத்தம் முடிக்கும்போதும் அதிர்வு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వైప్ చేసినప్పుడు, నొక్కినప్పుడు, క్లీన్అప్ ముగించినప్పుడు కంపనం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप, टॅप आणि क्लीनअप पूर्ण करताना कंपन अभिप्राय."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વાઇપ, ટૅપ અને ક્લીનઅપ પૂરું કરતી વખતે વાઇબ્રેશન પ્રતિસાદ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವೈಪ್, ಟ್ಯಾಪ್ ಮತ್ತು ಕ್ಲೀನ್ಅಪ್ ಮುಗಿಸುವಾಗ ಕಂಪನ ಪ್ರತಿಕ್ರಿಯೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വൈപ്പ്, ടാപ്പ്, ക്ലീനപ്പ് പൂർത്തിയാക്കൽ എന്നിവയിൽ വൈബ്രേഷൻ ഫീഡ്ബാക്ക്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਸੀਂ ਸਵਾਈਪ ਕਰਦੇ, ਟੈਪ ਕਰਦੇ ਅਤੇ ਸਫ਼ਾਈ ਪੂਰੀ ਕਰਦੇ ਹੋ ਤਾਂ ਵਾਈਬ੍ਰੇਸ਼ਨ ਫੀਡਬੈਕ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta por vibración cuando deslizas, tocas y terminas una limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour par vibration lorsque vous balayez, touchez et terminez un nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrationsfeedback beim Wischen, Tippen und Abschließen einer Bereinigung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorno por vibração ao deslizar, tocar e concluir uma limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback a vibrazione quando scorri, tocchi e concludi una pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプ、タップ、クリーンアップ完了時に振動で知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프, 탭, 정리 완료 시 진동으로 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动、轻点和完成清理时的振动反馈。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрация при свайпах, нажатиях и завершении очистки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتزاز عند السحب والضغط وإنهاء التنظيف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משוב רטט כשאתה מחליק, מקיש ומסיים ניקוי."
          }
        }
      }
    },
