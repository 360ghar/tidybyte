    "Scans your library for photos taken close together": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your library for photos taken close together"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "करीब-करीब एक ही समय पर ली गई फ़ोटो के लिए आपकी लाइब्रेरी स्कैन करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছাকাছি সময়ে তোলা ফটোর জন্য আপনার লাইব্রেরি স্ক্যান করে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நெருக்கமாக எடுத்த புகைப்படங்களுக்காக உங்கள் நூலகத்தை ஸ்கேன் செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరగా తీసిన ఫోటోల కోసం మీ లైబ్రరీని స్కాన్ చేస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जवळपास घेतलेले फोटो शोधण्यासाठी तुमच्या लायब्ररीचे स्कॅन करते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નજીકમાં લેવાયેલા ફોટા માટે તમારી લાઇબ્રેરી સ્કેન કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹತ್ತಿರ ಹತ್ತಿರ ತೆಗೆದ ಫೋಟೋಗಳಿಗಾಗಿ ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തൊട്ടടുത്ത് എടുത്ത ഫോട്ടോകൾക്കായി നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੇੜੇ-ਨੇੜੇ ਖਿੱਚੀਆਂ ਫ਼ੋਟੋਆਂ ਲਈ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰਦੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu fototeca en busca de fotos tomadas con poca diferencia de tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse votre photothèque à la recherche de photos prises à peu d'intervalle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht deine Mediathek nach Fotos, die kurz nacheinander aufgenommen wurden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa a biblioteca em busca de fotos tiradas com pouco intervalo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la libreria alla ricerca di foto scattate a poca distanza di tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリをスキャンして、近い時間に撮影された写真を探します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 짧은 간격으로 찍은 사진을 스캔합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描图库，查找拍摄时间相近的照片"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует медиатеку на фото, снятые с небольшим интервалом"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص مكتبتك بحثًا عن صور ملتقطة في أوقات متقاربة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סורק את הספרייה לאיתור תמונות שצולמו בסמיכות"
          }
        }
      }
