    "Moved to Recently Deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to Recently Deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल ही में हटाए गए में भेजी गईं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্প্রতি মোছা-য় সরানো হয়েছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்தில் நீக்கியவை-க்கு நகர்த்தப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇటీవల తొలగించినవి-కు తరలించబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलीकडे हटवलेले मध्ये हलवले"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તાજેતરમાં કાઢી નાખેલા માં ખસેડ્યું"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ಗೆ ಸರಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തിടെ ഇല്ലാതാക്കിയവ യിലേക്ക് മാറ്റി"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਭੇਜੀਆਂ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movidos a Recientemente eliminados"
          }
