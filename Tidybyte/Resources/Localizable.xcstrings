    "Track everything you clean up over time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track everything you clean up over time"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ आपके सारे क्लीनअप ट्रैक करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়ের সাথে আপনার সব পরিষ্কার ট্র্যাক করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலப்போக்கில் உங்கள் எல்லா சுத்தங்களையும் கண்காணி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాలక్రమేణా మీ క్లీన్అప్లన్నీ ట్రాక్ చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काळानुसार तुम्ही स्वच्छ केलेले सर्व मागोवा घ्या"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમય સાથે તમે સાફ કરેલું બધું ટ્રૅક કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾಲಾನಂತರದಲ್ಲಿ ನೀವು ಸ್ವಚ್ಛಗೊಳಿಸಿದ ಎಲ್ಲವನ್ನೂ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലക്രമേണ നിങ്ങൾ ക്ലീൻ ചെയ്തതെല്ലാം ട്രാക്ക് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੇਂ ਦੇ ਨਾਲ ਤੁਸੀਂ ਜੋ ਵੀ ਸਾਫ਼ ਕਰਦੇ ਹੋ, ਉਸਨੂੰ ਟਰੈਕ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra todo lo que limpias con el tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez tout ce que vous nettoyez au fil du temps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge mit der Zeit alles, was du bereinigst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe tudo o que você limpa ao longo do tempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia di tutto ciò che pulisci nel tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップした内容を記録します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리한 내용을 시간순으로 기록합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你随时间清理的所有内容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте всю очистку с течением времени"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبّع كل ما تنظفه بمرور الوقت"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר כל מה שניקית לאורך זמן"
          }
        }
      }
    },
