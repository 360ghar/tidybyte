            "value": "ಫೋಕಸ್ ಹೊರಗೆ ಮತ್ತು ಕಡಿಮೆ ಬೆಳಕಿನ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോക്കസ് ഇല്ലാത്തതും കുറഞ്ഞ വെളിച്ചത്തിലുള്ളതും"
