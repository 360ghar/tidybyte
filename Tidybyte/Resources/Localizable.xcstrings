    "Space cleaned up per day over the last 30 days": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space cleaned up per day over the last 30 days"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 30 दिनों में प्रतिदिन साफ़ की गई जगह"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত 30 দিনে প্রতিদিন পরিষ্কার করা জায়গা"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த 30 நாட்களில் நாளொன்றுக்கு சுத்தம் செய்யப்பட்ட இடம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత 30 రోజుల్లో రోజుకు శుభ్రం చేసిన స్థలం"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या 30 दिवसांत दररोज स्वच्छ केलेली जागा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા 30 દિવસમાં રોજ સાફ કરેલી જગ્યા"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ 30 ದಿನಗಳಲ್ಲಿ ದಿನಕ್ಕೆ ಸ್ವಚ್ಛಗೊಳಿಸಿದ ಜಾಗ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ 30 ദിവസത്തിൽ ദിവസേന ക്ലീൻ ചെയ്ത സ്ഥലം"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ 30 ਦਿਨਾਂ ਵਿੱਚ ਪ੍ਰਤੀ ਦਿਨ ਖਾਲੀ ਕੀਤੀ ਥਾਂ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio liberado por día en los últimos 30 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libéré par jour sur les 30 derniers jours"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Tag freigegebener Speicher in den letzten 30 Tagen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço liberado por dia nos últimos 30 dias"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio liberato al giorno negli ultimi 30 giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去30日間の1日あたりのクリーンアップ量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30일 동안 하루 평균 정리한 공간"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 30 天每天清理的空间"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место, очищаемое в день за последние 30 дней"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساحة المنظفة يوميًا خلال آخر 30 يومًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקום שנוקה ביום ב-30 הימים האחרונים"
          }
        }
      }
    },
    "Space comes back after Photos empties Recently Deleted (up to 30 days).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space comes back after Photos empties Recently Deleted (up to 30 days)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो द्वारा हाल ही में हटाए गए खाली करने के बाद जगह वापस आती है (30 दिन तक)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো সম্প্রতি মোছা খালি করলে জায়গা ফিরে আসে (30 দিন পর্যন্ত)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்கள் சமீபத்தில் நீக்கியவை-ஐக் காலி செய்த பின் இடம் திரும்பும் (30 நாட்கள் வரை)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు ఇటీవల తొలగించినవి-ను ఖాళీ చేసిన తర్వాత స్థలం తిరిగి వస్తుంది (30 రోజుల వరకు)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो अ‍ॅपने अलीकडे हटवलेले रिकामे केल्यावर जागा परत मिळते (30 दिवसांपर्यंत)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા એપ તાજેતરમાં કાઢી નાખેલા ખાલી કરે પછી જગ્યા પાછી મળે છે (30 દિવસ સુધી)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳ ಆ್ಯಪ್ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ಖಾಲಿ ಮಾಡಿದ ನಂತರ ಜಾಗ ಮರಳಿ ಬರುತ್ತದೆ (30 ದಿನಗಳವರೆಗೆ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ ആപ്പ് അടുത്തിടെ ഇല്ലാതാക്കിയവ ഒഴിവാക്കിയ ശേഷം സ്ഥലം തിരികെ ലഭിക്കും (30 ദിവസം വരെ)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਥਾਂ ਉਦੋਂ ਵਾਪਸ ਆਉਂਦੀ ਹੈ ਜਦੋਂ ਫ਼ੋਟੋਜ਼ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਨੂੰ ਖਾਲੀ ਕਰਦਾ ਹੈ (30 ਦਿਨਾਂ ਤੱਕ)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio se recupera cuando Fotos vacía Recientemente eliminados (hasta 30 días)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace est récupéré quand Photos vide Récemment supprimés (jusqu'à 30 jours)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher wird frei, sobald Fotos „Zuletzt gelöscht“ leert (bis zu 30 Tage)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço volta depois que o Fotos esvaziar Excluídos recentemente (até 30 dias)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio torna dopo che Foto svuota Eliminati di recente (fino a 30 giorni)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量は「写真」が「最近削除した項目」を消去した後に戻ります（最長30日）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간은 사진 앱이 최근 삭제된 항목을 비운 뒤에 돌아옵니다(최대 30일)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“照片”清空“最近删除”后，空间会释放（最多 30 天）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место вернется после того, как «Фото» очистит «Недавно удаленные» (до 30 дней)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود المساحة بعد أن يفرّغ تطبيق «الصور» «المحذوفة مؤخرًا» (حتى 30 يومًا)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקום מתפנה לאחר שאפליקציית תמונות מרוקנת את \"נמחקו לאחרונה\" (עד 30 ימים)."
          }
        }
      }
    },
    "Space comes back when it is emptied. In Photos, open Albums, then Recently Deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space comes back when it is emptied. In Photos, open Albums, then Recently Deleted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खाली करने पर जगह वापस आती है. फ़ोटो में, एल्बम खोलें, फिर हाल ही में हटाए गए."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি খালি করলে জায়গা ফিরে আসে. ফটো-তে অ্যালবাম খুলুন, তারপর সম্প্রতি মোছা."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது காலி செய்யப்படும்போது இடம் திரும்பும். புகைப்படங்களில் ஆல்பங்களைத் திறந்து, பின் சமீபத்தில் நீக்கியவை என்பதைத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది ఖాళీ చేయబడినప్పుడు స్థలం తిరిగి వస్తుంది. ఫోటోలలో ఆల్బమ్లు తెరిచి, ఆపై ఇటీవల తొలగించినవి తెరవండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते रिकामे केल्यावर जागा परत मिळते. फोटो अ‍ॅपमध्ये अल्बम उघडा, नंतर अलीकडे हटवलेले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે ખાલી થાય ત્યારે જગ્યા પાછી મળે છે. ફોટા એપમાં આલ્બમ ખોલો, પછી તાજેતરમાં કાઢી નાખેલા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅದನ್ನು ಖಾಲಿ ಮಾಡಿದಾಗ ಜಾಗ ಮರಳಿ ಬರುತ್ತದೆ. ಫೋಟೋಗಳ ಆ್ಯಪ್ನಲ್ಲಿ ಆಲ್ಬಮ್ಗಳು ತೆರೆದು, ನಂತರ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ತೆರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് ഒഴിവാക്കുമ്പോൾ സ്ഥലം തിരികെ ലഭിക്കും. ഫോട്ടോകൾ ആപ്പിൽ ആൽബങ്ങൾ തുറന്ന്, എന്നിട്ട് അടുത്തിടെ ഇല്ലാതാക്കിയവ തുറക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਖਾਲੀ ਹੋਣ 'ਤੇ ਥਾਂ ਵਾਪਸ ਆਉਂਦੀ ਹੈ. ਫ਼ੋਟੋਜ਼ ਵਿੱਚ ਐਲਬਮਾਂ ਖੋਲ੍ਹੋ, ਫਿਰ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio se recupera cuando se vacíe. En Fotos, abre Álbumes y luego Recientemente eliminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace est récupéré quand il est vidé. Dans Photos, ouvrez Albums, puis Récemment supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher wird frei, sobald der Ordner geleert wird. Öffne in Fotos „Alben“, dann „Zuletzt gelöscht“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço volta quando ele for esvaziado. No Fotos, abra Álbuns e depois Excluídos recentemente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio torna quando viene svuotato. In Foto, apri Album, poi Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空にすると空き容量が戻ります。「写真」で「アルバム」を開き、「最近削除した項目」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비우면 저장 공간이 돌아옵니다. 사진 앱에서 앨범을 연 다음 최근 삭제된 항목을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空后空间才会释放。在“照片”中打开“相簿”，再打开“最近删除”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место вернется, когда оно будет очищено. В «Фото» откройте «Альбомы», затем «Недавно удаленные»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود المساحة عند تفريغها. في «الصور»، افتح «الألبومات»، ثم «المحذوفة مؤخرًا»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקום מתפנה כשמרוקנים אותה. בתמונות, פתח את אלבומים ואז את \"נמחקו לאחרונה\"."
          }
        }
      }
    },
    "Space you free up with any cleanup tool shows up here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space you free up with any cleanup tool shows up here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी क्लीनअप टूल से खाली की गई जगह यहाँ दिखती है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কোনও পরিষ্কার টুল দিয়ে খালি করা জায়গা এখানে দেখা যায়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தச் சுத்தம் கருவியிலும் நீங்கள் காலி செய்யும் இடம் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ క్లీన్అప్ సాధనంతోనైనా మీరు ఖాళీ చేసే స్థలం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही क्लीनअप साधनाने तुम्ही मोकळी केलेली जागा इथे दिसते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈપણ ક્લીનઅપ ટૂલથી તમે ખાલી કરેલી જગ્યા અહીં દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಕ್ಲೀನ್ಅಪ್ ಪರಿಕರದಿಂದ ನೀವು ಖಾಲಿ ಮಾಡುವ ಜಾಗ ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് ക്ലീനപ്പ് ടൂളിലൂടെയും നിങ്ങൾ ഒഴിവാക്കുന്ന സ്ഥലം ഇവിടെ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਵੀ ਸਫ਼ਾਈ ਟੂਲ ਨਾਲ ਤੁਸੀਂ ਖਾਲੀ ਕੀਤੀ ਥਾਂ ਇੱਥੇ ਦਿਖਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio que liberes con cualquier herramienta de limpieza aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace que vous libérez avec n'importe quel outil de nettoyage apparaît ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher, den du mit einem beliebigen Bereinigungstool freigibst, erscheint hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço que você liberar com qualquer ferramenta de limpeza aparece aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio che liberi con qualsiasi strumento di pulizia compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのクリーンアップツールで空けた容量もここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 정리 도구로 확보한 공간이든 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用任何清理工具释放的空间都会显示在这里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место, которое вы освободите любым инструментом очистки, появится здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
