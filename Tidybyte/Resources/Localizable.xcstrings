    "Scans your whole library for duplicates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your whole library for duplicates"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पूरी लाइब्रेरी में डुप्लिकेट के लिए स्कैन करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পুরো লাইব্রেরিতে ডুপ্লিকেটের জন্য স্ক্যান করে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முழு நூலகத்திலும் நகல்களைத் தேடும்"
