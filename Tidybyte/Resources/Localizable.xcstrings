{
  "sourceLanguage": "en",
  "strings": {
    " Favorites are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Favorites are kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " पसंदीदा रखी जाती हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " প্রিয় আইটেম রাখা হয়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": " பிடித்தவை வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": " ఇష్టమైనవి ఉంచబడతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": " आवडते ठेवले जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": " પસંદ રાખવામાં આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": " ಮೆಚ್ಚಿನವು ಇರಿಸಲಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": " പ്രിയപ്പെട്ടവ നിലനിർത്തുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": " ਪਸੰਦੀਦਾ ਰੱਖੇ ਜਾਂਦੇ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Los favoritos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les favoris sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Favoriten werden behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Os favoritos são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I preferiti vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " お気に入りは残されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 즐겨찾기는 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 收藏的照片会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Избранное остается."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " المفضلة محتفظ بها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " מועדפים נשמרים."
          }
        }
      }
    },
    " in selected photos": {
