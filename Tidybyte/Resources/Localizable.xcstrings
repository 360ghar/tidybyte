    "Sent every week at %@ on the day you pick. Tapping it opens Cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent every week at %@ on the day you pick. Tapping it opens Cleanup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हफ़्ते %@ पर, आपके चुने दिन भेजा जाता है. इस पर टैप करने से क्लीनअप खुलता है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি সপ্তাহে %@-এ, আপনি যে দিন বাছেন সেদিন পাঠানো হয়. এতে ট্যাপ করলে পরিষ্কার খোলে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வாரமும் %@-இல், நீங்கள் தேர்ந்தெடுக்கும் நாளில் அனுப்பப்படும். அதைத் தட்டினால் சுத்தம் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి వారం %@కు, మీరు ఎంచుకున్న రోజున పంపబడుతుంది. దాన్ని నొక్కితే క్లీన్అప్ తెరుచుకుంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेल्या दिवशी दर आठवड्याला %@ वाजता पाठवले जाते. त्यावर टॅप केल्यास क्लीनअप उघडते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરેલા દિવસે દર અઠવાડિયે %@ વાગ્યે મોકલાય છે. તેના પર ટૅપ કરવાથી ક્લીનઅપ ખૂલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಯ್ಕೆಮಾಡಿದ ದಿನದಂದು ಪ್ರತಿ ವಾರ %@ ಕ್ಕೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಅದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿದರೆ ಕ್ಲೀನ್ಅಪ್ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ദിവസം എല്ലാ ആഴ്ചയും %@-ന് അയയ്ക്കുന്നു. അതിൽ ടാപ്പ് ചെയ്താൽ ക്ലീനപ്പ് തുറക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਹਫ਼ਤੇ ਤੁਹਾਡੇ ਚੁਣੇ ਦਿਨ %@ ਵਜੇ ਭੇਜਿਆ ਜਾਂਦਾ ਹੈ. ਇਸਨੂੰ ਟੈਪ ਕਰਨ ਨਾਲ ਸਫ਼ਾਈ ਖੁੱਲ੍ਹਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía cada semana a las %@ el día que elijas. Al tocarlo, se abre Limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé chaque semaine à %@ le jour que vous choisissez. Appuyer dessus ouvre Nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird jede Woche um %@ an dem von dir gewählten Tag gesendet. Beim Tippen wird Bereinigung geöffnet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado toda semana às %@ no dia que você escolher. Tocar nele abre a Limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato ogni settimana alle %@ nel giorno che scegli. Toccandolo si apre Pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ曜日の%@に毎週送信されます。タップするとクリーンアップが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일의 %@에 매주 전송됩니다. 탭하면 정리가 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周在你选择的那天 %@ 发送。轻点它会打开“清理”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляется каждую неделю в %@ в выбранный вами день. При нажатии открывается «Очистка»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل كل أسبوع عند %@ في اليوم الذي تختاره. الضغط عليه يفتح «التنظيف»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח בכל שבוע בשעה %@ ביום שתבחר. הקשה עליו פותחת את הניקוי."
          }
        }
      }
    },
