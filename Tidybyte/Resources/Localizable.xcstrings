    "No more photos to review with this filter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more photos to review with this filter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़िल्टर के साथ समीक्षा के लिए और फ़ोटो नहीं हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিল্টারে দেখার মতো আর ফটো নেই."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வடிகட்டியில் பார்க்க மேலும் புகைப்படங்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫిల్టర్తో సమీక్షించడానికి ఇంకా ఫోటోలు లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फिल्टरसह पुनरावलोकनासाठी आणखी फोटो नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફિલ્ટર સાથે સમીક્ષા માટે વધુ ફોટા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫಿಲ್ಟರ್ನೊಂದಿಗೆ ಪರಿಶೀಲಿಸಲು ಇನ್ನಷ್ಟು ಫೋಟೋಗಳಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫിൽട്ടറിൽ പരിശോധിക്കാൻ കൂടുതൽ ഫോട്ടോകളില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫਿਲਟਰ ਨਾਲ ਸਮੀਖਿਆ ਲਈ ਹੋਰ ਫ਼ੋਟੋਆਂ ਨਹੀਂ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay más fotos para revisar con este filtro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus aucune photo à examiner avec ce filtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Filter sind keine weiteren Fotos zu prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais fotos para revisar com este filtro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono altre foto da esaminare con questo filtro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルタで確認する写真はもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필터로 검토할 사진이 더 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此筛选条件下没有更多照片可查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этим фильтром больше нет фото для просмотра."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مزيد من الصور للمراجعة بعامل التصفية هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עוד תמונות לסקירה עם מסנן זה."
          }
        }
      }
    },
    "No photo is waiting to be filed. Dismiss and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photo is waiting to be filed. Dismiss and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एल्बम में रखने के लिए कोई फ़ोटो प्रतीक्षा में नहीं है. बंद करें और फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালবামে রাখার মতো কোনও ফটো অপেক্ষা করছে না. বন্ধ করে আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆல்பத்தில் சேர்க்க காத்திருக்கும் புகைப்படம் எதுவும் இல்லை. நிராகரித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్ చేయడానికి ఏ ఫోటో నిరీక్షణలో లేదు. మూసివేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अल्बममध्ये ठेवण्यासाठी कोणताही फोटो बाकी नाही. बंद करा आणि पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આલ્બમમાં મૂકવા માટે કોઈ ફોટો બાકી નથી. બંધ કરો અને ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೋಡಿಸಲು ಯಾವ ಫೋಟೋವೂ ಕಾಯುತ್ತಿಲ್ಲ. ಮುಚ್ಚಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചേർക്കാൻ കാത്തിരിക്കുന്ന ഫോട്ടോ ഒന്നുമില്ല. അടച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਲਬਮ ਵਿੱਚ ਰੱਖਣ ਲਈ ਕੋਈ ਫ਼ੋਟੋ ਬਾਕੀ ਨਹੀਂ. ਬੰਦ ਕਰੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna foto pendiente de archivar. Cierra y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo n'attend d'être classée. Fermez et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wartet kein Foto zum Einsortieren. Schließe den Dialog und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma foto está aguardando para ser arquivada. Feche e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna foto è in attesa di archiviazione. Chiudi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムに追加する写真がありません。閉じて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범에 넣을 사진이 없습니다. 닫고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有等待归档的照片。请关闭后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет фото, ожидающего помещения в альбом. Закройте и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صورة في انتظار الحفظ في ألبوم. أغلق وحاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תמונה שממתינה לשיוך לאלבום. סגור ונסה שוב."
          }
        }
      }
    },
