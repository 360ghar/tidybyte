    "Groups photos taken within %lld seconds of each other.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups photos taken within %lld seconds of each other."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-दूसरे से %lld सेकंड के भीतर ली गई फ़ोटो को समूहित करता है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একে অপরের থেকে %lld সেকেন্ডের মধ্যে তোলা ফটো গ্রুপ করে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்றுக்கொன்று %lld விநாடிகளுக்குள் எடுக்கப்பட்ட புகைப்படங்களை ஒரே குழுவாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకదానికొకటి %lld సెకన్లలోపు తీసిన ఫోటోలను సమూహపరుస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकमेकांच्या %lld सेकंदांच्या आत घेतलेले फोटो गटबद्ध करते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એકબીજાથી %lld સેકંડની અંદર લીધેલા ફોટાને જૂથમાં ગોઠવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದಕ್ಕೊಂದು %lld ಸೆಕೆಂಡ್ಗಳ ಒಳಗೆ ತೆಗೆದ ಫೋಟೋಗಳನ್ನು ಗುಂಪು ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരസ്പരം %lld സെക്കൻഡിനുള്ളിൽ എടുത്ത ഫോട്ടോകൾ ഗ്രൂപ്പ് ചെയ്യുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਦੂਜੇ ਤੋਂ %lld ਸਕਿੰਟ ਦੇ ਅੰਦਰ ਖਿੱਚੀਆਂ ਫ਼ੋਟੋਆਂ ਨੂੰ ਇੱਕ ਗਰੁੱਪ ਵਿੱਚ ਰੱਖਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa las fotos tomadas con %lld segundos de diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe les photos prises à %lld secondes d'intervalle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppiert Fotos, die innerhalb von %lld Sekunden aufgenommen wurden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa fotos tiradas com %lld segundos de diferença."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le foto scattate a %lld secondi di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影間隔が%lld秒以内の写真をまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초 이내에 촬영된 사진을 그룹으로 묶습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将拍摄时间相差 %lld 秒以内的照片归为一组。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группирует фото, снятые в пределах %lld секунд друг от друга."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجمع الصور الملتقطة خلال %lld ثانية من بعضها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקבץ תמונות שצולמו בהפרש של עד %lld שניות זו מזו."
          }
        }
      }
    },
