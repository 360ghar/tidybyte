    "Not enough data yet. TidyByte records the size once a day when you open the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data yet. TidyByte records the size once a day when you open the app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पर्याप्त डेटा नहीं है. ऐप खोलने पर TidyByte दिन में एक बार आकार रिकॉर्ड करता है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও যথেষ্ট ডেটা নেই. অ্যাপ খুললে TidyByte দিনে একবার আকার রেকর্ড করে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் போதுமான தரவு இல்லை. ஆப்பைத் திறக்கும்போது TidyByte நாளுக்கு ஒருமுறை அளவைப் பதிவு செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా సరిపడా డేటా లేదు. యాప్ తెరిచినప్పుడు TidyByte రోజుకు ఒకసారి పరిమాణాన్ని నమోదు చేస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून पुरेसा डेटा नाही. तुम्ही अ‍ॅप उघडल्यावर TidyByte दिवसातून एकदा आकार नोंदवतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી પૂરતો ડેટા નથી. તમે એપ ખોલો ત્યારે TidyByte દિવસમાં એક વાર સાઇઝ નોંધે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಸಾಕಷ್ಟು ಡೇಟಾ ಇಲ್ಲ. ನೀವು ಆ್ಯಪ್ ತೆರೆದಾಗ TidyByte ದಿನಕ್ಕೊಮ್ಮೆ ಗಾತ್ರವನ್ನು ದಾಖಲಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ മതിയായ ഡാറ്റയില്ല. നിങ്ങൾ ആപ്പ് തുറക്കുമ്പോൾ TidyByte ദിവസത്തിൽ ഒരിക്കൽ വലിപ്പം രേഖപ്പെടുത്തുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਲੋੜੀਂਦਾ ਡਾਟਾ ਨਹੀਂ ਹੈ. ਜਦੋਂ ਤੁਸੀਂ ਐਪ ਖੋਲ੍ਹਦੇ ਹੋ ਤਾਂ TidyByte ਦਿਨ ਵਿੱਚ ਇੱਕ ਵਾਰ ਆਕਾਰ ਦਰਜ ਕਰਦਾ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes datos. TidyByte registra el tamaño una vez al día cuando abres la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de données. TidyByte enregistre la taille une fois par jour lorsque vous ouvrez l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genug Daten. TidyByte erfasst die Größe einmal täglich, wenn du die App öffnest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes. O TidyByte registra o tamanho uma vez por dia quando você abre o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati ancora insufficienti. TidyByte registra la dimensione una volta al giorno quando apri l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがまだ足りません。TidyByteはアプリを開いたときに1日1回サイズを記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 아직 부족합니다. TidyByte는 앱을 열 때 하루 한 번 크기를 기록합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据还不够。你每次打开 App 时，TidyByte 会每天记录一次大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно данных. TidyByte записывает размер раз в день при открытии приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات كافية بعد. يسجّل TidyByte الحجم مرة يوميًا عند فتح التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מספיק נתונים. TidyByte רושם את הגודל פעם ביום כשאתה פותח את האפליקציה."
          }
        }
      }
    },
    "Not in Any User Album": {
      "localizations": {
        "en": {
          "stringUnit": {
