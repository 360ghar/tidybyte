    "See storage used and how much you can clean up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See storage used and how much you can clean up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कितनी स्टोरेज इस्तेमाल हुई है और कितना साफ़ कर सकते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কত স্টোরেজ ব্যবহৃত হয়েছে এবং কত পরিষ্কার করা যায় দেখুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எவ்வளவு சேமிப்பகம் பயன்படுத்தப்பட்டுள்ளது, எவ்வளவு சுத்தம் செய்யலாம் என்பதைப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంత నిల్వ వాడబడిందో, ఎంత శుభ్రం చేయగలరో చూడండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वापरलेले स्टोरेज आणि तुम्ही किती स्वच्छ करू शकता ते पहा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વપરાયેલું સ્ટોરેજ અને તમે કેટલું સાફ કરી શકો તે જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಳಸಿದ ಸಂಗ್ರಹಣೆ ಮತ್ತು ಎಷ್ಟು ಸ್ವಚ್ಛಗೊಳಿಸಬಹುದು ಎಂದು ನೋಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപയോഗിച്ച സ്റ്റോറേജും എത്ര ക്ലീൻ ചെയ്യാനാകും എന്നതും കാണുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਰਤੀ ਗਈ ਸਟੋਰੇਜ ਅਤੇ ਕਿੰਨੀ ਸਫ਼ਾਈ ਕਰ ਸਕਦੇ ਹੋ, ਵੇਖੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el almacenamiento usado y cuánto puedes limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez le stockage utilisé et ce que vous pouvez nettoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh den belegten Speicher und wie viel du bereinigen kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o armazenamento usado e quanto você pode limpar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi lo spazio usato e quanto puoi pulire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のストレージと削減できる容量を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 저장 공간과 정리할 수 있는 공간을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已用的存储空间以及可以清理多少。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите занятое место и сколько можно очистить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على المساحة المستخدمة وكم يمكنك تنظيفه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראה כמה אחסון בשימוש וכמה ניתן לנקות."
          }
        }
      }
    },
