    "Keep All Items": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep All Items"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी आइटम रखें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব আইটেম রাখুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா உருப்படிகளையும் வைத்திரு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని అంశాలను ఉంచు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व आयटम ठेवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધા આઇટમ રાખો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಐಟಂಗಳನ್ನು ಇರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഇനങ്ങളും നിലനിർത്തുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਆਈਟਮਾਂ ਰੱਖੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar todos los elementos"
