    "Automatic follows your device. TidyByte changes immediately; some iOS dialogs follow on the next launch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows your device. TidyByte changes immediately; some iOS dialogs follow on the next launch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित आपके डिवाइस का अनुसरण करता है. TidyByte तुरंत बदल जाता है; कुछ iOS डायलॉग अगली बार खोलने पर बदलते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় আপনার ডিভাইস অনুসরণ করে. TidyByte সঙ্গে সঙ্গে বদলায়; কিছু iOS ডায়ালগ পরের বার খোলার সময় বদলায়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கி உங்கள் சாதனத்தைப் பின்பற்றும். TidyByte உடனே மாறும்; சில iOS உரையாடல்கள் அடுத்த முறை திறக்கும்போது மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆటోమేటిక్ మీ పరికరాన్ని అనుసరిస్తుంది. TidyByte వెంటనే మారుతుంది; కొన్ని iOS డైలాగ్లు తదుపరిసారి తెరిచినప్పుడు మారుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंचलित तुमच्या डिव्हाइसचे अनुसरण करते. TidyByte लगेच बदलतो; काही iOS डायलॉग पुढील लॉन्चवर बदलतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વચાલિત તમારા ડિવાઇસને અનુસરે છે. TidyByte તરત બદલાય છે; કેટલાક iOS ડાયલોગ આગળના લૉન્ચ પર બદલાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂಚಾಲಿತ ನಿಮ್ಮ ಸಾಧನವನ್ನು ಅನುಸರಿಸುತ್ತದೆ. TidyByte ತಕ್ಷಣ ಬದಲಾಗುತ್ತದೆ; ಕೆಲವು iOS ಡಯಲಾಗ್ಗಳು ಮುಂದಿನ ಬಾರಿ ಆ್ಯಪ್ ತೆರೆದಾಗ ಬದಲಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവ നിങ്ങളുടെ ഉപകരണത്തെ പിന്തുടരുന്നു. TidyByte ഉടൻ മാറും; ചില iOS ഡയലോഗുകൾ അടുത്ത തവണ തുറക്കുമ്പോൾ മാറും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਟੋਮੈਟਿਕ ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਦੀ ਪਾਲਣਾ ਕਰਦਾ ਹੈ. TidyByte ਵਿੱਚ ਬਦਲਾਅ ਤੁਰੰਤ ਲਾਗੂ ਹੁੰਦੇ ਹਨ; ਕੁਝ iOS ਡਾਇਲਾਗ ਅਗਲੀ ਵਾਰ ਖੋਲ੍ਹਣ ਉੱਤੇ ਬਦਲਦੇ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sigue tu dispositivo. Los cambios de TidyByte se aplican al instante; algunos cuadros de diálogo de iOS se actualizan en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique suit votre appareil. Les changements de TidyByte sont immédiats ; certaines boîtes de dialogue iOS se mettent à jour au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch folgt deinem Gerät. Änderungen in TidyByte wirken sofort; einige iOS-Dialoge folgen beim nächsten Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático segue seu dispositivo. O TidyByte muda imediatamente; alguns diálogos do iOS seguem na próxima abertura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico segue il dispositivo. TidyByte cambia subito; alcune finestre di iOS seguono al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動はデバイスの設定に従います。TidyByteはすぐに切り替わりますが、一部のiOSダイアログは次回起動時に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 기기 설정을 따릅니다. TidyByte는 즉시 바뀌지만 일부 iOS 대화상자는 다음 실행 때 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”跟随你的设备设置。TidyByte 会立即更改；部分 iOS 对话框会在下次启动时跟随。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматически» следует настройкам устройства. TidyByte меняется сразу; некоторые диалоги iOS — при следующем запуске."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع «تلقائي» إعدادات جهازك. يتغير TidyByte فورًا؛ وتتبع بعض نوافذ iOS عند التشغيل التالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפשרות \"אוטומטי\" עוקבת אחר המכשיר שלך. TidyByte משתנה מיד; חלק מחלונות iOS ישתנו בהפעלה הבאה."
          }
        }
      }
    },
