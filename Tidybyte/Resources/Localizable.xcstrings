    "Couldn't download this photo from iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't download this photo from iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो iCloud से डाउनलोड नहीं हो सकी."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটো iCloud থেকে ডাউনলোড করা যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை iCloud-இல் இருந்து பதிவிறக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను iCloud నుండి డౌన్లోడ్ చేయలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो iCloud मधून डाउनलोड करता आला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો iCloud માંથી ડાઉનલોડ કરી શકાયો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋವನ್ನು iCloud ನಿಂದ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ iCloud-ൽ നിന്ന് ഡൗൺലോഡ് ചെയ്യാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ੋਟੋ iCloud ਤੋਂ ਡਾਊਨਲੋਡ ਨਹੀਂ ਹੋ ਸਕੀ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar esta foto de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger cette photo depuis iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht aus iCloud heruntergeladen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar esta foto do iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare questa foto da iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからこの写真をダウンロードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 이 사진을 다운로드하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 iCloud 下载这张照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скачать это фото из iCloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تنزيل هذه الصورة من iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להוריד את התמונה הזו מ-iCloud."
          }
        }
      }
    },
    "Couldn't download this video from iCloud.": {
