        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene una luminosidad muy alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a une luminosité très élevée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist sehr hell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem brilho muito alto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha una luminosità molto alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は明るさが非常に高いです。"
