    "Screenshots and large files add up. Take a few minutes to review them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots and large files add up. Take a few minutes to review them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट और बड़ी फ़ाइलें जुड़ती जाती हैं. इनकी समीक्षा में कुछ मिनट लगाएँ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশট ও বড় ফাইল জমতে থাকে. এগুলি দেখতে কয়েক মিনিট দিন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கிரீன்ஷாட்களும் பெரிய கோப்புகளும் கூடிக்கொண்டே போகும். அவற்றைப் பார்க்க சில நிமிடங்கள் செலவிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్షాట్లు మరియు పెద్ద ఫైళ్లు పోగవుతాయి. వాటిని సమీక్షించడానికి కొన్ని నిమిషాలు కేటాయించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट आणि मोठ्या फाइल्सची बेरीज होते. त्यांचे पुनरावलोकन करण्यासाठी काही मिनिटे द्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીનશોટ અને મોટી ફાઇલો ભેગી થાય છે. તેમની સમીક્ષા કરવા થોડી મિનિટો ફાળવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ರೀನ್ಶಾಟ್ಗಳು ಮತ್ತು ದೊಡ್ಡ ಫೈಲ್ಗಳು ಸೇರಿಕೊಳ್ಳುತ್ತವೆ. ಅವನ್ನು ಪರಿಶೀಲಿಸಲು ಕೆಲವು ನಿಮಿಷಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ക്രീൻഷോട്ടുകളും വലിയ ഫയലുകളും കൂടിച്ചേരുന്നു. അവ പരിശോധിക്കാൻ കുറച്ച് മിനിറ്റ് എടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕਰੀਨਸ਼ਾਟ ਅਤੇ ਵੱਡੀਆਂ ਫ਼ਾਈਲਾਂ ਜੁੜਦੀਆਂ ਜਾਂਦੀਆਂ ਹਨ. ਇਨ੍ਹਾਂ ਦੀ ਸਮੀਖਿਆ ਲਈ ਕੁਝ ਮਿੰਟ ਕੱਢੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla y los archivos grandes se acumulan. Dedica unos minutos a revisarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d'écran et les fichiers volumineux s'accumulent. Prenez quelques minutes pour les examiner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots und große Dateien summieren sich. Nimm dir ein paar Minuten, um sie zu prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas de tela e arquivos grandes se acumulam. Reserve alguns minutos para revisá-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Istantanee e file di grandi dimensioni si accumulano. Prenditi qualche minuto per esaminarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットと大きいファイルはたまります。数分で確認してみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷과 대용량 파일은 쌓이기 마련입니다. 몇 분만 투자해 검토해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截屏和大文件会占不少空间。花几分钟查看一下吧。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты и большие файлы накапливаются. Уделите пару минут их просмотру."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتراكم لقطات الشاشة والملفات الكبيرة. خصص بضع دقائق لمراجعتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילומי מסך וקבצים גדולים מצטברים. הקדש כמה דקות כדי לסקור אותם."
          }
        }
      }
    },
