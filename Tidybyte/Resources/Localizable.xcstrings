    "Pinch or double-tap a photo to inspect it": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch or double-tap a photo to inspect it"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो देखने के लिए उसे पिंच करें या डबल-टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো দেখতে পিঞ্চ করুন বা ডাবল-ট্যাপ করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்தை உற்றுப் பார்க்க இரு விரல்களால் பெரிதாக்கவும் அல்லது இருமுறை தட்டவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోను పరిశీలించడానికి పిన్చ్ చేయండి లేదా రెండుసార్లు నొక్కండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो निरखण्यासाठी पिंच करा किंवा दोनदा टॅप करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો નજીકથી જોવા પિંચ કરો અથવા બે વાર ટૅપ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋವನ್ನು ಪರಿಶೀಲಿಸಲು ಪಿಂಚ್ ಮಾಡಿ ಅಥವಾ ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ പരിശോധിക്കാൻ പിഞ്ച് ചെയ്യുക അല്ലെങ്കിൽ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਨੂੰ ਧਿਆਨ ਨਾਲ ਵੇਖਣ ਲਈ ਪਿੰਚ ਕਰੋ ਜਾਂ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca o toca dos veces una foto para inspeccionarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez ou touchez deux fois une photo pour l'inspecter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe zwei Finger auseinander oder tippe doppelt auf ein Foto, um es genauer anzusehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça ou toque duas vezes em uma foto para inspecioná-la"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica o tocca due volte una foto per esaminarla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をピンチまたはダブルタップすると、拡大して確認できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 핀치하거나 두 번 탭하면 자세히 볼 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合或轻点两下照片可放大查看"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведите пальцы или дважды коснитесь фото, чтобы рассмотреть его"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط بإصبعين أو انقر نقرًا مزدوجًا على أي صورة لفحصها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צבוט או הקש פעמיים על תמונה כדי לבדוק אותה"
          }
        }
      }
    },
