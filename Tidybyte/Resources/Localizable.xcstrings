    "Re-encode photos to save space": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-encode photos to save space"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह बचाने के लिए फ़ोटो फिर से एनकोड करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জায়গা বাঁচাতে ফটো আবার এনকোড করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடத்தைச் சேமிக்க புகைப்படங்களை மீண்டும் என்கோட் செய்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థలం ఆదా చేయడానికి ఫోటోలను మళ్లీ ఎన్కోడ్ చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जागा वाचवण्यासाठी फोटो पुन्हा एन्कोड करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જગ્યા બચાવવા ફોટા ફરી એન્કોડ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜಾಗ ಉಳಿಸಲು ಫೋಟೋಗಳನ್ನು ಮರು-ಎನ್ಕೋಡ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥലം ലാഭിക്കാൻ ഫോട്ടോകൾ വീണ്ടും എൻകോഡ് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਥਾਂ ਬਚਾਉਣ ਲਈ ਫ਼ੋਟੋਆਂ ਦੁਬਾਰਾ ਐਨਕੋਡ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a codificar las fotos para liberar espacio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réencodez les photos pour libérer de l'espace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodiere Fotos neu, um Speicherplatz zu sparen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recodifique fotos para liberar espaço"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricodifica le foto per risparmiare spazio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を再エンコードして容量を節約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 다시 인코딩해 공간 절약"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新编码照片以节省空间"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекодируйте фото, чтобы освободить место"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد ترميز الصور لتوفير المساحة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודד מחדש תמונות כדי לפנות מקום"
          }
        }
      }
    },
    "Re-encode to HEIC, full resolution": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-encode to HEIC, full resolution"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC में फिर से एनकोड करें, पूर्ण रिज़ॉल्यूशन"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC-এ আবার এনকোড করুন, পূর্ণ রেজোলিউশন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC-ஆக மீண்டும் என்கோட் செய், முழு தெளிவுத்திறன்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "HEICగా మళ్లీ ఎన్కోడ్ చేయండి, పూర్తి రిజల్యూషన్"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC मध्ये पुन्हा एन्कोड करा, पूर्ण रिझोल्यूशन"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC માં ફરી એન્કોડ કરો, પૂર્ણ રિઝોલ્યુશન"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC ಗೆ ಮರು-ಎನ್ಕೋಡ್ ಮಾಡಿ, ಪೂರ್ಣ ರೆಸಲ್ಯೂಶನ್"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC-ലേക്ക് വീണ്ടും എൻകോഡ് ചെയ്യുക, പൂർണ റെസല്യൂഷൻ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC ਵਿੱਚ ਦੁਬਾਰਾ ਐਨਕੋਡ ਕਰੋ, ਪੂਰੀ ਰੈਜ਼ੋਲਿਊਸ਼ਨ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a codificar en HEIC, resolución completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réencoder en HEIC, pleine résolution"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In HEIC neu kodieren, volle Auflösung"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recodificar em HEIC, resolução total"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricodifica in HEIC, risoluzione piena"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEICで再エンコード、フル解像度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC로 다시 인코딩, 최대 해상도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新编码为 HEIC，全分辨率"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекодировать в HEIC, полное разрешение"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الترميز إلى HEIC بدقة كاملة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודד מחדש ל-HEIC, ברזולוציה מלאה"
          }
        }
      }
    },
