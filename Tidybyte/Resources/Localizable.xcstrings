    },
    "Your library looks tidy. Nothing obvious to clean up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library looks tidy. Nothing obvious to clean up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी साफ़-सुथरी लगती है. साफ़ करने के लिए कुछ स्पष्ट नहीं है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি গোছানো দেখাচ্ছে. পরিষ্কার করার মতো স্পষ্ট কিছু নেই."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகம் ஒழுங்காகத் தெரிகிறது. சுத்தம் செய்ய தெளிவாக எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీ చక్కగా ఉంది. శుభ్రం చేయడానికి స్పష్టంగా ఏమీ లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची लायब्ररी नीटनेटकी दिसते. स्वच्छ करण्यासारखे स्पष्ट काही नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરી વ્યવસ્થિત લાગે છે. સાફ કરવા જેવું સ્પષ્ટ કંઈ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿ ಚೊಕ್ಕವಾಗಿದೆ. ಸ್ವಚ್ಛಗೊಳಿಸಲು ಸ್ಪಷ್ಟವಾದದ್ದು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി വൃത്തിയായി കാണുന്നു. ക്ലീൻ ചെയ്യാൻ വ്യക്തമായി ഒന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਸਾਫ਼-ਸੁਥਰੀ ਲੱਗਦੀ ਹੈ. ਸਾਫ਼ ਕਰਨ ਲਈ ਕੁਝ ਸਪਸ਼ਟ ਨਹੀਂ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca se ve ordenada. No hay nada evidente que limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque semble bien rangée. Rien d'évident à nettoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek sieht aufgeräumt aus. Nichts Offensichtliches zu bereinigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca está organizada. Nada óbvio para limpar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è in ordine. Niente di evidente da pulire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリはきれいです。明らかに整理が必要なものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함이 깔끔합니다. 눈에 띄게 정리할 항목이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的图库看起来很整洁，没有明显需要清理的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша медиатека выглядит опрятно. Очевидного для очистки нет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو مكتبتك مرتبة. لا شيء واضح لتنظيفه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלך נראית מסודרת. אין משהו בולט לניקוי."
          }
        }
      }
    },
    "Your new copies are saved. Nothing was lost. Try again to delete the originals and free space, or remove the new copies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new copies are saved. Nothing was lost. Try again to delete the originals and free space, or remove the new copies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी नई कॉपियाँ सहेजी गई हैं. कुछ नहीं खोया. मूल फ़ाइलें हटाकर जगह खाली करने के लिए फिर से प्रयास करें, या नई कॉपियाँ हटाएँ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নতুন কপি সেভ হয়েছে. কিছুই হারায়নি. মূল ফাইল মুছে জায়গা খালি করতে আবার চেষ্টা করুন, বা নতুন কপি সরান."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புதிய நகல்கள் சேமிக்கப்பட்டன. எதுவும் இழக்கப்படவில்லை. மூலங்களை நீக்கி இடத்தைக் காலி செய்ய மீண்டும் முயற்சிக்கவும், அல்லது புதிய நகல்களை அகற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొత్త కాపీలు సేవ్ అయ్యాయి. ఏమీ పోలేదు. అసలైనవి తొలగించి స్థలం ఖాళీ చేయడానికి మళ్లీ ప్రయత్నించండి, లేదా కొత్త కాపీలను తీసివేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या नवीन प्रती सेव्ह झाल्या आहेत. काहीही हरवले नाही. मूळ प्रती हटवून जागा मोकळी करण्यासाठी पुन्हा प्रयत्न करा, किंवा नवीन प्रती काढा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી નવી કૉપી સાચવી લેવાઈ છે. કંઈ ગુમાવ્યું નથી. મૂળ કાઢી નાખી જગ્યા ખાલી કરવા ફરી પ્રયાસ કરો, અથવા નવી કૉપી દૂર કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೊಸ ಪ್ರತಿಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ. ಏನೂ ಕಳೆದುಹೋಗಿಲ್ಲ. ಮೂಲಗಳನ್ನು ಅಳಿಸಿ ಜಾಗ ಖಾಲಿ ಮಾಡಲು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಹೊಸ ಪ್ರತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പുതിയ പകർപ്പുകൾ സേവ് ചെയ്തു. ഒന്നും നഷ്ടപ്പെട്ടിട്ടില്ല. ഒറിജിനലുകൾ ഇല്ലാതാക്കി സ്ഥലം ഒഴിവാക്കാൻ വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ പുതിയ പകർപ്പുകൾ നീക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਨਵੀਆਂ ਕਾਪੀਆਂ ਸੇਵ ਹੋ ਗਈਆਂ ਹਨ. ਕੁਝ ਵੀ ਨਹੀਂ ਗੁਆਇਆ. ਅਸਲੀ ਫ਼ਾਈਲਾਂ ਮਿਟਾਉਣ ਅਤੇ ਥਾਂ ਖਾਲੀ ਕਰਨ ਲਈ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਨਵੀਆਂ ਕਾਪੀਆਂ ਹਟਾਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus nuevas copias están guardadas. No se perdió nada. Inténtalo de nuevo para eliminar los originales y liberar espacio, o elimina las nuevas copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos nouvelles copies sont enregistrées. Rien n'a été perdu. Réessayez pour supprimer les originaux et libérer de l'espace, ou supprimez les nouvelles copies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neuen Kopien sind gesichert. Es ging nichts verloren. Versuche erneut, die Originale zu löschen und Speicher freizugeben, oder entferne die neuen Kopien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas novas cópias foram salvas. Nada foi perdido. Tente novamente para apagar os originais e liberar espaço, ou remova as novas cópias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove copie sono salvate. Niente è andato perso. Riprova per eliminare gli originali e liberare spazio, oppure rimuovi le nuove copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコピーを保存しました。失われたものはありません。もう一度お試しいただくと元のファイルを削除して容量を空けられます。新しいコピーを削除することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 복사본을 저장했습니다. 손실된 항목은 없습니다. 다시 시도해 원본을 삭제하고 공간을 확보하거나 새 복사본을 제거하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新副本已保存，未丢失任何内容。可重试以删除原片并释放空间，或移除新副本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые копии сохранены. Ничего не потеряно. Повторите, чтобы удалить оригиналы и освободить место, или удалите новые копии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ نسخك الجديدة ولم يُفقد شيء. حاول مرة أخرى لحذف الأصول وتحرير المساحة، أو أزل النسخ الجديدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותקים החדשים נשמרו. דבר לא אבד. נסה שוב כדי למחוק את המקוריים ולפנות מקום, או הסר את העותקים החדשים."
          }
        }
      }
    },
    "Your photo library is clean!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo library is clean!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो लाइब्रेरी साफ़ है!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো লাইব্রেরি পরিষ্কার!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்பட நூலகம் சுத்தமாக உள்ளது!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటో లైబ్రరీ శుభ్రంగా ఉంది!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची फोटो लायब्ररी स्वच्छ आहे!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ફોટો લાઇબ્રેરી સ્વચ્છ છે!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋ ಲೈಬ್ರರಿ ಸ್ವಚ್ಛವಾಗಿದೆ!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോ ലൈബ്രറി വൃത്തിയാണ്!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਫ਼ੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਸਾਫ਼ ਹੈ!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu fototeca está limpia!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque est propre !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotomediathek ist sauber!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca de fotos está limpa!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è pulita!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリはきれいです！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함이 깨끗합니다!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片图库很干净！"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша медиатека чиста!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتبة صورك نظيفة!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספריית התמונות שלך נקייה!"
          }
        }
      }
    },
    "Your photos are untouched and were never uploaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos are untouched and were never uploaded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो अछूती हैं और कभी अपलोड नहीं की गईं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো অপরিবর্তিত এবং কখনও আপলোড করা হয়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்கள் தொடப்படவில்லை, ஒருபோதும் பதிவேற்றப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు తాకబడలేదు, ఎప్పుడూ అప్లోడ్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे फोटो अजिबात बदललेले नाहीत आणि कधीही अपलोड केलेले नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટા અસ્પૃશ્ય રહ્યા છે અને ક્યારેય અપલોડ થયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು ಬದಲಾಗಿಲ್ಲ ಮತ್ತು ಎಂದಿಗೂ ಅಪ್ಲೋಡ್ ಆಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ മാറ്റമില്ലാതെയാണ്, ഒരിക്കലും അപ്ലോഡ് ചെയ്തിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਬਿਨਾਂ ਬਦਲਾਅ ਦੇ ਹਨ ਅਤੇ ਕਦੇ ਅੱਪਲੋਡ ਨਹੀਂ ਹੋਈਆਂ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos están intactas y nunca se subieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos sont intactes et n'ont jamais été envoyées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos sind unverändert und wurden nie hochgeladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos não foram alteradas nem enviadas para lugar nenhum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto sono intatte e non sono mai state caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は変更されておらず、アップロードもされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 변경되지 않았고 업로드된 적도 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片未被改动，也从未上传。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фото не изменялись и никогда не загружались."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورك لم تُمس ولم تُرفع أبدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות שלך לא נגעו ולא הועלו מעולם."
          }
        }
      }
    },
    "Your rating helps other people find TidyByte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rating helps other people find TidyByte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रेटिंग से दूसरों को TidyByte ढूँढने में मदद मिलती है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রেটিং অন্য মানুষকে TidyByte খুঁজে পেতে সাহায্য করে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மதிப்பீடு மற்றவர்கள் TidyByte-ஐக் கண்டறிய உதவுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రేటింగ్ ఇతరులు TidyByteను కనుగొనడంలో సహాయపడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची रेटिंग इतरांना TidyByte शोधण्यात मदत करते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું રેટિંગ બીજાને TidyByte શોધવામાં મદદ કરે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ರೇಟಿಂಗ್ ಇತರರಿಗೆ TidyByte ಹುಡುಕಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റേറ്റിംഗ് മറ്റുള്ളവരെ TidyByte കണ്ടെത്താൻ സഹായിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਰੇਟਿੰਗ ਹੋਰਾਂ ਨੂੰ TidyByte ਲੱਭਣ ਵਿੱਚ ਮਦਦ ਕਰਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu valoración ayuda a que otras personas encuentren TidyByte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre note aide d'autres personnes à trouver TidyByte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bewertung hilft anderen, TidyByte zu finden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua avaliação ajuda outras pessoas a encontrar o TidyByte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua valutazione aiuta altre persone a trovare TidyByte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価していただくと、他の人がTidyByteを見つけやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평가를 남겨 주시면 다른 사람들이 TidyByte를 찾는 데 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的评分能帮助更多人发现 TidyByte。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша оценка помогает другим найти TidyByte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقييمك يساعد الآخرين على اكتشاف TidyByte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדירוג שלך עוזר לאחרים למצוא את TidyByte."
          }
        }
      }
    },
