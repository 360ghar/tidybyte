            "value": "La tua libreria sembra pulita!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリはきれいです！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
