    "Up to %@ to free on iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %@ to free on iPhone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर %@ तक खाली करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ %@ পর্যন্ত খালি করা যায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-இல் %@ வரை காலி செய்யலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneలో ఖాళీ చేయడానికి %@ వరకు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
