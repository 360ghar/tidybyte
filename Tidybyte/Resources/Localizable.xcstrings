    "the still image of each Live Photo as a new photo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the still image of each Live Photo as a new photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर Live Photo की स्थिर छवि को नई फ़ोटो के रूप में"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি Live Photo-এর স্থির ছবি নতুন ফটো হিসেবে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு Live Photo-இன் நிலைப்படத்தைப் புதிய புகைப்படமாக"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి Live Photo యొక్క స్థిర చిత్రాన్ని కొత్త ఫోటోగా"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक Live Photo ची स्थिर प्रत नवीन फोटो म्हणून"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક Live Photo ની સ્થિર ઇમેજ નવા ફોટા તરીકે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ Live Photo ನ ಸ್ಟಿಲ್ ಚಿತ್ರವನ್ನು ಹೊಸ ಫೋಟೋ ಆಗಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ Live Photo-യുടെയും സ്റ്റിൽ ഇമേജ് പുതിയ ഫോട്ടോ ആയി"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ Live Photo ਦੀ ਸਥਿਰ ਤਸਵੀਰ ਨਵੀਂ ਫ਼ੋਟੋ ਵਜੋਂ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la foto fija de cada Live Photo como una foto nueva"
          }
        },
        "fr": {
          "stringUnit": {
