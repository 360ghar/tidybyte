    "Scans your library and sorts photos by what's in them": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your library and sorts photos by what's in them"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी स्कैन करता है और फ़ोटो को उनकी सामग्री के अनुसार क्रमबद्ध करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি স্ক্যান করে এবং ফটোতে যা আছে তা অনুযায়ী সাজায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தை ஸ்கேன் செய்து, புகைப்படங்களில் இருப்பதைப் பொறுத்து வரிசைப்படுத்தும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీని స్కాన్ చేసి, ఫోటోలలో ఏమి ఉందో దాని ప్రకారం క్రమబద్ధీకరిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या लायब्ररीचे स्कॅन करते आणि फोटोमध्ये काय आहे त्यानुसार क्रमवारी लावते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરી સ્કેન કરે છે અને ફોટામાં શું છે તે પ્રમાણે ગોઠવે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ, ಫೋಟೋಗಳಲ್ಲಿ ಏನಿದೆ ಎಂಬುದರ ಆಧಾರದಲ್ಲಿ ವಿಂಗಡಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്ത് ഫോട്ടോകളിൽ എന്തുണ്ടെന്നതിന്റെ അടിസ്ഥാനത്തിൽ ക്രമീകരിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰਦੀ ਹੈ ਅਤੇ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਕੀ ਹੈ ਉਸ ਅਨੁਸਾਰ ਲੜੀਬੱਧ ਕਰਦੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu fototeca y ordena las fotos según su contenido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse votre photothèque et trie les photos selon leur contenu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht deine Mediathek und sortiert Fotos nach ihrem Inhalt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa a biblioteca e ordena as fotos pelo conteúdo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la libreria e ordina le foto in base al contenuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリをスキャンし、写真を内容ごとに分類します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함을 스캔하고 사진의 내용에 따라 분류합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描图库并根据照片内容分类"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует медиатеку и сортирует фото по их содержимому"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص مكتبتك ويرتب الصور حسب محتواها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סורק את הספרייה ומסדר תמונות לפי מה שמופיע בהן"
          }
        }
      }
    },
    "Scans your library for out-of-focus and poorly lit photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your library for out-of-focus and poorly lit photos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस से बाहर और कम रोशनी वाली फ़ोटो के लिए आपकी लाइब्रेरी स्कैन करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোকাসের বাইরে ও কম আলোর ফটোর জন্য আপনার লাইব্রেরি স্ক্যান করে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கவனம் விலகிய மற்றும் குறைந்த வெளிச்சமுள்ள புகைப்படங்களுக்காக உங்கள் நூலகத்தை ஸ்கேன் செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోకస్ లేని మరియు సరిగా వెలుతురు లేని ఫోటోల కోసం మీ లైబ్రరీని స్కాన్ చేస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोकसबाहेर आणि कमी प्रकाशातील फोटो शोधण्यासाठी तुमच्या लायब्ररीचे स्कॅन करते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોકસ બહાર અને ઓછા પ્રકાશવાળા ફોટા માટે તમારી લાઇબ્રેરી સ્કેન કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಕಸ್ ಇಲ್ಲದ ಮತ್ತು ಸರಿಯಾದ ಬೆಳಕಿಲ್ಲದ ಫೋಟೋಗಳಿಗಾಗಿ ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോക്കസ് ഇല്ലാത്തതും വെളിച്ചം കുറഞ്ഞതുമായ ഫോട്ടോകൾക്കായി നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਧੁੰਦਲੀਆਂ ਅਤੇ ਘੱਟ ਰੌਸ਼ਨੀ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ ਲਈ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰਦੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu fototeca en busca de fotos desenfocadas y con poca luz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
