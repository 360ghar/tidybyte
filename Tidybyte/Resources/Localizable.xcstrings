    "Couldn't prepare the selected items to share.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't prepare the selected items to share."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित आइटम शेयर करने के लिए तैयार नहीं हो सके."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত আইটেমগুলি শেয়ার করার জন্য তৈরি করা যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த உருப்படிகளைப் பகிரத் தயார் செய்ய முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న అంశాలను షేర్ చేయడానికి సిద్ధం చేయలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेले आयटम शेअर करण्यासाठी तयार करता आले नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલા આઇટમ શેર કરવા તૈયાર કરી શકાયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಐಟಂಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಸಿದ್ಧಪಡಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഇനങ്ങൾ പങ്കിടാൻ തയ്യാറാക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀਆਂ ਆਈਟਮਾਂ ਸਾਂਝੀਆਂ ਕਰਨ ਲਈ ਤਿਆਰ ਨਹੀਂ ਕਰ ਸਕੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los elementos seleccionados para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer les éléments sélectionnés pour le partage."
          }
        },
        "de": {
