    "All processing happens on your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All processing happens on your device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारी प्रोसेसिंग आपके डिवाइस पर होती है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব প্রক্রিয়াকরণ আপনার ডিভাইসেই হয়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா செயலாக்கமும் உங்கள் சாதனத்திலேயே நடக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం ప్రాసెసింగ్ మీ పరికరంలోనే జరుగుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व प्रक्रिया तुमच्या डिव्हाइसवर होते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી પ્રક્રિયા તમારા ડિવાઇસ પર થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಪ್ರಕ್ರಿಯೆ ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ನಡೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ പ്രോസസ്സിംഗും നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ നടക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀ ਪ੍ਰੋਸੈਸਿੰਗ ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਉੱਤੇ ਹੁੰਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el procesamiento ocurre en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le traitement se fait sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Verarbeitung erfolgt auf deinem Gerät."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o processamento acontece no seu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'elaborazione avviene sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理はすべてデバイス上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 기기에서 이루어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
