          "stringUnit": {
            "state": "translated",
            "value": "ವೀಡಿಯೊ ಗಾತ್ರ ತಿಳಿದಿಲ್ಲ (iCloud-ಮಾತ್ರ) — ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീഡിയോ വലിപ്പം അറിയില്ല (iCloud-ഒൺലി) — ഒഴിവാക്കി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੀਡੀਓ ਦਾ ਆਕਾਰ ਅਣਜਾਣ (ਸਿਰਫ਼ iCloud ਵਿੱਚ) — ਛੱਡਿਆ ਗਿਆ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del vídeo desconocido (solo en iCloud) — omitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la vidéo inconnue (iCloud uniquement) — ignorée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videogröße unbekannt (nur in iCloud) — übersprungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do vídeo desconhecido (apenas no iCloud) — ignorado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del video sconosciuta (solo iCloud) — saltato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオのサイズが不明（iCloudのみ）— スキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 크기를 알 수 없음(iCloud에만) — 건너뜀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频大小未知（仅限 iCloud）— 已跳过。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер видео неизвестен (только в iCloud) — пропущено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الفيديو غير معروف (iCloud فقط) — تم التخطي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל הסרטון אינו ידוע (iCloud בלבד) — דולג."
          }
        }
      }
    },
