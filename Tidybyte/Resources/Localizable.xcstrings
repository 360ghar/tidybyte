        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿ ಸ್ವಚ್ಛವಾಗಿದೆ!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി വൃത്തിയാണ്!"
