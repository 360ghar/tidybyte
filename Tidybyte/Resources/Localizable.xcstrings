    "Every photo and video in your library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every photo and video in your library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी की हर फ़ोटो और वीडियो"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরির প্রতিটি ফটো ও ভিডিও"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தில் உள்ள ஒவ்வொரு புகைப்படமும் வீடியோவும்"
          }
        },
        "te": {
