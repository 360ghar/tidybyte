          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या श्रेणीत फोटो नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ શ્રેણીમાં ફોટા નથી."
