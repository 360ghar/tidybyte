    "Adds this photo to the delete list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds this photo to the delete list"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को हटाने की सूची में जोड़ता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি মুছে ফেলার তালিকায় যোগ করে"
          }
        },
        "ta": {
