    "Ends the session and reviews your changes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the session and reviews your changes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन समाप्त करता है और आपके बदलावों की समीक्षा करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেশন শেষ করে আপনার পরিবর্তনগুলি দেখায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமர்வை முடித்து உங்கள் மாற்றங்களைப் பார்க்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెషన్ను ముగించి మీ మార్పులను సమీక్షిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र संपवते आणि तुमचे बदल तपासते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સત્ર સમાપ્ત કરે છે અને તમારા ફેરફારોની સમીક્ષા કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಷನ್ ಕೊನೆಗೊಳಿಸಿ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെഷൻ അവസാനിപ്പിച്ച് നിങ്ങളുടെ മാറ്റങ്ങൾ പരിശോധിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਸ਼ਨ ਸਮਾਪਤ ਕਰਦਾ ਹੈ ਅਤੇ ਤੁਹਾਡੇ ਬਦਲਾਅ ਦੀ ਸਮੀਖਿਆ ਕਰਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza la sesión y revisa tus cambios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine la session et examine vos changements"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die Sitzung und prüft deine Änderungen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a sessão e revisa suas alterações"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la sessione ed esamina le modifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを終了して変更内容を確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 종료하고 변경 사항을 검토합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束会话并查看你的更改"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает сеанс и показывает ваши изменения"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي الجلسة ويراجع تغييراتك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיים את ההפעלה ומציג את השינויים שלך"
          }
        }
      }
    },
