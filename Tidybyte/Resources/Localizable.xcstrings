    "Your device language is not translated yet, so TidyByte is using English. Pick a language above to override.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device language is not translated yet, so TidyByte is using English. Pick a language above to override."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस की भाषा अभी अनुवादित नहीं है, इसलिए TidyByte अंग्रेज़ी इस्तेमाल कर रहा है. बदलने के लिए ऊपर से भाषा चुनें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডিভাইসের ভাষা এখনও অনূদিত নয়, তাই TidyByte ইংরেজি ব্যবহার করছে. বদলাতে উপরে থেকে একটি ভাষা বেছে নিন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதன மொழி இன்னும் மொழிபெயர்க்கப்படவில்லை, எனவே TidyByte ஆங்கிலத்தைப் பயன்படுத்துகிறது. மாற்ற மேலே ஒரு மொழியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పరికర భాష ఇంకా అనువదించబడలేదు, కాబట్టి TidyByte ఇంగ్లిష్ వాడుతోంది. మార్చడానికి పైన ఒక భాషను ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या डिव्हाइसची भाषा अजून भाषांतरित केलेली नाही, म्हणून TidyByte इंग्रजी वापरत आहे. बदलण्यासाठी वर भाषा निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ડિવાઇસની ભાષાનું હજી ભાષાંતર થયું નથી, તેથી TidyByte અંગ્રેજી વાપરે છે. બદલવા ઉપર ભાષા પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಾಧನದ ಭಾಷೆ ಇನ್ನೂ ಅನುವಾದವಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ TidyByte ಇಂಗ್ಲಿಷ್ ಬಳಸುತ್ತಿದೆ. ಬದಲಾಯಿಸಲು ಮೇಲೆ ಭಾಷೆ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഉപകരണ ഭാഷ ഇതുവരെ വിവർത്തനം ചെയ്തിട്ടില്ല, അതിനാൽ TidyByte ഇംഗ്ലീഷ് ഉപയോഗിക്കുന്നു. മാറ്റാൻ മുകളിൽ ഭാഷ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਦੀ ਭਾਸ਼ਾ ਦਾ ਅਨੁਵਾਦ ਹਾਲੇ ਨਹੀਂ ਹੋਇਆ, ਇਸ ਲਈ TidyByte ਅੰਗਰੇਜ਼ੀ ਵਰਤ ਰਿਹਾ ਹੈ. ਬਦਲਣ ਲਈ ਉੱਪਰ ਇੱਕ ਭਾਸ਼ਾ ਚੁਣੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de tu dispositivo aún no está traducido, así que TidyByte usa inglés. Elige un idioma arriba para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de votre appareil n'est pas encore traduite, TidyByte utilise donc l'anglais. Choisissez une langue ci-dessus pour la remplacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache deines Geräts ist noch nicht übersetzt, daher verwendet TidyByte Englisch. Wähle oben eine Sprache, um sie zu ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do seu dispositivo ainda não foi traduzido, então o TidyByte está usando inglês. Escolha um idioma acima para substituí-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua del dispositivo non è ancora tradotta, quindi TidyByte usa l'inglese. Scegli una lingua qui sopra per sostituirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの言語はまだ翻訳されていないため、TidyByteは英語を使用しています。上の言語を選ぶと変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 언어가 아직 번역되지 않아 TidyByte가 영어를 사용합니다. 위에서 언어를 선택해 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备语言尚未翻译，因此 TidyByte 使用英语。可在上方选择语言来覆盖。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык вашего устройства пока не переведен, поэтому TidyByte использует английский. Выберите язык выше, чтобы изменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُترجم لغة جهازك بعد، لذا يستخدم TidyByte الإنجليزية. اختر لغة أعلاه للتجاوز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שפת המכשיר שלך עדיין לא תורגמה, ולכן TidyByte משתמש באנגלית. בחר שפה למעלה כדי לעקוף זאת."
          }
        }
      }
    },
    "Your library changed during analysis. Scan again for current results.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed during analysis. Scan again for current results."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण के दौरान आपकी लाइब्रेरी बदल गई. मौजूदा नतीजों के लिए फिर से स्कैन करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষণের সময় আপনার লাইব্রেরি বদলে গেছে. বর্তমান ফলাফলের জন্য আবার স্ক্যান করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிசோதனையின் போது உங்கள் நூலகம் மாறியது. தற்போதைய முடிவுகளுக்கு மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విశ్లేషణ సమయంలో మీ లైబ్రరీ మారింది. ప్రస్తుత ఫలితాల కోసం మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषणादरम्यान तुमची लायब्ररी बदलली. सध्याच्या निकालांसाठी पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિશ્લેષણ દરમિયાન તમારી લાઇબ્રેરી બદલાઈ. વર્તમાન પરિણામો માટે ફરી સ્કેન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಶ್ಲೇಷಣೆಯ ವೇಳೆ ನಿಮ್ಮ ಲೈಬ್ರರಿ ಬದಲಾಗಿದೆ. ಇತ್ತೀಚಿನ ಫಲಿತಾಂಶಗಳಿಗಾಗಿ ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശകലനത്തിനിടയിൽ നിങ്ങളുടെ ലൈബ്രറി മാറി. ഇപ്പോഴത്തെ ഫലങ്ങൾക്കായി വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਸ਼ਲੇਸ਼ਣ ਦੌਰਾਨ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਬਦਲ ਗਈ. ਮੌਜੂਦਾ ਨਤੀਜਿਆਂ ਲਈ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca cambió durante el análisis. Vuelve a analizar para ver los resultados actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque a changé pendant l'analyse. Relancez l'analyse pour obtenir des résultats à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek hat sich während der Analyse geändert. Scanne erneut für aktuelle Ergebnisse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca mudou durante a análise. Analise de novo para ver os resultados atuais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è cambiata durante l'analisi. Ripeti l'analisi per ottenere risultati aggiornati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析中にライブラリが変更されました。最新の結果を得るには再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 중에 사진 보관함이 변경되었습니다. 최신 결과를 보려면 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析期间你的图库发生了变化。请重新扫描以获取最新结果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время анализа медиатека изменилась. Повторите сканирование, чтобы получить актуальные результаты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت مكتبتك أثناء التحليل. أعد الفحص للحصول على النتائج الحالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלך השתנתה במהלך הניתוח. סרוק שוב כדי לקבל תוצאות מעודכנות."
          }
        }
      }
    },
    "Your library changed during analysis. Try Worst Shots again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed during analysis. Try Worst Shots again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण के दौरान आपकी लाइब्रेरी बदल गई. \"सबसे खराब शॉट\" फिर से आज़माएँ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষণের সময় আপনার লাইব্রেরি বদলে গেছে. \"সবচেয়ে খারাপ শট\" আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிசோதனையின் போது உங்கள் நூலகம் மாறியது. மோசமான படங்களை மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విశ్లేషణ జరుగుతుండగా మీ లైబ్రరీ మారింది. \"అత్యంత తక్కువ నాణ్యత ఫోటోలు\" మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषणादरम्यान तुमची लायब्ररी बदलली. सर्वात खराब शॉट्स पुन्हा वापरून पहा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિશ્લેષણ દરમિયાન તમારી લાઇબ્રેરી બદલાઈ. સૌથી ખરાબ શોટ ફરી અજમાવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಶ್ಲೇಷಣೆ ನಡೆಯುವಾಗ ನಿಮ್ಮ ಲೈಬ್ರರಿ ಬದಲಾಯಿತು. \"ಅತ್ಯಂತ ಕಡಿಮೆ ಗುಣಮಟ್ಟದ ಫೋಟೋಗಳು\" ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശകലനം നടക്കുമ്പോൾ നിങ്ങളുടെ ലൈബ്രറി മാറി. \"ഏറ്റവും മോശം ഫോട്ടോകൾ\" വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਸ਼ਲੇਸ਼ਣ ਦੌਰਾਨ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਬਦਲ ਗਈ. ਸਭ ਤੋਂ ਮਾੜੇ ਸ਼ਾਟ ਦੁਬਾਰਾ ਅਜ਼ਮਾਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca cambió durante el análisis. Prueba Peores fotos de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque a changé pendant l'analyse. Réessayez Pires photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek hat sich während der Analyse geändert. Versuche es erneut mit „Schlechteste Aufnahmen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca mudou durante a análise. Tente Piores fotos de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è cambiata durante l'analisi. Riprova Scatti peggiori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析中にライブラリが変更されました。「ワーストショット」をもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 중에 사진 보관함이 변경되었습니다. \"최악의 사진\"을 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析期间你的图库发生了变化。请再次尝试“最差照片”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время анализа медиатека изменилась. Попробуйте «Худшие снимки» снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت مكتبتك أثناء التحليل. جرّب «أسوأ اللقطات» مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלך השתנתה בזמן הניתוח. נסה שוב את \"הצילומים הגרועים\"."
          }
        }
      }
    },
    "Your library changed. Scan again before searching.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed. Scan again before searching."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी बदल गई. खोजने से पहले फिर से स्कैन करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি বদলে গেছে. খোঁজার আগে আবার স্ক্যান করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகம் மாறியது. தேடுவதற்கு முன் மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీ మారింది. శోధించే ముందు మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची लायब्ररी बदलली. शोधण्यापूर्वी पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરી બદલાઈ. શોધતા પહેલાં ફરી સ્કેન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿ ಬದಲಾಗಿದೆ. ಹುಡುಕುವ ಮೊದಲು ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി മാറി. തിരയുന്നതിന് മുമ്പ് വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਬਦਲ ਗਈ. ਖੋਜਣ ਤੋਂ ਪਹਿਲਾਂ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca cambió. Vuelve a analizar antes de buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque a changé. Relancez l'analyse avant de rechercher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek hat sich geändert. Scanne erneut, bevor du suchst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca mudou. Analise de novo antes de buscar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è cambiata. Ripeti l'analisi prima di cercare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリが変更されました。検索する前に再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함이 변경되었습니다. 검색하기 전에 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的图库已更改。请先重新扫描再搜索。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиатека изменилась. Повторите сканирование перед поиском."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت مكتبتك. أعد الفحص قبل البحث."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלך השתנתה. סרוק שוב לפני החיפוש."
          }
        }
      }
    },
