    "Delete only what you review and approve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete only what you review and approve"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही हटाएँ जिसे आप देखकर मंज़ूरी दें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনি যেটি দেখে অনুমোদন করবেন সেটিই মুছুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பார்த்து ஒப்புக்கொண்டதை மட்டும் நீக்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమీక్షించి ఆమోదించినవి మాత్రమే తొలగించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तपासून मंजूर केलेलेच हटवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સમીક્ષા કરીને મંજૂર કરો તે જ કાઢી નાખો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಪರಿಶೀಲಿಸಿ ಅನುಮೋದಿಸಿದ್ದನ್ನು ಮಾತ್ರ ಅಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ പരിശോധിച്ച് അംഗീകരിക്കുന്നത് മാത്രം ഇല്ലാതാക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਉਹੀ ਮਿਟਾਓ ਜਿਸਦੀ ਤੁਸੀਂ ਸਮੀਖਿਆ ਕਰਕੇ ਮਨਜ਼ੂਰੀ ਦਿੰਦੇ ਹੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo lo que revises y apruebes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprimez que ce que vous examinez et approuvez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche nur, was du geprüft und bestätigt hast"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague só o que você revisar e aprovar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo ciò che esamini e approvi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で確認して承認したものだけを削除します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 확인하고 승인한 항목만 삭제합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除你查看并确认的内容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет только то, что вы просмотрели и одобрили"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف فقط ما تراجعه وتوافق عليه"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת רק מה שסקרת ואישרת"
          }
        }
      }
    },
