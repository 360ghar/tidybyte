    "Open TidyByte once so it can scan your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TidyByte once so it can scan your library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte को एक बार खोलें ताकि यह आपकी लाइब्रेरी स्कैन कर सके."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte একবার খুলুন যাতে এটি আপনার লাইব্রেরি স্ক্যান করতে পারে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தை ஸ்கேன் செய்ய TidyByte-ஐ ஒருமுறை திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీని స్కాన్ చేయడానికి TidyByteను ఒకసారి తెరవండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte एकदा उघडा जेणेकरून ते तुमची लायब्ररी स्कॅन करू शकेल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte એક વાર ખોલો જેથી તે તમારી લાઇબ્રેરી સ્કેન કરી શકે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ಒಮ್ಮೆ ತೆರೆಯಿರಿ, ಆಗ ಅದು ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಬಲ್ಲದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്യാൻ TidyByte ഒരിക്കൽ തുറക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ਇੱਕ ਵਾਰ ਖੋਲ੍ਹੋ ਤਾਂ ਜੋ ਇਹ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰ ਸਕੇ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre TidyByte una vez para que pueda analizar tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez TidyByte une fois pour qu'il puisse analyser votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TidyByte einmal, damit deine Mediathek gescannt werden kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o TidyByte uma vez para que ele analise sua biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri TidyByte una volta così può analizzare la tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByteを一度開くとライブラリをスキャンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte를 한 번 열면 보관함을 스캔할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一次 TidyByte，以便扫描你的图库。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте TidyByte один раз, чтобы он просканировал медиатеку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح TidyByte مرة واحدة ليفحص مكتبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את TidyByte פעם אחת כדי שיסרוק את הספרייה שלך."
          }
        }
      }
    },
