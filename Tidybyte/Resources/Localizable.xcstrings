          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿನ ಪ್ರತಿ ಫೋಟೋ ಮತ್ತು ವೀಡಿಯೊ"
