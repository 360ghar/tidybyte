            "value": "యాప్లు & సిస్టమ్ నిల్వను నిర్వహించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप्स आणि सिस्टम स्टोरेज व्यवस्थापित करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપ્સ અને સિસ્ટમ સ્ટોરેજનું સંચાલન કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ಗಳು ಮತ್ತು ಸಿಸ್ಟಂ ಸಂಗ್ರಹಣೆ ನಿರ್ವಹಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പുകളും സിസ്റ്റം സ്റ്റോറേജും നിയന്ത്രിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪਾਂ ਅਤੇ ਸਿਸਟਮ ਸਟੋਰੇਜ ਦਾ ਪ੍ਰਬੰਧ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionar apps y almacenamiento del sistema"
          }
        },
        "fr": {
          "stringUnit": {
