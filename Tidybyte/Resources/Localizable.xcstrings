          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez TidyByte et commencez à examiner vos photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TidyByte und beginne, deine Fotos zu prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o TidyByte e comece a revisar suas fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri TidyByte e inizia a esaminare le foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByteを開いて写真の確認を始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte를 열고 사진 검토를 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 TidyByte 开始查看照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте TidyByte и начните просмотр фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح TidyByte وابدأ بمراجعة الصور."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את TidyByte והתחל לסקור תמונות."
          }
        }
      }
