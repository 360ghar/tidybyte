    "Couldn't modify the album. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't modify the album. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एल्बम बदला नहीं जा सका. कृपया फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালবাম বদলানো যায়নি. আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆல்பத்தை மாற்ற முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆల్బమ్ను మార్చలేకపోయాం. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अल्बम बदलता आला नाही. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આલ્બમ બદલી શકાયું નથી. ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಲ್ಬಮ್ ಅನ್ನು ಬದಲಾಯಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആൽബം മാറ്റാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
