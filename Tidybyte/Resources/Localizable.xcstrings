            "value": "ਇਹ ਆਈਟਮ %@ ਵਰਤਦੀ ਹੈ; ਇਸਦੀ ਲੋੜ ਹੈ ਕਿ ਨਹੀਂ, ਵੇਖੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento ocupa %@; revisa si lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément occupe %@ ; vérifiez si vous en avez besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt belegt %@; prüfe, ob du es brauchst."
