    "Enable notifications for TidyByte in Settings to receive cleanup reminders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications for TidyByte in Settings to receive cleanup reminders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लीनअप रिमाइंडर पाने के लिए सेटिंग्स में TidyByte के लिए सूचनाएँ चालू करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কারের রিমাইন্ডার পেতে সেটিংসে TidyByte-এর জন্য বিজ্ঞপ্তি চালু করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தம் நினைவூட்டல்களைப் பெற அமைப்புகளில் TidyByte-க்கு அறிவிப்புகளை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లీన్అప్ రిమైండర్లు పొందడానికి సెట్టింగ్లలో TidyByte కోసం నోటిఫికేషన్లను ఆన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लीनअप स्मरणपत्रे मिळवण्यासाठी सेटिंग्जमध्ये TidyByte साठी सूचना सुरू करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લીનઅપ રિમાઇન્ડર મેળવવા સેટિંગ્સમાં TidyByte માટે સૂચનાઓ ચાલુ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲೀನ್ಅಪ್ ಜ್ಞಾಪನೆಗಳನ್ನು ಪಡೆಯಲು ಸೆಟ್ಟಿಂಗ್ಗಳಲ್ಲಿ TidyByte ಗಾಗಿ ಅಧಿಸೂಚನೆಗಳನ್ನು ಆನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലീനപ്പ് ഓർമ്മപ്പെടുത്തലുകൾ ലഭിക്കാൻ സെറ്റിംഗ്സിൽ TidyByte-നായി അറിയിപ്പുകൾ ഓണാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਫ਼ਾਈ ਦੇ ਰਿਮਾਈਂਡਰ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ TidyByte ਲਈ ਨੋਟੀਫਿਕੇਸ਼ਨ ਚਾਲੂ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones de TidyByte en Ajustes para recibir recordatorios de limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications de TidyByte dans Réglages pour recevoir des rappels de nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Benachrichtigungen für TidyByte in Einstellungen, um Bereinigungserinnerungen zu erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações do TidyByte em Ajustes para receber lembretes de limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per TidyByte in Impostazioni per ricevere i promemoria di pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でTidyByteの通知をオンにすると、クリーンアップのリマインダーを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 TidyByte 알림을 켜면 정리 알림을 받을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 TidyByte 开启通知，以接收清理提醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите уведомления для TidyByte в «Настройках», чтобы получать напоминания об очистке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الإشعارات لـ TidyByte في «الإعدادات» لتلقي تذكيرات التنظيف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל התראות עבור TidyByte בהגדרות כדי לקבל תזכורות ניקוי."
          }
        }
      }
    },
