    "Photo size unknown (iCloud-only) — skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo size unknown (iCloud-only) — skipped."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो का आकार अज्ञात (केवल iCloud) — छोड़ा गया."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটোর আকার অজানা (শুধু iCloud) — এড়িয়ে যাওয়া হয়েছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்பட அளவு தெரியவில்லை (iCloud-இல் மட்டும்) — தவிர்க்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో పరిమాణం తెలియదు (iCloud-మాత్రమే) — దాటవేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटोचा आकार माहीत नाही (फक्त iCloud मध्ये) — वगळला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટાની સાઇઝ અજાણી (ફક્ત iCloud માં) — છોડી દીધો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಗಾತ್ರ ತಿಳಿದಿಲ್ಲ (iCloud-ಮಾತ್ರ) — ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ വലിപ്പം അറിയില്ല (iCloud-ഒൺലി) — ഒഴിവാക്കി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਦਾ ਆਕਾਰ ਅਣਜਾਣ (ਸਿਰਫ਼ iCloud ਵਿੱਚ) — ਛੱਡੀ ਗਈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de la foto desconocido (solo en iCloud) — omitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la photo inconnue (iCloud uniquement) — ignorée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogröße unbekannt (nur in iCloud) — übersprungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho da foto desconhecido (apenas no iCloud) — ignorada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione della foto sconosciuta (solo iCloud) — saltata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のサイズが不明（iCloudのみ）— スキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 크기를 알 수 없음(iCloud에만) — 건너뜀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片大小未知（仅限 iCloud）— 已跳过。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер фото неизвестен (только в iCloud) — пропущено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الصورة غير معروف (iCloud فقط) — تم التخطي."
          }
