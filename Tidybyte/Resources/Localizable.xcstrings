            "value": "तुम्ही नुकतेच %@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હમણાં જ %@."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈಗತಾನೇ %@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇപ്പോൾ %@."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਹੁਣੇ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
