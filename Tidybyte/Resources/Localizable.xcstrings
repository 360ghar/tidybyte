    "Returns to the swipe home; reviews pending deletions first if any": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns to the swipe home; reviews pending deletions first if any"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप होम पर लौटता है; लंबित हटाने पहले दिखाता है, अगर कोई हो"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোয়াইপ হোমে ফিরে যায়; কোনও মুলতুবি মোছা থাকলে আগে তা দেখায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்வைப் முகப்புக்குத் திரும்பும்; நிலுவையில் உள்ள நீக்கங்கள் இருந்தால் முதலில் அவற்றைப் பார்க்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వైప్ హోమ్కు తిరిగి వెళ్తుంది; పెండింగ్ తొలగింపులు ఉంటే ముందు వాటిని చూపిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप होमवर परत जाते; काही प्रलंबित हटवणी असल्यास आधी त्यांचे पुनरावलोकन करते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વાઇપ હોમ પર પાછું જાય છે; બાકી કાઢી નાખવાની હોય તો પહેલાં તેની સમીક્ષા કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವೈಪ್ ಮುಖಪುಟಕ್ಕೆ ಮರಳುತ್ತದೆ; ಬಾಕಿ ಇರುವ ಅಳಿಸುವಿಕೆಗಳಿದ್ದರೆ ಮೊದಲು ಅವನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വൈപ്പ് ഹോമിലേക്ക് മടങ്ങുന്നു; ബാക്കിയുള്ള ഇല്ലാതാക്കലുകൾ ഉണ്ടെങ്കിൽ ആദ്യം അവ പരിശോധിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਈਪ ਹੋਮ ਉੱਤੇ ਵਾਪਸ ਜਾਂਦਾ ਹੈ; ਜੇ ਬਾਕੀ ਮਿਟਾਉਣੀਆਂ ਹੋਣ ਤਾਂ ਪਹਿਲਾਂ ਉਨ੍ਹਾਂ ਦੀ ਸਮੀਖਿਆ ਕਰਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al inicio de deslizar; si hay eliminaciones pendientes, las revisa primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient à l'accueil du balayage ; examine d'abord les suppressions en attente, s'il y en a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehrt zum Start des Wischens zurück; prüft zuvor ausstehende Löschungen, falls vorhanden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para a tela inicial de deslizes; revisa exclusões pendentes primeiro, se houver"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna alla schermata iniziale degli scorrimenti; esamina prima le eliminazioni in sospeso, se presenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプのホームに戻ります。保留中の削除があれば先に確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프 홈으로 돌아갑니다. 대기 중인 삭제가 있으면 먼저 검토합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回滑动主页；如有待处理的删除，会先进行查看"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает на главный экран свайпов; если есть ожидающие удаления, сначала показывает их"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود إلى شاشة السحب الرئيسية؛ ويراجع عمليات الحذف المعلقة أولًا إن وُجدت"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוזר למסך ההחלקה הראשי; מציג תחילה מחיקות ממתינות אם יש"
          }
        }
      }
    },
    "Reverts your last swipe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverts your last swipe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पिछला स्वाइप पूर्ववत करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শেষ সোয়াইপ ফিরিয়ে আনে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடைசி ஸ்வைப்பை மீளச் செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చివరి స్వైప్ను వెనక్కి తీసుకుంటుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा शेवटचा स्वाइप पूर्ववत करते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું છેલ્લું સ્વાઇપ પૂર્વવત્ કરે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕೊನೆಯ ಸ್ವೈಪ್ ಅನ್ನು ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അവസാന സ്വൈപ്പ് പഴയപടിയാക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਪਿਛਲੀ ਸਵਾਈਪ ਵਾਪਸ ਲਿਆਉਂਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revierte tu último deslizamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule votre dernier balayage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht dein letztes Wischen rückgängig"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfaz seu último deslize"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla l'ultimo scorrimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のスワイプを元に戻します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 스와이프를 되돌립니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销上一次滑动"
          }
        },
        "ru": {
