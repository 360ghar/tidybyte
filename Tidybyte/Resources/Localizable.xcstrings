    "Failed to save compressed photo to library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to save compressed photo to library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई फ़ोटो लाइब्रेरी में सहेजी नहीं जा सकी."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করা ফটো লাইব্রেরিতে সেভ করা যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கிய புகைப்படத்தை நூலகத்தில் சேமிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించిన ఫోటోను లైబ్రరీలో సేవ్ చేయడం విఫలమైంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस केलेला फोटो लायब्ररीत सेव्ह करता आला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલો ફોટો લાઇબ્રેરીમાં સાચવી શકાયો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿಸಿದ ಫೋಟೋವನ್ನು ಲೈಬ್ರರಿಯಲ್ಲಿ ಉಳಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത ഫോട്ടോ ലൈബ്രറിയിൽ സേവ് ചെയ്യാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪਰੈਸ ਕੀਤੀ ਫ਼ੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਸੇਵ ਨਹੀਂ ਹੋ ਸਕੀ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la foto comprimida en la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la photo compressée dans la photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das komprimierte Foto konnte nicht in der Mediathek gesichert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar a foto comprimida na biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la foto compressa nella libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮した写真をライブラリに保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축한 사진을 사진 보관함에 저장하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将压缩后的照片存储到图库。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить сжатое фото в медиатеку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ الصورة المضغوطة في المكتبة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת התמונה המכווצת לספרייה נכשלה."
          }
        }
      }
    },
