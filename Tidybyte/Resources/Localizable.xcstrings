          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি ফোকাসের বাইরে থাকতে পারে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படம் கவனம் விலகி இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో ఫోకస్ లేకుండా ఉండవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो फोकसबाहेर असू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો ફોકસ બહાર હોઈ શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಫೋಕಸ್ನಲ್ಲಿಲ್ಲದಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഫോക്കസിലല്ലായിരിക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ੋਟੋ ਫੋਕਸ ਤੋਂ ਬਾਹਰ ਹੋ ਸਕਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que esta foto esté desenfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est peut-être floue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist möglicherweise unscharf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto pode estar fora de foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto potrebbe essere fuori fuoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真はピントが合っていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 초점이 맞지 않았을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片可能未对焦。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото может быть не в фокусе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون هذه الصورة غير واضحة التركيز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהתמונה הזו לא מפוקסת."
          }
        }
      }
    },
    "This photo received a low visual-quality score.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo received a low visual-quality score."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को दृश्य गुणवत्ता में कम स्कोर मिला."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি দৃশ্যমান গুণমানের কম স্কোর পেয়েছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்திற்குக் காட்சித் தர மதிப்பெண் குறைவாக இருந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోకు తక్కువ దృశ్య నాణ్యత స్కోరు లభించింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोला दृश्य-गुणवत्तेचा कमी गुण मिळाला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટાને દૃશ્ય-ગુણવત્તાનો ઓછો સ્કોર મળ્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋಗೆ ಕಡಿಮೆ ದೃಶ್ಯ-ಗುಣಮಟ್ಟದ ಸ್ಕೋರ್ ಸಿಕ್ಕಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയ്ക്ക് കുറഞ്ഞ ദൃശ്യ-ഗുണനിലവാര സ്കോർ ലഭിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਦਿੱਖ-ਗੁਣਵੱਤਾ ਦਾ ਘੱਟ ਸਕੋਰ ਮਿਲਿਆ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto recibió una puntuación baja de calidad visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a reçu un faible score de qualité visuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildqualität dieses Fotos wurde niedrig bewertet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto recebeu uma pontuação baixa de qualidade visual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha ricevuto un punteggio basso di qualità visiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の画質評価が低くなっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 시각적 품질 점수가 낮습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片的视觉质量评分较低。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото получило низкую оценку визуального качества."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حصلت هذه الصورة على تقييم منخفض للجودة البصرية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה הזו קיבלה ציון נמוך באיכות חזותית."
          }
        }
      }
    },
    "This removes both the still image and the motion. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes both the still image and the motion. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्थिर छवि और मोशन दोनों हटाता है. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি স্থির ছবি ও মোশন দুটোই সরায়. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நிலைப்படத்தையும் இயக்கத்தையும் நீக்கும். %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది స్థిర చిత్రాన్ని మరియు కదలికను రెండింటినీ తీసివేస్తుంది. %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे स्थिर प्रतिमा आणि हालचाल दोन्ही काढून टाकते. %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સ્થિર ઇમેજ અને ગતિ બંને દૂર કરે છે. %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಸ್ಥಿರ ಚಿತ್ರ ಮತ್ತು ಚಲನೆ ಎರಡನ್ನೂ ತೆಗೆದುಹಾಕುತ್ತದೆ. %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് സ്റ്റിൽ ഇമേജും ചലനവും രണ്ടും നീക്കും. %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਥਿਰ ਤਸਵੀਰ ਅਤੇ ਗਤੀ ਦੋਵੇਂ ਹਟਾ ਦਿੰਦਾ ਹੈ. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tanto la imagen fija como el movimiento. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime à la fois l'image fixe et le mouvement. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt sowohl das Standbild als auch die Bewegung. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove tanto a imagem estática quanto o movimento. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove sia l'immagine statica sia il movimento. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止画と動きの両方を削除します。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정지 이미지와 움직임을 모두 제거합니다. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会同时移除静帧图像和动态部分。%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит и статичное изображение, и движение. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا الصورة الثابتة والحركة معًا. %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה גם את התמונה הסטטית וגם את התנועה. %@"
          }
        }
      }
    },
    "This will clear all swipe records. All photos will appear as \"Not Swiped Yet\" again. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear all swipe records. All photos will appear as \"Not Swiped Yet\" again. This cannot be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी स्वाइप रिकॉर्ड साफ़ कर देगा. सभी फ़ोटो फिर से \"अभी स्वाइप नहीं किया\" दिखेंगी. इसे पूर्ववत नहीं किया जा सकता."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সব সোয়াইপ রেকর্ড মুছে দেবে. সব ফটো আবার \"এখনও সোয়াইপ করা হয়নি\" দেখাবে. এটি ফিরিয়ে আনা যায় না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது எல்லா ஸ்வைப் பதிவுகளையும் அழிக்கும். எல்லா புகைப்படங்களும் மீண்டும் \"இன்னும் ஸ்வைப் செய்யப்படவில்லை\" எனத் தோன்றும். இதை மீளச் செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది అన్ని స్వైప్ రికార్డులను క్లియర్ చేస్తుంది. అన్ని ఫోటోలు మళ్లీ \"ఇంకా స్వైప్ చేయలేదు\" అని కనిపిస్తాయి. దీన్ని వెనక్కి తీసుకోలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे सर्व स्वाइप नोंदी साफ होतील. सर्व फोटो पुन्हा \"अजून स्वाइप केलेले नाही\" म्हणून दिसतील. हे पूर्ववत करता येणार नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી બધા સ્વાઇપ રેકોર્ડ સાફ થશે. બધા ફોટા ફરી \"હજી સ્વાઇપ કરેલું નથી\" તરીકે દેખાશે. આ પૂર્વવત્ કરી શકાશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಎಲ್ಲಾ ಸ್ವೈಪ್ ದಾಖಲೆಗಳನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ. ಎಲ್ಲಾ ಫೋಟೋಗಳು ಮತ್ತೆ \"ಇನ್ನೂ ಸ್ವೈಪ್ ಮಾಡಿಲ್ಲ\" ಎಂದು ಕಾಣಿಸುತ್ತವೆ. ಇದನ್ನು ಹಿಂತಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് എല്ലാ സ്വൈപ്പ് രേഖകളും മായ്ക്കും. എല്ലാ ഫോട്ടോകളും വീണ്ടും \"ഇതുവരെ സ്വൈപ്പ് ചെയ്തിട്ടില്ല\" എന്ന് കാണിക്കും. ഇത് പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਾਰੇ ਸਵਾਈਪ ਰਿਕਾਰਡ ਸਾਫ਼ ਕਰ ਦੇਵੇਗਾ. ਸਾਰੀਆਂ ਫ਼ੋਟੋਆਂ ਦੁਬਾਰਾ \"ਹਾਲੇ ਸਵਾਈਪ ਨਹੀਂ ਕੀਤੀ\" ਵਜੋਂ ਦਿਖਣਗੀਆਂ. ਇਹ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará todos los registros de deslizamiento. Todas las fotos volverán a aparecer como \"Aún no deslizada\". No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera tous les enregistrements de balayage. Toutes les photos réapparaîtront comme \"Pas encore balayée\". Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht alle Wisch-Einträge. Alle Fotos erscheinen wieder als \"Noch nicht gewischt\". Das kann nicht rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso limpará todos os registros de deslizes. Todas as fotos aparecerão como \"Ainda não avaliada\" novamente. Não é possível desfazer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cancellerà tutti i record degli scorrimenti. Tutte le foto appariranno di nuovo come \"Non ancora scorrite\". Non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスワイプ記録を消去します。すべての写真が再び「未スワイプ」として表示されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스와이프 기록이 지워집니다. 모든 사진이 다시 \"아직 스와이프 안 함\"으로 표시됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除所有滑动记录。所有照片都会再次显示为“尚未滑动”。此操作无法撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очистит все записи свайпов. Все фото снова будут показаны как «Не просмотрено». Действие нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح كل سجلات السحب. ستظهر كل الصور مرة أخرى كـ «لم يتم السحب بعد». لا يمكن التراجع عن هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תנקה את כל רשומות ההחלקה. כל התמונות יופיעו שוב כ\"טרם הוחלק\". לא ניתן לבטל פעולה זו."
          }
        }
      }
    },
    "This will delete %@ of media. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete %@ of media. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %@ मीडिया हटा देगा. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
