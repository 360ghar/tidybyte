    "Delete is off until the photo loads.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete is off until the photo loads."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो लोड होने तक हटाना बंद है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো লোড না হওয়া পর্যন্ত মোছা বন্ধ থাকে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் ஏற்றப்படும் வரை நீக்கு முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో లోడ్ అయ్యే వరకు తొలగింపు ఆఫ్లో ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो लोड होईपर्यंत हटवा बंद असतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો લોડ થાય ત્યાં સુધી કાઢી નાખો બંધ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಲೋಡ್ ಆಗುವವರೆಗೆ ಅಳಿಸುವಿಕೆ ಆಫ್ ಆಗಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ ലോഡ് ആകുന്നതുവരെ ഇല്ലാതാക്കൽ ഓഫ് ആയിരിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਲੋਡ ਹੋਣ ਤੱਕ ਮਿਟਾਉਣਾ ਬੰਦ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación está desactivada hasta que se cargue la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression est désactivée jusqu'au chargement de la photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen ist deaktiviert, bis das Foto geladen ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar fica desativado até a foto carregar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione è disattivata finché la foto non viene caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が読み込まれるまで削除はオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 로드될 때까지 삭제는 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片载入前无法删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление отключено, пока фото не загрузится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف معطّل حتى تُحمَّل الصورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחיקה מושבתת עד שהתמונה תיטען."
          }
        }
      }
    },
