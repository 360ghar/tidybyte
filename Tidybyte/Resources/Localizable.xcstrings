    "Leaves this photo unchanged and shows the next one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves this photo unchanged and shows the next one"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को अपरिवर्तित छोड़ता है और अगली दिखाता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটো অপরিবর্তিত রেখে পরেরটি দেখায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை மாற்றாமல் அடுத்ததைக் காட்டுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను మార్చకుండా తదుపరిది చూపిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो बदलत नाही आणि पुढचा दाखवते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો બદલતું નથી અને આગલો બતાવે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಬದಲಾಗದೆ ಮುಂದಿನದನ್ನು ತೋರಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ മാറ്റാതെ അടുത്തത് കാണിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਬਦਲੇ ਬਿਨਾਂ ਅਗਲੀ ਦਿਖਾਉਂਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja esta foto sin cambios y muestra la siguiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse cette photo inchangée et affiche la suivante"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt dieses Foto unverändert und zeigt das nächste"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa esta foto como está e mostra a próxima"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia questa foto invariata e mostra la successiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を変更せずに次を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 그대로 두고 다음 항목을 표시합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不更改此照片并显示下一张"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет это фото без изменений и показывает следующее"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترك هذه الصورة دون تغيير ويعرض التالية"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משאיר תמונה זו ללא שינוי ומציג את הבאה"
          }
        }
      }
    },
