    "Step 2 of 2 · Confirm in the iOS alert to delete the originals": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 2 of 2 · Confirm in the iOS alert to delete the originals"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण 2/2 · मूल फ़ाइलें हटाने के लिए iOS अलर्ट में पुष्टि करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধাপ 2/2 · মূল ফাইলগুলি মুছতে iOS অ্যালার্টে নিশ্চিত করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படி 2/2 · மூலங்களை நீக்க iOS எச்சரிக்கையில் உறுதிப்படுத்தவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దశ 2 / 2 · అసలైనవి తొలగించడానికి iOS హెచ్చరికలో నిర్ధారించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टप्पा 2 / 2 · मूळ हटवण्यासाठी iOS अलर्टमध्ये निश्चित करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગલું 2 / 2 · મૂળ કાઢી નાખવા iOS ચેતવણીમાં પુષ્ટિ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಂತ 2 / 2 · ಮೂಲಗಳನ್ನು ಅಳಿಸಲು iOS ಎಚ್ಚರಿಕೆಯಲ್ಲಿ ದೃಢೀಕರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഘട്ടം 2 / 2 · ഒറിജിനലുകൾ ഇല്ലാതാക്കാൻ iOS മുന്നറിയിപ്പിൽ സ്ഥിരീകരിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਦਮ 2 / 2 · ਅਸਲੀ ਫ਼ਾਈਲਾਂ ਮਿਟਾਉਣ ਲਈ iOS ਚੇਤਾਵਨੀ ਵਿੱਚ ਪੁਸ਼ਟੀ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso 2 de 2 · Confirma en el aviso de iOS para eliminar los originales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape 2 sur 2 · Confirmez dans l'alerte iOS pour supprimer les originaux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt 2 von 2 · Bestätige im iOS-Dialog, um die Originale zu löschen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapa 2 de 2 · Confirme no alerta do iOS para apagar os originais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggio 2 di 2 · Conferma nell'avviso di iOS per eliminare gli originali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ 2/2 · iOSのアラートで元の項目の削除を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2/2 단계 · iOS 알림에서 원본 삭제를 확인하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 2/2 步 · 在 iOS 提醒中确认删除原件"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг 2 из 2 · Подтвердите удаление оригиналов в уведомлении iOS"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطوة 2 من 2 · أكّد في تنبيه iOS لحذف الأصول"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלב 2 מתוך 2 · אשר בהתראה של iOS כדי למחוק את המקוריים"
          }
        }
      }
    },
    "Still adding — please wait a moment and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still adding — please wait a moment and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी जोड़ा जा रहा है — कृपया एक पल रुकें और फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও যোগ করা হচ্ছে — একটু অপেক্ষা করে আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் சேர்க்கிறது — சிறிது நேரம் காத்திருந்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా జోడిస్తోంది — కొద్దిసేపు ఆగి మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून जोडत आहे — कृपया थोडा वेळ थांबा आणि पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી ઉમેરી રહ્યાં છીએ — થોડી વાર રાહ જુઓ અને ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಸೇರಿಸುತ್ತಿದೆ — ಸ್ವಲ್ಪ ಕಾಯಿರಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോഴും ചേർക്കുന്നു — ഒരു നിമിഷം കാത്തിരുന്ന് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਸ਼ਾਮਲ ਕਰ ਰਹੇ ਹਾਂ — ਕਿਰਪਾ ਕਰਕੇ ਥੋੜ੍ਹੀ ਦੇਰ ਉਡੀਕੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún añadiendo — espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout en cours — patientez un instant et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird noch hinzugefügt — warte einen Moment und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda adicionando — aguarde um momento e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunta in corso — attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加中です — 少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 추가하는 중입니다 — 잠시 기다렸다가 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在添加中 — 请稍等片刻后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еще добавляется — подождите немного и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الإضافة — انتظر لحظة وحاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין מוסיף — המתן רגע ונסה שוב."
          }
        }
      }
    },
