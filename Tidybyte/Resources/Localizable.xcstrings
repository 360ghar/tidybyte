    "Scan your library for exact and visually similar duplicates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan your library for exact and visually similar duplicates."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक और दिखने में मिलते-जुलते डुप्लिकेट के लिए अपनी लाइब्रेरी स्कैन करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হুবহু ও দেখতে একইরকম ডুপ্লিকেটের জন্য আপনার লাইব্রেরি স্ক্যান করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான மற்றும் காட்சியில் ஒத்த நகல்களுக்காக உங்கள் நூலகத்தை ஸ்கேன் செய்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖచ్చితమైన మరియు కనిపించేలా సమానమైన నకిలీల కోసం మీ లైబ్రరీని స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अगदी सारखे आणि दिसण्यात सारखे डुप्लिकेट शोधण्यासाठी तुमच्या लायब्ररीचे स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એકદમ સરખા અને દેખાવમાં સરખા ડુપ્લિકેટ માટે તમારી લાઇબ્રેરી સ્કેન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದೇ ರೀತಿಯ ಮತ್ತು ಕಾಣುವಲ್ಲಿ ಹೋಲುವ ನಕಲಿಗಳಿಗಾಗಿ ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൃത്യവും കാഴ്ചയിൽ സമാനവുമായ ഡ്യൂപ്ലിക്കേറ്റുകൾക്കായി നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਲਕੁਲ ਸਮਾਨ ਅਤੇ ਦਿੱਖ ਵਿੱਚ ਸਮਾਨ ਡੁਪਲੀਕੇਟ ਲਈ ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu fototeca en busca de duplicados exactos y visualmente similares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez votre photothèque pour trouver les doublons exacts et visuellement similaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche in deiner Mediathek nach exakten und visuell ähnlichen Duplikaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise sua biblioteca em busca de duplicatas exatas e visualmente semelhantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la libreria per trovare duplicati esatti e visivamente simili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリをスキャンして、完全な重複と見た目の似た重複を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 완전 중복과 시각적으로 비슷한 중복을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描图库，查找完全重复和视觉相似的重复照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просканируйте медиатеку, чтобы найти точные и визуально похожие дубликаты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مكتبتك بحثًا عن المكررات المطابقة والمتشابهة بصريًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרוק את הספרייה שלך לאיתור כפולים זהים ודומים חזותית."
          }
        }
      }
    },
    "Scanning for duplicates...": {
