    "Open TidyByte and review photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TidyByte and review photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte खोलें और फ़ोटो की समीक्षा करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte খুলে ফটো দেখুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte-ஐத் திறந்து புகைப்படங்களைப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte తెరిచి ఫోటోలను సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte उघडा आणि फोटोंचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ખોલો અને ફોટાની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ತೆರೆದು ಫೋಟೋಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte തുറന്ന് ഫോട്ടോകൾ പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ਖੋਲ੍ਹੋ ਅਤੇ ਫ਼ੋਟੋਆਂ ਦੀ ਸਮੀਖਿਆ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre TidyByte y revisa tus fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez TidyByte et examinez vos photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TidyByte und prüfe deine Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o TidyByte e revise suas fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri TidyByte ed esamina le foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByteを開いて写真を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte를 열고 사진을 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 TidyByte 并查看照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте TidyByte и просмотрите фото."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح TidyByte وراجع الصور."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את TidyByte וסקור תמונות."
          }
        }
      }
    },
    "Open TidyByte and start reviewing photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TidyByte and start reviewing photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte खोलें और फ़ोटो की समीक्षा शुरू करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte খুলে ফটো দেখা শুরু করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte-ஐத் திறந்து புகைப்படங்களைப் பார்க்கத் தொடங்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte తెరిచి ఫోటోలను సమీక్షించడం ప్రారంభించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte उघडा आणि फोटोंचे पुनरावलोकन सुरू करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ખોલો અને ફોટાની સમીક્ષા શરૂ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ತೆರೆದು ಫೋಟೋಗಳ ಪರಿಶೀಲನೆ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte തുറന്ന് ഫോട്ടോകൾ പരിശോധിക്കാൻ തുടങ്ങുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ਖੋਲ੍ਹੋ ਅਤੇ ਫ਼ੋਟੋਆਂ ਦੀ ਸਮੀਖਿਆ ਸ਼ੁਰੂ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
