    "Marked for deletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked for deletion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के लिए चिह्नित"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলার জন্য চিহ্নিত"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்குவதற்குக் குறிக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగించడానికి గుర్తించబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवण्यासाठी चिन्हांकित"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખવા માટે ચિહ્નિત"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸಲು ಗುರುತಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കാൻ അടയാളപ്പെടുത്തി"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਉਣ ਲਈ ਨਿਸ਼ਾਨਬੱਧ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcada para eliminación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquée pour suppression"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Löschen markiert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado para exclusão"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegnato per l'eliminazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除対象"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 표시됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记为删除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечено для удаления"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محددة للحذف"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומנו למחיקה"
          }
        }
      }
    },
    "Marked for deletion. Nothing is deleted until you confirm at the end.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked for deletion. Nothing is deleted until you confirm at the end."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के लिए चिह्नित. अंत में पुष्टि करने तक कुछ नहीं हटेगा."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলার জন্য চিহ্নিত. শেষে নিশ্চিত না করলে কিছুই মোছা হবে না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்குவதற்குக் குறிக்கப்பட்டது. இறுதியில் நீங்கள் உறுதிப்படுத்தும் வரை எதுவும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగింపు కోసం గుర్తించబడింది. చివర్లో మీరు నిర్ధారించే వరకు ఏదీ తొలగించబడదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवण्यासाठी चिन्हांकित. तुम्ही शेवटी पुष्टी करेपर्यंत काहीही हटवले जात नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખવા માટે ચિહ્નિત. તમે અંતે પુષ્ટિ કરો ત્યાં સુધી કંઈ કાઢી નાખવામાં આવતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸಲು ಗುರುತಿಸಲಾಗಿದೆ. ಕೊನೆಯಲ್ಲಿ ನೀವು ಖಚಿತಪಡಿಸುವವರೆಗೆ ಏನೂ ಅಳಿಸುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കാൻ അടയാളപ്പെടുത്തി. അവസാനം നിങ്ങൾ സ്ഥിരീകരിക്കുന്നതുവരെ ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਉਣ ਲਈ ਨਿਸ਼ਾਨਬੱਧ. ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਅੰਤ ਵਿੱਚ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕਰਦੇ, ਕੁਝ ਵੀ ਮਿਟਦਾ ਨਹੀਂ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado para eliminación. No se elimina nada hasta que lo confirmes al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué pour suppression. Rien n'est supprimé tant que vous ne confirmez pas à la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Löschen markiert. Nichts wird gelöscht, bis du es am Ende bestätigst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado para exclusão. Nada é apagado até você confirmar no final."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegnato per l'eliminazione. Nulla viene eliminato finché non confermi alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除対象としてマークしました。最後に確認するまで何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 대상으로 표시했습니다. 마지막에 확인하기 전까지는 아무것도 삭제되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记为删除。在你最后确认之前，不会删除任何内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечено для удаления. Ничего не удаляется, пока вы не подтвердите в конце."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم وضع علامة للحذف. لن يُحذف شيء حتى تؤكد في النهاية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומן למחיקה. שום דבר לא יימחק עד שתאשר בסוף."
          }
        }
      }
    },
    "Marks this photo for deletion and shows the next one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks this photo for deletion and shows the next one"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को हटाने के लिए चिह्नित करता है और अगली दिखाता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি মুছে ফেলার জন্য চিহ্নিত করে পরেরটি দেখায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தை நீக்குவதற்குக் குறித்து அடுத்ததைக் காட்டுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోను తొలగించడానికి గుర్తించి తదుపరిది చూపిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो हटवण्यासाठी चिन्हांकित करतो आणि पुढचा दाखवतो"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો કાઢી નાખવા ચિહ્નિત કરે છે અને આગલો બતાવે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋವನ್ನು ಅಳಿಸಲು ಗುರುತಿಸಿ ಮುಂದಿನದನ್ನು ತೋರಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഇല്ലാതാക്കാൻ അടയാളപ്പെടുത്തി അടുത്തത് കാണിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਮਿਟਾਉਣ ਲਈ ਨਿਸ਼ਾਨਬੱਧ ਕਰਦਾ ਹੈ ਅਤੇ ਅਗਲੀ ਦਿਖਾਉਂਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca esta foto para eliminación y muestra la siguiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque cette photo pour suppression et affiche la suivante"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert dieses Foto zum Löschen und zeigt das nächste"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca esta foto para exclusão e mostra a próxima"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna questa foto per l'eliminazione e mostra la successiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を削除対象にして次を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 삭제 대상으로 표시하고 다음 항목을 표시합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此照片标记为删除并显示下一张"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечает это фото для удаления и показывает следующее"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد هذه الصورة للحذف ويعرض التالية"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסמן תמונה זו למחיקה ומציג את הבאה"
          }
        }
      }
    },
