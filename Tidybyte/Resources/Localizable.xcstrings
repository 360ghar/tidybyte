            "value": "TidyByte का वीडियो कंप्रेशन टूल खोलें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte-এর ভিডিও কমপ্রেশন টুল খুলুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte-இன் வீடியோ சுருக்கக் கருவியைத் திற."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte వీడియో కుదింపు సాధనం తెరువు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte चे व्हिडिओ कंप्रेशन साधन उघडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte નું વિડિયો કોમ્પ્રેશન ટૂલ ખોલો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ನ ವೀಡಿಯೊ ಸಂಕೋಚನ ಪರಿಕರ ತೆರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte-ന്റെ വീഡിയോ കംപ്രഷൻ ടൂൾ തുറക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte ਦਾ ਵੀਡੀਓ ਕੰਪਰੈਸ਼ਨ ਟੂਲ ਖੋਲ੍ਹੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la herramienta de compresión de vídeo de TidyByte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'outil de compression vidéo de TidyByte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Video-Komprimierungstool von TidyByte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a ferramenta de compressão de vídeos do TidyByte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri lo strumento di compressione video di TidyByte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByteのビデオ圧縮ツールを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyByte의 동영상 압축 도구를 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 TidyByte 的视频压缩工具。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте инструмент сжатия видео TidyByte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أداة ضغط الفيديوهات في TidyByte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את כלי כיווץ הסרטונים של TidyByte."
          }
        }
      }
    },
    "Open iOS Settings": {
