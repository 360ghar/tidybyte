    "Convert to stills & save space": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert to stills & save space"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर छवियों में कन्वर्ट करें और जगह बचाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থির ছবিতে রূপান্তর করুন ও জায়গা বাঁচান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப்படங்களாக மாற்றி இடத்தைச் சேமி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థిర చిత్రాలుగా మార్చి స్థలం ఆదా చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टिलमध्ये रूपांतरित करा आणि जागा वाचवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ટિલમાં કન્વર્ટ કરો અને જગ્યા બચાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಟಿಲ್ಗಳಾಗಿ ಪರಿವರ್ತಿಸಿ ಮತ್ತು ಜಾಗ ಉಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്റ്റിലുകളാക്കി മാറ്റി സ്ഥലം ലാഭിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਿਰ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਕਨਵਰਟ ਕਰੋ ਅਤੇ ਥਾਂ ਬਚਾਓ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte a fotos fijas y libera espacio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez en photos fixes et libérez de l'espace"
          }
