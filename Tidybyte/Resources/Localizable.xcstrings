    "No screen recordings were found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screen recordings were found."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई स्क्रीन रिकॉर्डिंग नहीं मिली."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনও স্ক্রিন রেকর্ডিং পাওয়া যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரைப் பதிவுகள் எதுவும் கிடைக்கவில்லை."
          }
        },
        "te": {
