    "Not loaded yet. Delete is off until it shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not loaded yet. Delete is off until it shows."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी लोड नहीं हुआ. दिखने तक हटाना बंद है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও লোড হয়নি. এটি দেখা যাওয়ার আগে মোছা বন্ধ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் ஏற்றப்படவில்லை. அது தெரியும் வரை நீக்கம் முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా లోడ్ కాలేదు. అది కనిపించే వరకు తొలగింపు ఆఫ్లో ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून लोड झाले नाही. ते दिसेपर्यंत हटवा बंद असतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી લોડ થયું નથી. તે દેખાય ત્યાં સુધી કાઢી નાખવું બંધ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಲೋಡ್ ಆಗಿಲ್ಲ. ಅದು ಕಾಣಿಸುವವರೆಗೆ ಅಳಿಸುವಿಕೆ ಆಫ್ ಆಗಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ലോഡ് ആയിട്ടില്ല. അത് കാണുന്നതുവരെ ഇല്ലാതാക്കൽ ഓഫ് ആയിരിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਲੋਡ ਨਹੀਂ ਹੋਈ. ਇਹ ਦਿਖਣ ਤੱਕ ਮਿਟਾਉਣਾ ਬੰਦ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha cargado. Eliminar está desactivado hasta que aparezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore chargée. Supprimer est désactivé tant qu'elle ne s'affiche pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geladen. Löschen ist deaktiviert, bis es angezeigt wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não carregou. Apagar fica desativado até aparecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora caricata. Elimina è disattivato finché non compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ読み込まれていません。表示されるまで削除はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 로드되지 않았습니다. 표시될 때까지 삭제할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未载入。显示之前无法删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еще не загружено. Удаление недоступно, пока оно не появится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التحميل بعد. الحذف معطّل حتى تظهر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נטען. המחיקה מושבתת עד שהוא יופיע."
          }
        }
      }
    },
    "Not marked for deletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not marked for deletion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के लिए चिह्नित नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলার জন্য চিহ্নিত নয়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்குவதற்குக் குறிக்கப்படவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగించడానికి గుర్తించబడలేదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवण्यासाठी चिन्हांकित नाही"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખવા માટે ચિહ્નિત નથી"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸಲು ಗುರುತಿಸಲಾಗಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കാൻ അടയാളപ്പെടുത്തിയിട്ടില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਉਣ ਲਈ ਨਿਸ਼ਾਨਬੱਧ ਨਹੀਂ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No marcada para eliminación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non marquée pour suppression"
          }
        },
        "de": {
