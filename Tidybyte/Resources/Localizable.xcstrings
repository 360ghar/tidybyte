    "Notifications Disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications Disabled"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ बंद हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি বন্ধ আছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் முடக்கப்பட்டுள்ளன"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్లు నిలిపివేయబడ్డాయి"
          }
        },
        "mr": {
