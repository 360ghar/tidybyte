    "Albums Need Full Access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums Need Full Access"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एल्बम के लिए पूर्ण ऐक्सेस चाहिए"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালবামের জন্য সম্পূর্ণ অ্যাক্সেস দরকার"
          }
        },
        "ta": {
          "stringUnit": {
