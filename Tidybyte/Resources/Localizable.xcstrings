    "Submit a content search or try different words.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit a content search or try different words."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कॉन्टेंट खोज भेजें या अलग शब्द आज़माएँ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কনটেন্ট অনুসন্ধান দিন বা অন্য শব্দ চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளடக்கத் தேடலைச் சமர்ப்பிக்கவும் அல்லது வேறு வார்த்தைகளை முயற்சி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంటెంట్ శోధన సమర్పించండి లేదా వేరే పదాలు ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री-शोध सबमिट करा किंवा वेगळे शब्द वापरून पहा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામગ્રી શોધ સબમિટ કરો અથવા બીજા શબ્દો અજમાવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಷಯ ಹುಡುಕಾಟ ಸಲ್ಲಿಸಿ ಅಥವಾ ಬೇರೆ ಪದಗಳನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഉള്ളടക്ക തിരയൽ സമർപ്പിക്കുക അല്ലെങ്കിൽ വേറെ വാക്കുകൾ ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੱਗਰੀ ਖੋਜ ਭੇਜੋ ਜਾਂ ਹੋਰ ਸ਼ਬਦ ਅਜ਼ਮਾਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una búsqueda de contenido o prueba otras palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une recherche de contenu ou essayez d'autres mots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine Inhaltssuche oder versuche andere Wörter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma busca de conteúdo ou tente outras palavras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una ricerca di contenuti o prova altre parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容検索を実行するか、別の言葉をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 검색을 제출하거나 다른 단어를 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交内容搜索，或尝试其他词语。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте поиск по содержимому или попробуйте другие слова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل بحثًا عن المحتوى أو جرّب كلمات مختلفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח חיפוש תוכן או נסה מילים אחרות."
          }
        }
      }
    },
    "Surface the biggest files taking up space": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface the biggest files taking up space"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ी जगह लेने वाली फ़ाइलें दिखाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে বেশি জায়গা নেওয়া ফাইল দেখান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிக இடத்தை எடுக்கும் பெரிய கோப்புகளைக் காட்டு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్కువ స్థలం తీసుకుంటున్న అతిపెద్ద ఫైళ్లను చూపించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वाधिक जागा घेणाऱ्या मोठ्या फाइल्स दाखवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી વધુ જગ્યા લેતી મોટી ફાઇલો દર્શાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜಾಗ ತೆಗೆದುಕೊಳ್ಳುತ್ತಿರುವ ಅತಿದೊಡ್ಡ ಫೈಲ್ಗಳನ್ನು ತೋರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥലം എടുക്കുന്ന ഏറ്റവും വലിയ ഫയലുകൾ കാണിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਵੱਧ ਥਾਂ ਲੈਣ ਵਾਲੀਆਂ ਵੱਡੀਆਂ ਫ਼ਾਈਲਾਂ ਦਿਖਾਓ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los archivos más grandes que ocupan espacio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites ressortir les fichiers les plus volumineux qui prennent de la place"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige die größten Dateien, die Speicher belegen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre os maiores arquivos que ocupam espaço"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in evidenza i file più grandi che occupano spazio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量を占めている大きなファイルを洗い出します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 차지하는 가장 큰 파일을 보여 줍니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出占用空间最大的文件"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает самые большие файлы, занимающие место"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أكبر الملفات التي تستهلك المساحة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת הקבצים הגדולים ביותר שתופסים מקום"
          }
        }
      }
    },
