          "stringUnit": {
            "state": "translated",
            "value": "மாற்றப்பட்ட நிலைப்படம் உங்கள் நூலகத்தில் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్చిన స్థిర చిత్రం మీ లైబ్రరీలో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रूपांतरित केलेली स्थिर प्रतिमा तुमच्या लायब्ररीत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કન્વર્ટ કરેલું સ્ટિલ તમારી લાઇબ્રેરીમાં નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿವರ್ತಿಸಿದ ಸ್ಟಿಲ್ ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറ്റിയ സ്റ്റിൽ നിങ്ങളുടെ ലൈബ്രറിയിൽ ഇല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲੀ ਗਈ ਸਥਿਰ ਫ਼ੋਟੋ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਨਹੀਂ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto fija convertida no está en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo fixe convertie est absente de votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konvertierte Standbild fehlt in deiner Mediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto estática convertida não está na sua biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto statica convertita non è nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換した静止画がライブラリに見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 정지 이미지가 사진 보관함에 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的图库中找不到转换后的静帧图像。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразованного статичного фото нет в вашей медиатеке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة الثابتة المحوَّلة مفقودة من مكتبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה הסטטית המומרת חסרה מהספרייה שלך."
          }
        }
      }
    },
    "The message couldn't be sent. Please try again or email us at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message couldn't be sent. Please try again or email us at %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश भेजा नहीं जा सका. कृपया फिर से प्रयास करें या हमें %@ पर ईमेल करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তাটি পাঠানো যায়নি. আবার চেষ্টা করুন বা %@-এ আমাদের ইমেল করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செய்தியை அனுப்ப முடியவில்லை. மீண்டும் முயற்சிக்கவும் அல்லது %@-க்கு எங்களுக்கு மின்னஞ்சல் அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సందేశం పంపలేకపోయాం. మళ్లీ ప్రయత్నించండి లేదా %@కు మాకు ఇమెయిల్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश पाठवता आला नाही. कृपया पुन्हा प्रयत्न करा किंवा %@ वर ईमेल करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંદેશ મોકલી શકાયો નથી. ફરી પ્રયાસ કરો અથવા %@ પર ઇમેઇલ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂದೇಶ ಕಳುಹಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ %@ ಗೆ ಇಮೇಲ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സന്ദേശം അയയ്ക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ %@-ലേക്ക് ഇമെയിൽ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਨੇਹਾ ਨਹੀਂ ਭੇਜਿਆ ਜਾ ਸਕਿਆ. ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ ਸਾਨੂੰ %@ ਉੱਤੇ ਈਮੇਲ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el mensaje. Inténtalo de nuevo o escríbenos a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n'a pas pu être envoyé. Réessayez ou écrivez-nous à %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht konnte nicht gesendet werden. Bitte versuche es erneut oder schreibe uns an %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar a mensagem. Tente novamente ou envie um e-mail para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare il messaggio. Riprova o scrivici a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを送信できませんでした。もう一度お試しいただくか、%@ までメールでご連絡ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 보내지 못했습니다. 다시 시도하거나 %@으로 이메일을 보내 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息无法发送。请重试，或发送邮件至 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить сообщение. Повторите попытку или напишите нам на %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال الرسالة. حاول مرة أخرى أو راسلنا على %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשלוח את ההודעה. נסה שוב או כתוב לנו לכתובת %@."
          }
        }
      }
    },
