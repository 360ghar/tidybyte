    "Spot blurry, dark, and overexposed shots": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot blurry, dark, and overexposed shots"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धुंधली, अँधेरी और ज़्यादा रोशनी वाली फ़ोटो पहचानें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঝাপসা, অন্ধকার ও অতিরিক্ত আলোর ফটো চিহ্নিত করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மங்கலான, இருண்ட மற்றும் அதிக ஒளியுள்ள படங்களைக் கண்டறி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అస్పష్టమైన, చీకటిగా ఉన్న మరియు అధిక వెలుతురు ఉన్న షాట్లను గుర్తించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्पष्ट, गडद आणि खूप तेजस्वी फोटो ओळखा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝાંખા, ઘેરા અને બહુ તેજસ્વી શોટ પકડો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಸ್ಪಷ್ಟ, ಗಾಢ ಮತ್ತು ಅತಿ ಹೆಚ್ಚು ಬೆಳಕಿನ ಫೋಟೋಗಳನ್ನು ಗುರುತಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മങ്ങിയതും ഇരുണ്ടതും അധിക വെളിച്ചമുള്ളതുമായ ഫോട്ടോകൾ കണ്ടെത്തുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਧੁੰਦਲੀਆਂ, ਗੂੜ੍ਹੀਆਂ ਅਤੇ ਬਹੁਤ ਰੌਸ਼ਨ ਫ਼ੋਟੋਆਂ ਪਛਾਣੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta fotos borrosas, oscuras y sobreexpuestas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez les photos floues, sombres et surexposées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne unscharfe, dunkle und überbelichtete Aufnahmen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique fotos desfocadas, escuras e superexpostas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua scatti sfocati, scuri e sovraesposti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼやけた写真、暗い写真、露出オーバーの写真を見つけます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐릿하거나 어둡거나 과다 노출된 사진을 찾아냅니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找出模糊、过暗和曝光过度的照片"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит размытые, темные и пересвеченные снимки"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشاف الصور الضبابية والداكنة والمفرطة في الإضاءة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איתור צילומים מטושטשים, כהים וחשופים מדי"
          }
        }
      }
    },
