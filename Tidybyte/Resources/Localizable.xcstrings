    "Lens smudge analysis is unavailable on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens smudge analysis is unavailable on this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर लेंस धब्बे का विश्लेषण उपलब्ध नहीं है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে লেন্সের দাগ বিশ্লেষণ উপলব্ধ নয়."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் லென்ஸ் கறை பரிசோதனை கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో లెన్స్ మరక విశ్లేషణ అందుబాటులో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर लेन्स डाग विश्लेषण उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસ પર લેન્સ ડાઘ વિશ્લેષણ ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ ಲೆನ್ಸ್ ಕಲೆ ವಿಶ್ಲೇಷಣೆ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ ലെൻസ് പാട് വിശകലനം ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਂਸ ਦੇ ਧੱਬਿਆਂ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਇਸ ਡੀਵਾਈਸ ਉੱਤੇ ਉਪਲਬਧ ਨਹੀਂ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de manchas en la lente no está disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse des traces sur l'objectif n'est pas disponible sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse verschmutzter Linsen ist auf diesem Gerät nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de manchas na lente não está disponível neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analisi delle impronte sull'obiettivo non è disponibile su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではレンズの汚れ解析を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 렌즈 얼룩 분석을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持镜头污渍分析。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ загрязнения объектива недоступен на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل اتساخ العدسة غير متاح على هذا الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוח לכלוך על העדשה אינו זמין במכשיר זה."
          }
        }
      }
    },
