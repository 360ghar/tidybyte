    "Could not clear swipe history. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not clear swipe history. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप इतिहास साफ़ नहीं हो सका. कृपया फिर से प्रयास करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোয়াইপ ইতিহাস সাফ করা যায়নি. আবার চেষ্টা করুন."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்வைப் வரலாற்றை அழிக்க முடியவில்லை. மீண்டும் முயற்சி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వైప్ చరిత్రను క్లియర్ చేయలేకపోయాం. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप इतिहास साफ करता आला नाही. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વાઇપ ઇતિહાસ સાફ કરી શકાયો નથી. ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವೈಪ್ ಇತಿಹಾಸವನ್ನು ತೆರವುಗೊಳಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വൈപ്പ് ചരിത്രം മായ്ക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਈਪ ਇਤਿਹਾਸ ਸਾਫ਼ ਨਹੀਂ ਹੋ ਸਕਿਆ. ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo borrar el historial de deslizamientos. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'effacer l'historique des balayages. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wischverlauf konnte nicht gelöscht werden. Bitte versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível limpar o histórico de deslizes. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cancellare la cronologia degli scorrimenti. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプ履歴を消去できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프 기록을 지우지 못했습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法清除滑动记录。请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось очистить историю свайпов. Повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر مسح سجل السحب. حاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לנקות את היסטוריית ההחלקות. נסה שוב."
          }
        }
      }
    },
    "Could not find still image in Live Photo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find still image in Live Photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo में स्थिर छवि नहीं मिली."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-তে স্থির ছবি পাওয়া যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-இல் நிலைப் படம் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photoలో స్థిర చిత్రం కనుగొనలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo मध्ये स्थिर प्रतिमा आढळली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo માં સ્થિર ઇમેજ મળી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ನಲ್ಲಿ ಸ್ಟಿಲ್ ಚಿತ್ರ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
