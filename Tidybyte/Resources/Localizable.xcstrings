      }
    },
    "No photos larger than %lld MB. Lower the threshold or switch to All/Videos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos larger than %lld MB. Lower the threshold or switch to All/Videos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB से बड़ी कोई फ़ोटो नहीं. सीमा घटाएँ या सभी/वीडियो पर स्विच करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-এর চেয়ে বড় কোনও ফটো নেই. সীমা কম করুন বা সব/ভিডিও-তে যান."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-ஐ விட பெரிய புகைப்படங்கள் இல்லை. வரம்பைக் குறைக்கவும் அல்லது அனைத்தும்/வீடியோக்களுக்கு மாறவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB కంటే పెద్ద ఫోటోలు లేవు. పరిమితిని తగ్గించండి లేదా అన్నీ/వీడియోలు ట్యాబ్కు మారండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB पेक्षा मोठे फोटो नाहीत. मर्यादा कमी करा किंवा सर्व/व्हिडिओ वर जा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB થી મોટા ફોટા નથી. મર્યાદા ઘટાડો અથવા બધું/વિડિયો પર જાઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB ಗಿಂತ ದೊಡ್ಡ ಫೋಟೋಗಳಿಲ್ಲ. ಮಿತಿ ಕಡಿಮೆ ಮಾಡಿ ಅಥವಾ ಎಲ್ಲಾ/ವೀಡಿಯೊಗಳು ಟ್ಯಾಬ್ಗೆ ಬದಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB-യിൽ കൂടുതലുള്ള ഫോട്ടോകൾ ഇല്ല. പരിധി കുറയ്ക്കുക അല്ലെങ്കിൽ എല്ലാം/വീഡിയോകൾ എന്നതിലേക്ക് മാറുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB ਤੋਂ ਵੱਡੀਆਂ ਫ਼ੋਟੋਆਂ ਨਹੀਂ. ਹੱਦ ਘਟਾਓ ਜਾਂ ਸਭ/ਵੀਡੀਓ ਉੱਤੇ ਜਾਓ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fotos de más de %lld MB. Baja el umbral o cambia a Todo/Vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo de plus de %lld MB. Abaissez le seuil ou passez à Tout/Vidéos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fotos über %lld MB. Verringere den Schwellenwert oder wechsle zu Alle/Videos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma foto acima de %lld MB. Reduza o limite ou mude para Tudo/Vídeos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna foto oltre %lld MB. Riduci la soglia o passa a Tutti/Video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが%lld MBを超える写真はありません。しきい値を下げるか、「すべて」/「ビデオ」に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB보다 큰 사진이 없습니다. 기준을 낮추거나 \"모두\"/\"동영상\"으로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有大于 %lld MB 的照片。降低阈值或切换到“全部”/“视频”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет фото больше %lld MB. Снизьте порог или переключитесь на «Все»/«Видео»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صور أكبر من %lld MB. خفّض الحد أو بدّل إلى «الكل»/«الفيديوهات»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תמונות גדולות מ-%lld MB. הורד את הסף או עבור אל \"הכול\"/\"סרטונים\"."
          }
        }
      }
    },
    "No photos over 2 MB are left to compress. HEIC photos are already small.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos over 2 MB are left to compress. HEIC photos are already small."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2 MB से बड़ी कोई फ़ोटो कंप्रेस करने के लिए नहीं बची है. HEIC फ़ोटो पहले से छोटी हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2 MB-এর বেশি কোনও ফটো কমপ্রেস করার জন্য আর নেই. HEIC ফটো আগেই ছোট."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்குவதற்கு 2 MB-க்கு மேல் புகைப்படங்கள் எதுவும் மீதமில்லை. HEIC புகைப்படங்கள் ஏற்கனவே சிறியவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించడానికి 2 MB కంటే పెద్ద ఫోటోలు ఏవీ మిగలలేదు. HEIC ఫోటోలు ఇప్పటికే చిన్నవి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस करण्यासाठी 2 MB पेक्षा मोठे फोटो उरलेले नाहीत. HEIC फोटो आधीच लहान असतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરવા માટે 2 MB થી મોટા ફોટા બાકી નથી. HEIC ફોટા પહેલેથી જ નાના હોય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿಸಲು 2 MB ಗಿಂತ ದೊಡ್ಡ ಫೋಟೋಗಳು ಉಳಿದಿಲ್ಲ. HEIC ಫೋಟೋಗಳು ಈಗಾಗಲೇ ಚಿಕ್ಕದಾಗಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്യാൻ 2 MB-യിൽ കൂടുതലുള്ള ഫോട്ടോകൾ അവശേഷിക്കുന്നില്ല. HEIC ഫോട്ടോകൾ ഇതിനകം ചെറുതാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪਰੈਸ ਕਰਨ ਲਈ 2 MB ਤੋਂ ਵੱਡੀਆਂ ਫ਼ੋਟੋਆਂ ਨਹੀਂ ਬਚੀਆਂ. HEIC ਫ਼ੋਟੋਆਂ ਪਹਿਲਾਂ ਹੀ ਛੋਟੀਆਂ ਹੁੰਦੀਆਂ ਹਨ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan fotos de más de 2 MB por comprimir. Las fotos HEIC ya son pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste aucune photo de plus de 2 MB à compresser. Les photos HEIC sont déjà légères."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Fotos über 2 MB zum Komprimieren übrig. HEIC-Fotos sind bereits klein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais fotos acima de 2 MB para comprimir. As fotos HEIC já são pequenas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono più foto oltre 2 MB da comprimere. Le foto HEIC sono già leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮できる2 MBを超える写真はもうありません。HEICの写真はすでに小さいサイズです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축할 2 MB 초과 사진이 남아 있지 않습니다. HEIC 사진은 이미 작습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有超过 2 MB 的照片需要压缩。HEIC 照片本身已经很小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не осталось фото больше 2 MB для сжатия. Фото HEIC и так небольшие."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبقَ صور أكبر من 2 MB لضغطها. صور HEIC صغيرة بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נותרו תמונות מעל 2 MB לכיווץ. תמונות HEIC כבר קטנות."
          }
        }
      }
    },
