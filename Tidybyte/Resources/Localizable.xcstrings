    "Tell us what got in the way.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what got in the way."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताइए किस चीज़ ने रोका."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বলুন কোনটা বাধা হয়ে দাঁড়িয়েছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எது தடையாக இருந்தது என்று சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏది అడ్డుపడిందో మాకు చెప్పండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कशामुळे अडचण आली ते सांगा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કઈ વસ્તુ અડચણરૂપ બની તે જણાવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನು ಅಡ್ಡಿಯಾಯಿತು ಎಂದು ನಮಗೆ ತಿಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് തടസ്സമായതെന്ന് ഞങ്ങളോട് പറയുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੱਸੋ ਕੀ ਰੁਕਾਵਟ ਬਣਿਆ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué te lo impidió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui vous a gêné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was dich gestört hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte o que atrapalhou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci cosa ti ha bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が邪魔になったか教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 점이 불편했는지 알려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们是什么阻碍了你。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, что вам помешало."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرنا بما أعاقك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספר לנו מה הפריע."
          }
        }
      }
    },
