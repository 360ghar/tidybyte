        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘਟੀਆ ਗੁਣਵੱਤਾ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ ਪਛਾਣੋ"
          }
        },
        "es": {
