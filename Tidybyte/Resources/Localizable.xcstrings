    "Review low-scoring photos, lowest first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review low-scoring photos, lowest first"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम स्कोर वाली फ़ोटो देखें, सबसे कम पहले"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম স্কোরের ফটো দেখুন, সবচেয়ে কম আগে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்த மதிப்பெண் பெற்ற புகைப்படங்களைப் பாருங்கள், மிகக் குறைவானவை முதலில்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్కువ స్కోరు ఫోటోలను సమీక్షించండి, అత్యంత తక్కువవి ముందుగా"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमी गुण मिळालेले फोटो तपासा, सर्वात कमी गुणांचे आधी"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓછા સ્કોરવાળા ફોટાની સમીક્ષા કરો, સૌથી ઓછા પહેલા"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಡಿಮೆ ಸ್ಕೋರ್ನ ಫೋಟೋಗಳನ್ನು ಪರಿಶೀಲಿಸಿ, ಅತ್ಯಂತ ಕಡಿಮೆ ಇರುವವು ಮೊದಲು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞ സ്കോറുള്ള ഫോട്ടോകൾ പരിശോധിക്കുക, ഏറ്റവും കുറഞ്ഞവ ആദ്യം"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੱਟ ਸਕੋਰ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ ਦੀ ਸਮੀਖਿਆ ਕਰੋ, ਸਭ ਤੋਂ ਘੱਟ ਪਹਿਲਾਂ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las fotos con puntuación más baja, de menor a mayor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les photos les moins bien notées, en partant des plus basses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Fotos mit niedriger Bewertung, die schlechtesten zuerst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as fotos com a pontuação mais baixa, das menores primeiro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina le foto con il punteggio più basso, partendo dalle peggiori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価の低い写真を、低い順に確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수가 낮은 사진부터 순서대로 검토합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看评分最低的照片，从最低的开始"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите снимки с низкой оценкой, сначала самые низкие"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الصور ذات التقييم المنخفض، الأدنى أولًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקור תמונות עם ציון נמוך, מהנמוך לגבוה"
          }
        }
      }
    },
