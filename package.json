{
  "name": "tidybyte-site",
  "private": true,
  "version": "1.0.0",
  "description": "Marketing site for TidyByte iOS app (Astro)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tailwindcss -i ./src/input.css -o ./public/assets/css/styles.css --watch\" \"astro dev\"",
    "build": "astro build && tailwindcss -i ./src/input.css -o ./dist/assets/css/styles.css --minify && node scripts/hash-assets.mjs",
    "preview": "astro preview",
    "verify": "node scripts/verify-parity.mjs",
    "check": "node scripts/verify-parity.mjs --check"
  },
  "devDependencies": {
    "astro": "^7.3.2",
    "concurrently": "^10.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^3.4.17"
  }
}
